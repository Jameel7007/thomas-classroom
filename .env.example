# Keep the real .env file private. Never put these values in student-facing HTML.
ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# Optional named voices for dialogues. A clip's "voice" field selects one.
# ELEVENLABS_VOICE_TEACHER=teacher_voice_id
# ELEVENLABS_VOICE_STUDENT=student_voice_id

# Multilingual v2 favors voice quality and consistency for lesson audio.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=0.90
ELEVENLABS_STABILITY=0.58
ELEVENLABS_SIMILARITY=0.78
ELEVENLABS_STYLE=0.12

PORT=8090
