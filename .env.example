# Public build setting. SITE_URL is intentionally a placeholder until the
# final HTTPS domain is chosen. The approved booking destination is kept in
# astro-pilot/src/data/site-settings.mjs so deployment configuration cannot
# silently diverge from page metadata.
SITE_URL=https://your-domain.example

# Audio authoring only. The production website never reads these values and
# does not need ElevenLabs credentials. Keep the real .env private and never
# place this key in public Astro variables.
ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# Optional named voices. A clip's "voice" field selects one.
# ELEVENLABS_VOICE_TEACHER=teacher_voice_id
# ELEVENLABS_VOICE_STUDENT=student_voice_id
