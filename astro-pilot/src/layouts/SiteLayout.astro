---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "curriculum" | "about" | "languages" | "blog" | "dictionary";
  heading?: string;
  lede?: string;
  showLevelJumps?: boolean;
}

const { title, description, current, heading = "The English Curriculum Map", lede = description, showLevelJumps = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const levels = [
  { code: "A0", hue: 28 },
  { code: "A1", hue: 70 },
  { code: "A2", hue: 150 },
  { code: "B1", hue: 245 },
  { code: "B2", hue: 305 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead">
      <div class="mast-inner">
        <p class="welcome">Welcome to <em>Thomas’s Classroom</em></p>
        <h1 class="title">{heading}</h1>
        <p class="lede">{lede}</p>
        <div class="mast-stats" aria-label="Curriculum overview">
          <span class="stat"><b>5</b> CEFR stages</span><span class="stat-div"></span>
          <span class="stat"><b>92</b> planned lessons</span><span class="stat-div"></span>
          <span class="stat"><b>A0–B2</b> one coherent path</span>
        </div>
      </div>
    </header>
    <div class="topnav">
      <div class="topnav-inner">
        <nav class="site-tabs" aria-label="Site sections">
          <a class="site-tab" href="/" aria-current={current === "home" ? "page" : undefined}>Home</a>
          <a class="site-tab" href="/curriculum/" aria-current={current === "curriculum" ? "page" : undefined}>Curriculum</a>
          <a class="site-tab" href="/assessments/placement-exam/">Placement Exam</a>
          <a class="site-tab" href="/assessments/quick-level-check/">Quick Check</a>
          <a class="site-tab" href="/about/" aria-current={current === "about" ? "page" : undefined}>Bio</a>
          <a class="site-tab" href="/languages/" aria-current={current === "languages" ? "page" : undefined}>Languages</a>
          <a class="site-tab" href="/blog/" aria-current={current === "blog" ? "page" : undefined}>Blog</a>
          <a class="site-tab" href="/dictionary/" aria-current={current === "dictionary" ? "page" : undefined}>Dictionary</a>
        </nav>
        {showLevelJumps && <nav class="level-jumps" aria-label="Jump to level">
          {levels.map((level) => <a class="level-jump" href={`/curriculum/#lvl-${level.code}`} style={`--level-accent:oklch(.58 .13 ${level.hue})`}><span class="level-jump-dot"></span>{level.code}</a>)}
        </nav>}
      </div>
    </div>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="foot"><p>Aligned to the Common European Framework of Reference for Languages (CEFR). Hour estimates and GSE ranges are indicative guides, not guarantees.</p><p class="foot-mark">Thomas’s Classroom · A0 → B2</p></footer>
  </body>
</html>
