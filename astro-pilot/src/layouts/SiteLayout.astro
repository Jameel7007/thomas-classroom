---
import "../styles/site.css";
import FontStyles from "../components/FontStyles.astro";
import SocialMetadata from "../components/SocialMetadata.astro";
import SkipLink from "../components/SkipLink.astro";
import StructuredData from "../components/StructuredData.astro";
import { lessonCounts } from "../data/lesson-catalog.mjs";
import { siteIdentityNodes, webPageNode } from "../lib/structured-data.mjs";

interface Props {
  title: string;
  description: string;
  current?: "home" | "curriculum" | "diagnostics" | "about" | "languages" | "blog" | "dictionary";
  heading?: string;
  lede?: string;
  noindex?: boolean;
  schemaType?: "WebPage" | "CollectionPage" | "ProfilePage";
  mainEntityId?: string;
  additionalStructuredData?: Record<string, unknown>[];
  socialType?: "website" | "article";
  publishedTime?: string;
  pageClass?: string;
}

const {
  title,
  description,
  current,
  heading = "The English Curriculum Map",
  lede = description,
  noindex = false,
  schemaType = current === "curriculum" || current === "diagnostics" || current === "blog" || current === "languages"
    ? "CollectionPage"
    : current === "about" ? "ProfilePage" : "WebPage",
  mainEntityId,
  additionalStructuredData = [],
  socialType = "website",
  publishedTime,
  pageClass,
} = Astro.props;
const counts = lessonCounts();
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = [
  ...siteIdentityNodes(Astro.site),
  webPageNode({ canonical, title, description, site: Astro.site, type: schemaType, mainEntityId }),
  ...additionalStructuredData,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontStyles />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <SocialMetadata title={title} description={description} canonical={canonical} type={socialType} publishedTime={publishedTime} />
    {!noindex && <StructuredData nodes={structuredData} />}
  </head>
  <body class={pageClass}>
    <SkipLink target="main-content" label="Skip to content" className="skip-link" />
    <header class="masthead">
      <div class="mast-inner">
        <p class="welcome">Welcome to <em>Thomas’s Classroom</em></p>
        <h1 class="title">{heading}</h1>
        <p class="lede">{lede}</p>
        <div class="mast-stats" aria-label="Curriculum overview">
          {current === "curriculum" ? <>
            <span class="stat"><b>{counts.total}</b> curriculum topics · {counts.ready} available now</span><span class="stat-div"></span>
            <span class="stat"><b>A0–C1</b> complete learning path</span>
            <span class="stat-div"></span><a class="stat stat-link" href="/tutor/">Tutor planning guide <b aria-hidden="true">→</b></a>
          </> : <>
            <span class="stat"><b>6</b> curriculum stages</span><span class="stat-div"></span>
            <span class="stat"><b>{counts.total}</b> curriculum topics · {counts.ready} available now</span><span class="stat-div"></span>
            <span class="stat"><b>A0–C1</b> one coherent path</span>
          </>}
        </div>
      </div>
    </header>
    <div class="topnav">
      <div class="topnav-inner">
        <nav class="site-tabs" aria-label="Site sections">
          <a class="site-tab" href="/" aria-current={current === "home" ? "page" : undefined}>Home</a>
          <a class="site-tab" href="/curriculum/" aria-current={current === "curriculum" ? "page" : undefined}>Curriculum</a>
          <a class="site-tab" href="/assessments/" aria-current={current === "diagnostics" ? "page" : undefined}>Diagnostics</a>
          <a class="site-tab" href="/about/" aria-current={current === "about" ? "page" : undefined}>Bio</a>
          <a class="site-tab" href="/languages/" aria-current={current === "languages" ? "page" : undefined}>Languages</a>
          <a class="site-tab" href="/blog/" aria-current={current === "blog" ? "page" : undefined}>Blog</a>
          <a class="site-tab" href="/dictionary/" aria-current={current === "dictionary" ? "page" : undefined}>Dictionary</a>
        </nav>
      </div>
    </div>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="foot"><p>Aligned to the Common European Framework of Reference for Languages (CEFR). Hour estimates and GSE ranges are indicative guides, not guarantees.</p><div class="foot-actions"><a class="foot-link" href="/tutor/">Tutor planning guide</a><p class="foot-mark">Thomas’s Classroom · A0 → C1</p></div></footer>
  </body>
</html>
