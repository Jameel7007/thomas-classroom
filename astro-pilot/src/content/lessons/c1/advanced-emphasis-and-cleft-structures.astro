import LessonPage from "../../../components/lesson/LessonPage.astro";import StructuredLesson from "../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Advanced emphasis and cleft structures · C1 Grammar","slug":"advanced-emphasis-and-cleft-structures","level":"C1","topic":"Advanced emphasis and cleft structures","category":"Grammar","contentType":"grammar","status":"ready","description":"Reshape information with clefts, fronting and strategic repetition to correct assumptions and guide attention through complex discourse.","sequence":7,"prerequisites":["c1/inversion-after-negative-expressions","b2/cleft-sentences-for-emphasis"],"related":["c1/concession-contrast-and-counterargument","c1/organizing-complex-spoken-arguments"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"It-clefts, wh-clefts, all-clefts, emphatic do, fronting, information focus, spoken stress, contextual correction, repair, argument, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Reshape a message to correct assumptions and guide attention, choosing clefts, fronting, emphatic do, or ordinary stress without changing the underlying claim.",focus:"information focus and corrective emphasis",tags:["it-clefts","wh-clefts","emphatic do"],
retrieval:[{prompt:"Stress the corrected detail in: Maya sent the file on Tuesday, not Monday.",answer:"Maya sent the file on TUESDAY, not Monday."},{prompt:"Use an it-cleft to focus Maya, not Leo.",answer:"It was Maya who sent the file."},{prompt:"Use a what-cleft to focus the need for clearer evidence.",answer:"What we need is clearer evidence."}],
notice:{title:"The facts stay stable while focus moves",setup:"A team corrects three misunderstandings about a project.",samples:["It was the testing phase that caused the delay, not the design phase.","What the client objected to was the lack of consultation.","The reason we changed direction was that the evidence did not support the original plan."],questions:["Which structure contrasts two project phases?","Which structure packages the client’s objection as the focus?","What information follows the focused frame in each sentence?"],check:{question:"What is the main purpose of a cleft here?",answer:"It reorganizes a stable proposition so one element receives explicit focus.",options:[{value:"It reorganizes a stable proposition so one element receives explicit focus."},{value:"It changes every verb into passive voice."},{value:"It makes an unsupported claim true."}],hint:"Compare each cleft with a neutral ordinary-order version."}},
discover:{principle:"Emphasis is an information choice. Use a marked structure when the listener needs a correction, contrast, boundary, or organizing focus. Ordinary word order plus stress is often enough, so marked forms should earn their place.",formRows:[{label:"it-cleft","form":"It + be + focus + who/that + clause",example:"It was Maya who found the error."},{label:"wh-cleft","form":"What + clause + be + focus",example:"What Maya found was a calculation error."},{label:"reason/thing cleft","form":"The reason/thing + clause + be + focus",example:"The reason we paused was the missing evidence."},{label:"emphatic do","form":"do/does/did + base verb",example:"We did check the final figures."}],meaningRows:[{choice:"correction","use":"you replace a listener’s mistaken assumption",example:"It was Thursday that we agreed on, not Tuesday."},{choice:"contrast","use":"you distinguish the decisive element",example:"What matters is accuracy, not speed."},{choice:"organization","use":"you announce the focus of a longer explanation",example:"The first thing to clarify is the timeline."},{choice:"reassurance or insistence","use":"you confirm a disputed positive statement",example:"The system does support encrypted files."}],pronunciation:"Place nuclear stress on the focus: It was the TESTING phase that caused the delay. Keep the frame lighter. Emphatic do must be stressed: We DID check.",errors:[{wrong:"It was Maya which found the error.",correct:"It was Maya who found the error.",why:"Who is the natural relative marker for a person."},{wrong:"What we need are more time.",correct:"What we need is more time.",why:"The wh-clause functions as a singular focused unit here."},{wrong:"We did checked the figures.",correct:"We did check the figures.",why:"Did carries past time and is followed by the base verb."}]},
reference:{title:"Choose the lightest effective focus",intro:"Move from ordinary stress to a marked structure only when the discourse needs it.",groups:[{heading:"Ordinary stress",items:["I meant THURSDAY.","We need EVIDENCE."]},{heading:"Cleft focus",items:["It was Thursday that I meant.","What we need is evidence."]},{heading:"Discourse frames",items:["The point is…","The reason…is…","All I’m saying is…"]}]},
build:[
{question:"Correct the belief that Leo found the error. Maya found it.",answer:"It was Maya who found the error.",options:[{value:"It was Maya who found the error."},{value:"It Maya was found the error."},{value:"What found Maya was the error."}],hint:"Use an it-cleft with the corrected person as focus."},
{question:"Focus the need for more reliable evidence.",answer:"What we need is more reliable evidence.",options:[{value:"What we need is more reliable evidence."},{value:"What do we need are evidence."},{value:"It needs what reliable evidence."}],hint:"Use a wh-cleft with the needed item after be."},
{question:"Focus the cause of the delay: a missing permit.",answer:"The reason the project was delayed was that the permit was missing.",options:[{value:"The reason the project was delayed was that the permit was missing."},{value:"The reason was delayed the project missing permit."},{value:"What the permit delayed is reason."}],hint:"Use a reason frame followed by the focused explanation."},
{question:"Insist that the team checked the totals yesterday.",answer:"The team did check the totals yesterday.",options:[{value:"The team did check the totals yesterday."},{value:"The team did checked the totals yesterday."},{value:"The team does checked yesterday."}],hint:"Stress did and keep check in base form."},
{question:"Which sentence focuses a time correction?",answer:"It was on Thursday that we signed the agreement.",options:[{value:"It was on Thursday that we signed the agreement."},{value:"It on Thursday was signed we agreement."},{value:"What Thursday signed was we."}],hint:"Place the corrected time after be."},
{question:"Which sentence politely limits a claim?",answer:"All I’m saying is that the timetable needs another review.",options:[{value:"All I’m saying is that the timetable needs another review."},{value:"All I say that timetable reviewing."},{value:"It all saying timetable."}],hint:"All-clefts can narrow what the speaker is claiming."},
{question:"Which version uses ordinary stress rather than unnecessary grammar?",answer:"I asked for the FINAL version.",options:[{value:"I asked for the FINAL version."},{value:"It what was the final that version asked."},{value:"What I did was asked final."}],hint:"A short correction may need only contrastive stress."},
{question:"Which focus structure introduces the first priority?",answer:"The first thing we need to establish is the timeline.",options:[{value:"The first thing we need to establish is the timeline."},{value:"The timeline first thing establish we."},{value:"It was establish which timeline."}],hint:"Use a discourse frame to organize what follows."}],
context:{title:"Correcting a public summary",intro:"A project lead responds to an inaccurate account.",lines:["It was the supplier’s withdrawal that forced us to revise the launch date, not a failure in the design. We did complete the safety testing on schedule.","What delayed the revised launch was the time required to approve a replacement supplier. The reason that approval took three weeks was that two independent checks were required.","All I am saying is that the public summary confuses the original delay with the later approval process. The first thing we need to establish is a shared timeline."],questions:[{question:"What forced the first date change?",answer:"The supplier’s withdrawal",options:[{value:"The supplier’s withdrawal"},{value:"A design failure"},{value:"Incomplete safety testing"}],hint:"Read the focused element in the first cleft."},{question:"What does emphatic “did complete” correct?",answer:"The implication that safety testing was not completed on schedule.",options:[{value:"The implication that safety testing was not completed on schedule."},{value:"The belief that no supplier withdrew."},{value:"The length of the approval process."}],hint:"Emphatic do confirms a disputed positive claim."},{question:"Why did approval take three weeks?",answer:"Two independent checks were required.",options:[{value:"Two independent checks were required."},{value:"The team forgot the timeline."},{value:"The design failed again."}],hint:"The reason-cleft provides the explanation."},{question:"What function does “All I am saying” serve?",answer:"It limits the scope of the lead’s claim.",options:[{value:"It limits the scope of the lead’s claim."},{value:"It claims that every public statement is false."},{value:"It changes the event into future time."}],hint:"The speaker narrows the point under discussion."}]},
builder:{title:"Build the corrective focus",prompt:"Correct which phase caused the delay.",answer:"It was the testing phase that caused the delay",tiles:["It","was","the","testing","phase","that","caused","the","delay"]},
repairs:[{title:"Use who for a person",sentence:"It was Maya which found the error.",answer:"which",fix:"It was Maya who found the error.",why:"Who naturally introduces a focused person.",tokens:[{value:"it",label:"It was"},{value:"maya",label:"Maya"},{value:"which",label:"which"},{value:"found",label:"found the error"}]},{title:"Restore the base verb",sentence:"We did completed the review.",answer:"completed",fix:"We did complete the review.",why:"Did is followed by the base form.",tokens:[{value:"we",label:"We"},{value:"did",label:"did"},{value:"completed",label:"completed"},{value:"review",label:"the review"}]},{title:"Match the wh-cleft",sentence:"What we need are a clearer timeline.",answer:"are",fix:"What we need is a clearer timeline.",why:"The wh-clause is treated as one focused unit.",tokens:[{value:"what",label:"What we need"},{value:"are",label:"are"},{value:"timeline",label:"a clearer timeline"}]},{title:"Avoid a broken double focus",sentence:"It was the permit what was the reason we stopped.",answer:"what",fix:"It was the missing permit that made us stop. / The reason we stopped was the missing permit.",why:"Choose one complete focus frame instead of blending two.",tokens:[{value:"it",label:"It was"},{value:"permit",label:"the permit"},{value:"what",label:"what"},{value:"reason",label:"was the reason we stopped"}]}],
fluency:[{prompt:"Correct a mistaken person, time and reason with three different focus choices.",answer:"It was Maya who called. It was on Thursday that she called. The reason she called was the missing figure."},{prompt:"Confirm a disputed positive statement with emphatic do.",answer:"We did submit the application before the deadline."},{prompt:"State the same correction first with stress and then with a cleft.",answer:"I meant TUESDAY. It was Tuesday that I meant."},{prompt:"Use an all-cleft to limit a disagreement.",answer:"All I’m saying is that we need more evidence before making a final decision."}],
communicate:{title:"The misconception repair",setup:"Choose a fictional project summary containing four incorrect assumptions. Correct each with the lightest effective focus structure.",roles:["Project lead: correct person, time, cause and scope while keeping the factual core stable.","Editor: identify the focused element, test agreement and relative markers, and request ordinary-order versions."],prompts:["It was…who/that…","What happened was…","The reason…was…","All I’m saying is…"],success:["Each structure has one clear focus.","Agreement, auxiliary form and relative markers are accurate.","Marked emphasis solves a real information problem rather than decorating every sentence."]},
writing:{title:"Write a corrective project note",task:"Write 170 to 210 words responding to four inaccurate claims in a fictional summary.",requirements:["Use one it-cleft, one wh-cleft and one reason-cleft.","Use emphatic do once to confirm a disputed positive fact.","End with an ordinary-order summary so the factual core is unmistakable."],model:"It was the supplier’s withdrawal that caused the original delay, not a design failure. We did complete the safety tests on schedule. What delayed the revised launch was the approval of a replacement supplier. The reason that approval took three weeks was that two independent checks were required. All I am saying is that the public account combines two separate stages. In ordinary order, the supplier withdrew, testing finished on time, and the replacement approval created the later delay."},
reflect:{canDo:["Choose among ordinary stress, clefts, fronting and emphatic do.","Move focus without changing the factual proposition.","Use emphasis to correct, contrast, organize or limit a claim."],nextUse:"Record a one-minute correction of a fictional misunderstanding, then restate every sentence in neutral ordinary order."}
};
