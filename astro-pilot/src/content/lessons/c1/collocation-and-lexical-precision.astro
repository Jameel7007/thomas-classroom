---
import LessonPage from "../../../components/lesson/LessonPage.astro";import StructuredLesson from "../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Collocation and lexical precision · C1 Vocabulary","slug":"collocation-and-lexical-precision","level":"C1","topic":"Collocation and lexical precision","category":"Vocabulary & Topics","contentType":"vocabulary","status":"ready","description":"Choose precise lexical combinations by meaning, genre and register, and replace vague wording without forcing rare or unnatural vocabulary.","sequence":8,"prerequisites":["c1/register-tone-and-formality","b1/collocations-and-word-families"],"related":["c1/connotation-nuance-and-implied-meaning","c1/organizing-complex-spoken-arguments"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Collocational strength, semantic prosody, genre, verb-noun and adjective-noun choice, lexical bundles, repair, spoken precision, editing, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Replace vague or translated wording with natural, precise combinations while choosing vocabulary that fits meaning, genre and register rather than displaying unnecessary rarity.",focus:"collocation, lexical bundles and precise meaning",tags:["verb-noun pairs","semantic preference","editing"],
retrieval:[{prompt:"Complete three strong combinations: ___ a decision, ___ responsibility, ___ evidence.",answer:"make a decision, take/accept responsibility, provide/present evidence"},{prompt:"Replace do a mistake and strong rain.",answer:"make a mistake and heavy rain"},{prompt:"Give a neutral and formal alternative to look into a problem.",answer:"investigate a problem / examine the issue"}],
notice:{title:"Correct words can still form an unnatural combination",setup:"A report has accurate individual words but several weak combinations.",samples:["The team did a detailed analysis and made strong progress.","The team conducted a detailed analysis and made substantial progress.","The results raise serious concerns but provide limited evidence of direct harm."],questions:["Which verbs sound conventional with analysis and progress?","Why is substantial more natural than strong before progress?","Which nouns regularly follow raise and provide in the final sentence?"],check:{question:"What is a collocation?",answer:"A combination that speakers conventionally prefer for a particular meaning and context.",options:[{value:"A combination that speakers conventionally prefer for a particular meaning and context."},{value:"Any two difficult words placed together."},{value:"A rule that every synonym shares the same partners."}],hint:"Think about make a decision versus do a decision."}},
discover:{principle:"Lexical precision combines exact meaning with conventional partnership. Learn the node word, its sense, its grammatical pattern, its common partners, and the genres where the combination is expected.",formRows:[{label:"verb + noun","form":"pose a risk; reach a conclusion",example:"The delay poses a serious risk."},{label:"adjective + noun","form":"compelling evidence; tentative conclusion",example:"The study offers compelling evidence."},{label:"adverb + adjective","form":"deeply concerned; broadly consistent",example:"The findings are broadly consistent."},{label:"lexical bundle","form":"in light of; with respect to; there is little evidence that",example:"In light of the results, we revised the plan."}],meaningRows:[{choice:"strength",use:"the combination is frequent and expected",example:"heavy rain, not strong rain"},{choice:"semantic preference",use:"a word tends to occur with particular outcomes or attitudes",example:"pose often introduces risk, threat or question"},{choice:"genre",use:"a bundle organizes a report, discussion or informal exchange",example:"with respect to is common in formal explanation"},{choice:"precision",use:"the verb names the exact relationship",example:"cause, contribute to, trigger and coincide with make different claims"}],pronunciation:"Store collocations as stress groups: REACH a conCLU-sion, POSE a RISK, COM-pelling E-vidence. Fluency improves when the whole chunk is retrieved together.",errors:[{wrong:"We did a decision.",correct:"We made/reached a decision.",why:"Decision conventionally combines with make or reach in this meaning."},{wrong:"The report proves a possible link.",correct:"The report suggests/identifies a possible link.",why:"Prove conflicts with possible and overstates the evidence."},{wrong:"Use rare words to sound advanced.",correct:"Use the most precise natural combination for the audience and genre.",why:"Unnecessary rarity reduces clarity and often creates collocational errors."}]},
reference:{title:"High-value C1 combinations",intro:"Learn each as meaning plus pattern, not as an isolated synonym list.",groups:[{heading:"Evidence",items:["provide evidence","support a claim","draw a conclusion","raise doubts","remain inconclusive"]},{heading:"Change",items:["implement a policy","introduce a measure","undergo change","drive growth","pose a challenge"]},{heading:"Argument",items:["acknowledge a limitation","address a concern","challenge an assumption","make a distinction","qualify a claim"]}]},
build:[
{question:"The committee formally reached its final choice. Which chunk fits?",answer:"reached a decision",options:[{value:"reached a decision"},{value:"did a decision"},{value:"performed a decision"}],hint:"Decision commonly combines with reach or make."},
{question:"The new rule may create danger for small firms. It may ___ a risk.",answer:"pose",options:[{value:"pose"},{value:"do"},{value:"manufacture"}],hint:"Pose commonly introduces risks, threats and questions."},
{question:"The evidence is persuasive and difficult to dismiss. Which phrase fits?",answer:"compelling evidence",options:[{value:"compelling evidence"},{value:"loud evidence"},{value:"aggressive evidence"}],hint:"Compelling evaluates persuasive force."},
{question:"The study cannot prove cause but shows partial influence. Which verb fits?",answer:"contributed to",options:[{value:"contributed to"},{value:"guaranteed"},{value:"completely caused"}],hint:"Choose a limited causal relationship."},
{question:"Which phrase fits a cautious report conclusion?",answer:"The findings are broadly consistent with the earlier study.",options:[{value:"The findings are broadly consistent with the earlier study."},{value:"The findings are loudly same as the study."},{value:"The findings do an agreement."}],hint:"Broadly consistent allows substantial but not perfect agreement."},
{question:"Which verb combines naturally with concern in a formal discussion?",answer:"address a concern",options:[{value:"address a concern"},{value:"do a concern"},{value:"hit a concern"}],hint:"Address means deal with or respond to."},
{question:"Which phrase names a careful non-final interpretation?",answer:"a tentative conclusion",options:[{value:"a tentative conclusion"},{value:"a weakly conclusion"},{value:"an unsurely result"}],hint:"Tentative marks limited commitment."},
{question:"Which bundle introduces a revised decision based on evidence?",answer:"In light of the new evidence, we revised the policy.",options:[{value:"In light of the new evidence, we revised the policy."},{value:"In lamp of evidence, we did policy."},{value:"At evidence light, policy revised us."}],hint:"In light of means considering the information."}],
context:{title:"Editing an evidence summary",intro:"Compare vague drafting with precise revision.",lines:["Draft: The survey did a lot of information and showed a big problem with access.","Revision: The survey generated detailed evidence and identified a substantial barrier to access.","Final caution: The findings raise serious concerns, but the sample is too limited to support a firm conclusion about the entire population."],questions:[{question:"What replaces “did a lot of information”?",answer:"generated detailed evidence",options:[{value:"generated detailed evidence"},{value:"performed many information"},{value:"made facts loudly"}],hint:"Find the precise verb-noun combination."},{question:"Why is “substantial barrier” more precise than “big problem”?",answer:"It identifies an obstacle and evaluates its importance.",options:[{value:"It identifies an obstacle and evaluates its importance."},{value:"It proves the obstacle is physically large."},{value:"It removes all evaluation."}],hint:"Consider both noun sense and adjective force."},{question:"What does “support a firm conclusion” mean?",answer:"provide enough evidence for a confident conclusion",options:[{value:"provide enough evidence for a confident conclusion"},{value:"physically hold the report"},{value:"avoid interpreting any data"}],hint:"Interpret the academic collocation as a whole."},{question:"How does the final sentence avoid overclaiming?",answer:"It acknowledges serious concerns while limiting generalization from the sample.",options:[{value:"It acknowledges serious concerns while limiting generalization from the sample."},{value:"It claims the survey proves every case."},{value:"It hides the sample size."}],hint:"Track the concession and evidence limit."}]},
builder:{title:"Build the cautious evidence claim",prompt:"Combine the strength and the limitation.",answer:"The findings raise concerns but do not support a firm conclusion",tiles:["The","findings","raise","concerns","but","do","not","support","a","firm","conclusion"]},
repairs:[{title:"Repair the light verb",sentence:"The committee did a difficult decision.",answer:"did",fix:"The committee made a difficult decision.",why:"Make collocates with decision.",tokens:[{value:"committee",label:"The committee"},{value:"did",label:"did"},{value:"decision",label:"a difficult decision"}]},{title:"Repair evidence strength",sentence:"The small survey proved a possible connection.",answer:"proved",fix:"The small survey suggested a possible connection.",why:"Suggested matches limited evidence and possible.",tokens:[{value:"survey",label:"The small survey"},{value:"proved",label:"proved"},{value:"possible",label:"a possible connection"}]},{title:"Repair the adjective-noun pair",sentence:"The report presents powerful uncertainty.",answer:"powerful",fix:"The report acknowledges considerable uncertainty.",why:"Considerable naturally grades uncertainty, and acknowledges names the discourse act.",tokens:[{value:"report",label:"The report"},{value:"presents",label:"presents"},{value:"powerful",label:"powerful"},{value:"uncertainty",label:"uncertainty"}]},{title:"Repair vague advanced wording",sentence:"The measure effectuated a good change in outcomes.",answer:"effectuated",fix:"The measure improved outcomes.",why:"A precise common verb is clearer than inflated wording plus a vague noun.",tokens:[{value:"measure",label:"The measure"},{value:"effectuated",label:"effectuated"},{value:"good",label:"a good change"},{value:"outcomes",label:"in outcomes"}]}],
fluency:[{prompt:"Replace do, get and make in a vague project update.",answer:"We conducted the analysis, obtained approval, and implemented the change."},{prompt:"Create a collocation chain around evidence.",answer:"gather evidence, provide evidence, evaluate evidence, evidence supports a claim, evidence remains inconclusive"},{prompt:"Contrast cause, contribute to, trigger and coincide with.",answer:"Cause asserts a relationship; contribute to marks partial influence; trigger starts a process; coincide with marks timing without causation."},{prompt:"Self-correct an unnatural phrase aloud.",answer:"We did strong progress. More naturally, we made substantial progress."}],
communicate:{title:"The precision editor",setup:"Edit a fictional report containing vague verbs and translated combinations, then defend every revision.",roles:["Writer: present the intended meaning, genre and strength of evidence.","Editor: replace only language that is vague, unnatural or misleading and explain the collocational choice."],prompts:["What exact relationship does the verb claim?","Which partners does this noun prefer?","Does the combination fit the genre?","Is a common word more precise here?"],success:["Every replacement preserves or clarifies meaning.","Collocations sound conventional in the selected sense.","Vocabulary strength matches evidence and register."]},
writing:{title:"Write and edit an evidence paragraph",task:"Draft 170 to 210 words about fictional survey findings, then revise at least eight lexical combinations.",requirements:["Use four verb-noun and three adjective-noun collocations.","Include one lexical bundle that organizes the argument.","Avoid claiming direct causation unless the evidence supports it."],model:"The survey generated detailed evidence about access to evening services. The findings reveal a substantial barrier for workers with irregular schedules and raise serious concerns about the current timetable. However, the small sample does not support a firm conclusion about the entire population. In light of this limitation, the results should be treated as a basis for a larger study rather than proof of direct harm. The team will gather additional evidence, address the sampling concern, and evaluate whether extended hours contribute to improved access."},
reflect:{canDo:["Choose natural partners for high-value nouns, verbs and adjectives.","Distinguish exact causal and evidential relationships.","Prefer precise common wording over vague or inflated vocabulary."],nextUse:"Collect five useful combinations from a real professional text and record each with its meaning, pattern and one original sentence."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
