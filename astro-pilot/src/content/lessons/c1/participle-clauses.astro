---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Participle clauses · C1 Grammar","slug":"participle-clauses","level":"C1","topic":"Participle clauses","category":"Grammar","contentType":"grammar","status":"ready","description":"Compress time, reason, result and accompanying circumstances into clear participle clauses with an unambiguous understood subject.","sequence":10,"prerequisites":["c1/narrative-tenses-and-viewpoint","b2/non-defining-relative-clauses"],"related":["c1/reduced-relative-clauses","c1/nominalization-and-information-density"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Present, past and perfect participle clauses, time, reason, result and accompanying meaning, subject control, punctuation, repair, narrative use, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Compress related clauses when the understood subject is clear, distinguish active, passive and prior meanings, and expand a clause whenever compression creates ambiguity.",focus:"participle form, meaning and subject control",tags:["clause compression","dangling modifiers","information flow"],
retrieval:[{prompt:"Combine with because: Maya knew the route. She led the group.",answer:"Because Maya knew the route, she led the group."},{prompt:"Identify active and passive: the team reviewing the file / the file reviewed by the team.",answer:"Reviewing is active; reviewed is passive."},{prompt:"Show an earlier completed action before another past action.",answer:"After she had checked the figures, she sent the report."}],
notice:{title:"Three compressed relationships",setup:"Compare full and compressed versions.",samples:["Knowing the route, Maya led the group.","Reviewed by two specialists, the proposal was approved.","Having checked the figures, Maya sent the report."],questions:["Who knows the route?","What was reviewed, and is its meaning active or passive?","Which action happened first in the final sentence?"],check:{question:"What controls the understood subject of an opening participle clause?",answer:"It normally shares the subject of the following main clause.",options:[{value:"It normally shares the subject of the following main clause."},{value:"It always refers to the nearest noun anywhere in the paragraph."},{value:"It has no relationship to the main clause."}],hint:"Ask who performs both actions in Knowing the route, Maya led."}},
discover:{principle:"A participle clause compresses a relationship that context makes recoverable. The understood subject normally matches the main-clause subject. Choose -ing for active or accompanying meaning, past participle for passive/resulting state, and having + participle for clearly prior action.",formRows:[{label:"active present participle","form":"-ing clause, main clause",example:"Recognizing the risk, we delayed the launch."},{label:"passive past participle","form":"past participle phrase, main clause",example:"Designed for small teams, the tool is easy to use."},{label:"perfect participle","form":"having + past participle",example:"Having completed the test, we released the update."},{label:"negative","form":"not + participle",example:"Not knowing the code, I called support."}],meaningRows:[{choice:"reason",use:"the clause explains why",example:"Knowing the deadline, we started early."},{choice:"time/sequence",use:"the clause locates another event",example:"Leaving the office, I saw Maya."},{choice:"accompanying action",use:"two actions unfold together",example:"She walked away, shaking her head."},{choice:"resulting state",use:"a passive participle describes the subject",example:"Exhausted by the delay, the team paused."}],pronunciation:"Opening clauses form a separate tone unit and usually end with a small rise before the main clause. Stress the main event more strongly than predictable background.",errors:[{wrong:"Driving to work, the rain started.",correct:"Driving to work, I saw the rain begin. / While I was driving, the rain started.",why:"The main subject rain cannot logically be driving."},{wrong:"Having finish the review, we published it.",correct:"Having finished the review, we published it.",why:"Having is followed by a past participle."},{wrong:"Reviewed the evidence, we changed the plan.",correct:"Having reviewed the evidence, we changed the plan.",why:"We actively reviewed it, so a bare passive participle is wrong."}]},
reference:{title:"Compression safety check",intro:"Expand the clause first if any relationship is uncertain.",groups:[{heading:"Subject",items:["Who performs the participle action?","Does that match the main subject?"]},{heading:"Voice and time",items:["active -ing","passive/result past participle","clearly prior having + participle"]},{heading:"Meaning",items:["reason","time","accompanying action","resulting state"]}]},
build:[
{question:"Maya knew the route, so she led the group. Which compression is clear?",answer:"Knowing the route, Maya led the group.",options:[{value:"Knowing the route, Maya led the group."},{value:"Known the route, Maya led the group."},{value:"Knowing the route, the group followed itself."}],hint:"Maya performs both actions."},
{question:"Two specialists reviewed the proposal before approval. Which passive phrase fits?",answer:"Reviewed by two specialists, the proposal was approved.",options:[{value:"Reviewed by two specialists, the proposal was approved."},{value:"Reviewing two specialists, the proposal approved."},{value:"Having review specialists, approval happened."}],hint:"The proposal receives the reviewing action."},
{question:"The team completed the test before releasing the update. Which form clearly orders the events?",answer:"Having completed the test, the team released the update.",options:[{value:"Having completed the test, the team released the update."},{value:"Completing the test tomorrow, the team had released it yesterday."},{value:"Completed the test, the team was release."}],hint:"Use having plus past participle for clearly prior action."},
{question:"Which sentence has a safe understood subject?",answer:"Walking into the room, I noticed the open window.",options:[{value:"Walking into the room, I noticed the open window."},{value:"Walking into the room, the window looked open."},{value:"Walking into the room, there was a window."}],hint:"The main subject must be the walker."},
{question:"Which phrase expresses a negative reason?",answer:"Not knowing the password, I contacted support.",options:[{value:"Not knowing the password, I contacted support."},{value:"Knowing not the password, support contacted."},{value:"Not known the password, I contacting."}],hint:"Place not before the active participle."},
{question:"Which sentence shows accompanying action?",answer:"She left the meeting, shaking her head.",options:[{value:"She left the meeting, shaking her head."},{value:"Shaken her head, the meeting left."},{value:"Having shake, she leaves yesterday."}],hint:"Both actions belong to she and unfold together."},
{question:"Which clause describes a resulting passive state?",answer:"Exhausted by the delay, the team took a break.",options:[{value:"Exhausted by the delay, the team took a break."},{value:"Exhausting the team, it took itself a break."},{value:"Having exhaust, the delay took a team."}],hint:"The team receives the exhausting effect."},
{question:"Which situation should remain a full clause?",answer:"While I was driving, the rain started.",options:[{value:"While I was driving, the rain started."},{value:"Driving, the rain started."},{value:"Driven by me, the rain started."}],hint:"The two clauses have different subjects."}],
context:{title:"A compressed project account",intro:"Track subject, voice and sequence in each opening phrase.",lines:["Recognizing that the deadline was unrealistic, the project lead requested an extension. Supported by updated cost estimates, the request received quick approval.","Having secured another month, the team redesigned the testing schedule. Working in smaller groups, staff identified several issues that the original plan had missed.","Not wishing to hide the delay, the lead sent clients a detailed update, explaining what had changed and how the extra time would be used."],questions:[{question:"Who recognized the unrealistic deadline?",answer:"The project lead",options:[{value:"The project lead"},{value:"The deadline"},{value:"The clients"}],hint:"The opening clause shares the main subject."},{question:"What was supported by estimates?",answer:"The request",options:[{value:"The request"},{value:"The project lead"},{value:"The deadline"}],hint:"The past participle has passive meaning."},{question:"Which event happened before the redesign?",answer:"The team secured another month.",options:[{value:"The team secured another month."},{value:"Clients hid the delay."},{value:"The original plan was approved after redesign."}],hint:"Having secured marks prior completion."},{question:"What does “explaining” add?",answer:"It describes an accompanying communicative action in the client update.",options:[{value:"It describes an accompanying communicative action in the client update."},{value:"It changes the subject to the clients."},{value:"It makes the update passive."}],hint:"The lead sends and explains."}]},
builder:{title:"Build the prior-action clause",prompt:"Show that review finished before publication.",answer:"Having reviewed the evidence the team changed its recommendation",tiles:["Having","reviewed","the","evidence","the","team","changed","its","recommendation"]},
repairs:[{title:"Repair the dangling subject",sentence:"Driving to the office, the rain became heavier.",answer:"rain",fix:"While I was driving to the office, the rain became heavier.",why:"Rain cannot be the understood driver.",tokens:[{value:"driving",label:"Driving to the office"},{value:"rain",label:"the rain"},{value:"became",label:"became heavier"}]},{title:"Use the past participle",sentence:"Having complete the audit, we published the findings.",answer:"complete",fix:"Having completed the audit, we published the findings.",why:"Having takes a past participle.",tokens:[{value:"having",label:"Having"},{value:"complete",label:"complete"},{value:"audit",label:"the audit"},{value:"published",label:"we published the findings"}]},{title:"Choose active voice",sentence:"Reviewed the evidence, we revised the plan.",answer:"Reviewed",fix:"Having reviewed the evidence, we revised the plan.",why:"We actively performed the review.",tokens:[{value:"reviewed",label:"Reviewed"},{value:"evidence",label:"the evidence"},{value:"we",label:"we"},{value:"revised",label:"revised the plan"}]},{title:"Match the understood subject",sentence:"Designed for small teams, managers can use the tool easily.",answer:"managers",fix:"Designed for small teams, the tool is easy for managers to use.",why:"The tool, not managers, is designed for small teams.",tokens:[{value:"designed",label:"Designed for small teams"},{value:"managers",label:"managers"},{value:"use",label:"can use"},{value:"tool",label:"the tool easily"}]}],
fluency:[{prompt:"Compress a reason with an active participle.",answer:"Because we recognized the risk, we delayed the launch becomes Recognizing the risk, we delayed the launch."},{prompt:"Compress a passive description.",answer:"The tool, which was designed for small teams, is easy to use becomes Designed for small teams, the tool is easy to use."},{prompt:"Make earlier completion explicit.",answer:"Having checked every figure, Maya sent the report."},{prompt:"Reject a dangling clause and expand it safely.",answer:"Driving home, the storm began is unsafe. While I was driving home, the storm began."}],
communicate:{title:"The compression editor",setup:"Retell a six-event project account, compressing only relationships whose subject and meaning remain clear.",roles:["Narrator: use active, passive and perfect participle clauses to manage background and sequence.","Editor: stop at every clause, identify its subject and expand it if any relationship is ambiguous."],prompts:["Who performs this action?","Is the meaning active or passive?","Must earlier completion be explicit?","Would a full clause be clearer?"],success:["Every understood subject matches the main subject.","Form accurately marks voice and relative time.","Compression improves information flow without hiding responsibility."]},
writing:{title:"Write a compressed project narrative",task:"Write 180 to 220 words describing a project decision and revision.",requirements:["Use one active, one passive and one perfect participle clause.","Include one full adverbial clause where subjects differ.","Underline each participle clause and name its subject."],model:"Recognizing that the first deadline was unrealistic, the project lead requested an extension. Supported by revised estimates, the request received approval. Having secured another month, the team redesigned the test schedule. Working in smaller groups, staff found several accessibility issues. While the developers corrected those problems, researchers contacted users for another review. Not wishing to hide the delay, the lead sent clients a detailed update, explaining how the extra time would improve the release."},
reflect:{canDo:["Choose active, passive and perfect participle clauses.","Control the understood subject and avoid dangling modifiers.","Expand compressed language when subjects or relationships differ."],nextUse:"Edit one paragraph of your own writing, compress two safe relationships, and expand one risky participle clause."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
