import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Idiomatic language and fixed expressions · C1 Vocabulary","slug":"idiomatic-language-and-fixed-expressions","level":"C1","topic":"Idiomatic language and fixed expressions","category":"Vocabulary & Topics","contentType":"vocabulary","status":"ready","description":"Interpret and use high-value idiomatic chunks with attention to register, flexibility, connotation and the risk of overusing memorable expressions.","sequence":18,"prerequisites":["c1/connotation-nuance-and-implied-meaning","b2/idioms-and-fixed-expressions"],"related":["c1/phrasal-verbs-in-formal-and-informal-contexts","c1/organizing-complex-spoken-arguments"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Transparent and opaque idioms, fixed and semi-fixed frames, register, flexibility, connotation, discourse function, repair, spoken use, interpretation, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"70–85 min",outcome:"Interpret idiomatic chunks from context and use a small high-value set naturally, controlling grammar, register and flexibility rather than inserting memorable expressions for display.",focus:"idiomatic meaning, fixedness and register",tags:["formulaic language","discourse frames","natural restraint"],
retrieval:[{prompt:"Explain get to the point.",answer:"State the main idea directly."},{prompt:"Complete the fixed frame: That being ___,…",answer:"That being said, introduces a qualification or contrasting point."},{prompt:"Give a literal alternative to We are on the same page.",answer:"We share the same understanding or plan."}],
notice:{title:"Chunks do jobs that single words do not",setup:"A team discusses a difficult decision.",samples:["Let’s get to the point: the current plan is too expensive.","That being said, we should not throw the whole idea out.","We need to weigh the pros and cons and find a workable middle ground."],questions:["Which chunk organizes the conversation?","Which expression rejects an extreme reaction?","Which two chunks package evaluation and compromise?"],check:{question:"What does “throw the whole idea out” mean here?",answer:"Reject the entire idea rather than revise part of it.",options:[{value:"Reject the entire idea rather than revise part of it."},{value:"Physically place a document outdoors."},{value:"Approve every detail unchanged."}],hint:"Use the decision context, not the literal image."}},
discover:{principle:"Learn an expression with meaning, grammar, discourse function, register and flexibility. Some chunks are opaque idioms; many are semi-fixed frames whose value lies in rapid organization and socially recognizable phrasing.",formRows:[{label:"fixed idiom","form":"little internal change",example:"by and large; a blessing in disguise"},{label:"semi-fixed frame","form":"slot inside stable frame",example:"The point is that… / It is worth noting that…"},{label:"verb chunk","form":"verb inflects; partners stay stable",example:"weighed/weighing the pros and cons"},{label:"response formula","form":"complete interactional move",example:"That’s a fair point."}],meaningRows:[{choice:"organize",use:"move, frame or return to a point",example:"Let’s get to the point."},{choice:"evaluate",use:"summarize benefit, cost or uncertainty",example:"a mixed blessing"},{choice:"align",use:"check shared understanding",example:"Are we on the same page?"},{choice:"soften",use:"acknowledge before disagreement",example:"That’s a fair point. That being said…"}],pronunciation:"Formulaic chunks often form one rhythm unit: THAT-being-SAID, PROS-and-CONS, on-the-SAME-PAGE. Stress the changing content around the chunk, not every fixed word.",errors:[{wrong:"Use an idiom in every sentence to sound fluent.",correct:"Use a small number when their function and register fit.",why:"Overuse sounds rehearsed and can hide the main meaning."},{wrong:"We are in the same page.",correct:"We are on the same page.",why:"The preposition is fixed."},{wrong:"Every word inside an idiom may be replaced by a synonym.",correct:"Check which slots are flexible and which wording is conventional.",why:"Free substitution often destroys recognizability."}]},
reference:{title:"High-value functional chunks",intro:"Prioritize expressions that organize real discussion.",groups:[{heading:"Focus",items:["get to the point","the bottom line is","the point is that"]},{heading:"Balance",items:["weigh the pros and cons","a mixed blessing","find middle ground"]},{heading:"Respond",items:["that’s a fair point","that being said","I see where you’re coming from"]},{heading:"Progress",items:["on the right track","back to square one","a step in the right direction"]}]},
build:[
{question:"A speaker wants to state the main conclusion directly. Which chunk fits?",answer:"The bottom line is that the plan costs too much.",options:[{value:"The bottom line is that the plan costs too much."},{value:"The square line is under the table."},{value:"The plan is on a literal page."}],hint:"Bottom line introduces the essential conclusion."},
{question:"A result has both benefits and disadvantages. It is ___.",answer:"a mixed blessing",options:[{value:"a mixed blessing"},{value:"on the same page"},{value:"back to square one"}],hint:"Choose the evaluative idiom for mixed effects."},
{question:"The first plan failed, and the team must restart. It is ___.",answer:"back to square one",options:[{value:"back to square one"},{value:"a step in the right direction"},{value:"on the right track"}],hint:"The phrase means return to the beginning."},
{question:"Which phrase acknowledges before contrasting?",answer:"That’s a fair point. That being said, the sample is still too small.",options:[{value:"That’s a fair point. That being said, the sample is still too small."},{value:"Fair point means I fully agree forever."},{value:"That said being point."}],hint:"Use a response formula and concessive frame."},
{question:"Which expression checks shared understanding?",answer:"Are we on the same page?",options:[{value:"Are we on the same page?"},{value:"Are we in the identical paper?"},{value:"Do we square one?"}],hint:"The preposition and noun are fixed."},
{question:"Which phrase means evaluate advantages and disadvantages?",answer:"weigh the pros and cons",options:[{value:"weigh the pros and cons"},{value:"throw the idea out"},{value:"get to square"}],hint:"Pros and cons form a fixed pair."},
{question:"Which phrase describes useful progress without claiming completion?",answer:"a step in the right direction",options:[{value:"a step in the right direction"},{value:"the bottom line"},{value:"a blessing in every direction"}],hint:"The phrase evaluates partial progress."},
{question:"Which literal version best replaces “on the right track”?",answer:"The approach appears to be progressing toward the intended result.",options:[{value:"The approach appears to be progressing toward the intended result."},{value:"The team is standing on railway tracks."},{value:"The project has definitely finished."}],hint:"Preserve progress and direction, not a literal image."}],
context:{title:"A restrained idiomatic discussion",intro:"Interpret each chunk through its local function.",lines:["Let’s get to the point. The pilot reduced delays, but the cost increase makes it a mixed blessing.","That’s a fair point. That being said, one expensive month does not mean we should throw the whole idea out. The result may still be a step in the right direction.","Before choosing, we need to weigh the pros and cons and make sure the finance and operations teams are on the same page."],questions:[{question:"What is the main mixed effect?",answer:"Delays fell but costs rose.",options:[{value:"Delays fell but costs rose."},{value:"The pilot had no effects."},{value:"The teams used a railway."}],hint:"Interpret mixed blessing."},{question:"What does the speaker resist throwing out?",answer:"The whole pilot idea",options:[{value:"The whole pilot idea"},{value:"A physical object"},{value:"The finance team"}],hint:"Use the decision context."},{question:"How strong is “a step in the right direction”?",answer:"It presents partial positive progress, not completion.",options:[{value:"It presents partial positive progress, not completion."},{value:"It proves complete success."},{value:"It means restart from zero."}],hint:"A step is one part of a route."},{question:"Why mention the same page?",answer:"The teams need a shared understanding before deciding.",options:[{value:"The teams need a shared understanding before deciding."},{value:"Both teams need one sheet of paper."},{value:"The teams must agree with every detail."}],hint:"Shared understanding can exist before final agreement."}]},
builder:{title:"Build the balanced response",prompt:"Acknowledge, then preserve a qualification.",answer:"That is a fair point that being said the trial still needs review",tiles:["That","is","a","fair","point","that","being","said","the","trial","still","needs","review"]},
repairs:[{title:"Repair the preposition",sentence:"We are in the same page about the deadline.",answer:"in",fix:"We are on the same page about the deadline.",why:"On is fixed in this expression.",tokens:[{value:"we",label:"We are"},{value:"in",label:"in"},{value:"page",label:"the same page"},{value:"deadline",label:"about the deadline"}]},{title:"Repair the fixed pair",sentence:"We need to weigh the advantages and contras.",answer:"contras",fix:"We need to weigh the pros and cons.",why:"Pros and cons is the conventional fixed pair.",tokens:[{value:"we",label:"We need"},{value:"weigh",label:"to weigh"},{value:"advantages",label:"the advantages and"},{value:"contras",label:"contras"}]},{title:"Repair overuse",sentence:"The bottom line is we are on track, back to square one, and a blessing in disguise.",answer:"blessing",fix:"The bottom line is that the failed test puts us back at the beginning.",why:"One precise chunk is clearer than several incompatible idioms.",tokens:[{value:"bottom",label:"The bottom line is"},{value:"track",label:"we are on track"},{value:"square",label:"back to square one"},{value:"blessing",label:"and a blessing in disguise"}]},{title:"Repair free substitution",sentence:"Let’s arrive to the point.",answer:"arrive",fix:"Let’s get to the point.",why:"Get to the point is the conventional chunk.",tokens:[{value:"lets",label:"Let’s"},{value:"arrive",label:"arrive"},{value:"point",label:"to the point"}]}],
fluency:[{prompt:"Use three chunks to open, balance and close a decision.",answer:"Let’s get to the point. We need to weigh the pros and cons. The bottom line is that a short pilot is the safest next step."},{prompt:"Acknowledge and disagree.",answer:"That’s a fair point. That being said, the current evidence does not support a permanent change."},{prompt:"Replace an idiom with literal professional language.",answer:"We are back to square one becomes We need to restart the planning process."},{prompt:"Reject unnecessary idiom use aloud.",answer:"I could use an idiom here, but the literal phrase partial progress is clearer for this audience."}],
communicate:{title:"The natural-chunk meeting",setup:"Hold a two-minute decision discussion using no more than five idiomatic or fixed expressions.",roles:["Speaker: choose each chunk for a clear discourse job and keep grammar intact.","Listener: paraphrase each chunk literally, identify register, and reject any expression that feels forced."],prompts:["What job does this chunk do?","Can you paraphrase it?","Is the wording fixed or flexible?","Would literal language be clearer?"],success:["Every expression is recoverable from context.","Fixed grammar and register are accurate.","Restraint keeps the message more important than the idioms."]},
writing:{title:"Write a natural decision email",task:"Write 170 to 200 words using exactly four functional fixed expressions.",requirements:["Use one focus, one acknowledgment, one balance and one conclusion chunk.","Paraphrase each expression in plain language afterward.","Remove any chunk that does not improve organization or tone."],model:"Let’s get to the point: the pilot reduced delays, but costs rose. That’s a fair concern, and the increase needs investigation. That being said, one expensive month does not justify ending the trial immediately. We should weigh the pros and cons after another month of data. The bottom line is that a short extension with a spending limit gives us better evidence without committing to a permanent change. Plain meanings: state the main issue; acknowledge the concern; preserve a contrasting point; compare benefits and disadvantages; state the essential conclusion."},
reflect:{canDo:["Interpret idioms through function, context and connotation.","Control fixed grammar and limited flexibility.","Choose a small useful set instead of overloading discourse."],nextUse:"Collect three chunks from authentic conversation, record their function and register, and use each once in a relevant original context."}
};
