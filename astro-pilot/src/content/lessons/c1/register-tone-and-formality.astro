---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import StructuredLesson from "../../../components/lesson/StructuredLesson.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Register, tone, and formality · C1 Vocabulary","slug":"register-tone-and-formality","level":"C1","topic":"Register, tone, and formality","category":"Vocabulary & Topics","contentType":"vocabulary","status":"ready","description":"Adapt grammar, vocabulary, directness and interpersonal tone to audience, purpose, medium and power relationship without sounding artificial.","sequence":5,"prerequisites":["c1/advanced-modal-meaning-and-stance","b2/register-and-formality"],"related":["c1/collocation-and-lexical-precision","c1/phrasal-verbs-in-formal-and-informal-contexts"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Audience, purpose, medium, power, directness, lexical and grammatical register, tone repair, spoken delivery, email production, and reformulation were authored; three learner pilots remain."}});
export const lesson={
duration:"75–90 min",outcome:"Adapt the same message for a friend, colleague, client, and formal decision maker while preserving meaning and choosing an appropriate degree of directness, warmth, and authority.",focus:"audience, purpose, medium and power",tags:["directness","professional tone","genre choices"],
retrieval:[{prompt:"Make this request less direct: Send me the revised file today.",answer:"Could you send me the revised file today? / I’d appreciate it if you could send the revised file today."},{prompt:"Replace a conversational verb in a formal report: We looked into the complaint.",answer:"We investigated the complaint."},{prompt:"Make this formal sentence natural in conversation: We wish to ascertain your availability.",answer:"We’d like to find out when you’re available."}],
notice:{title:"One request, three workable versions",setup:"A speaker needs the same document, but the relationship and medium change.",samples:["Text to a close colleague: Can you send me the latest version when you get a chance?","Email to a new client: Could you please send the latest version by Thursday?","Formal notice: Please submit the latest version by 5:00 p.m. on Thursday."],questions:["Which version relies most on shared relationship and flexible timing?","Which version combines politeness with a clear deadline?","Why is the formal notice direct without necessarily being rude?"],check:{question:"What makes a message appropriate in register?",answer:"Its language fits the audience, purpose, medium, relationship, and expected genre.",options:[{value:"Its language fits the audience, purpose, medium, relationship, and expected genre."},{value:"It always uses the longest and rarest words."},{value:"It avoids every contraction in every situation."}],hint:"Formality is a relationship between language and context, not a list of forbidden forms."}},
discover:{principle:"Register is the set of language choices associated with a context. Tone is the attitude and relationship created in that moment. Appropriate language coordinates vocabulary, grammar, directness, detail, greeting, closing, and delivery.",formRows:[{label:"conversational","form":"contractions + common verbs + shared context",example:"We’ve looked into it, and we’ll get back to you."},{label:"neutral professional","form":"clear request + reason + realistic deadline",example:"Could you confirm the figures by Thursday so we can finalize the report?"},{label:"formal public","form":"explicit actors, terms and procedures",example:"Applicants must submit supporting documents by Thursday."},{label:"diplomatic disagreement","form":"acknowledge + qualify + alternative",example:"I see the benefit; however, a shorter pilot may be more realistic."}],meaningRows:[{choice:"directness","use":"rights, urgency and roles justify a clear instruction",example:"Stop the machine immediately."},{choice:"mitigation","use":"a request imposes on the listener or disagreement threatens rapport",example:"Would it be possible to move the deadline?"},{choice:"warmth","use":"the relationship benefits from personal acknowledgment",example:"Thanks for turning this around so quickly."},{choice:"distance","use":"a record must sound procedural or impartial",example:"The application was reviewed under the published criteria."}],pronunciation:"Tone depends on delivery as well as wording. A low fall can make a deadline final. A fall-rise can leave room for response. Stress the reason or shared goal, not every polite word.",errors:[{wrong:"Dear client, Send the file ASAP.",correct:"Dear Ms. Patel, could you please send the file by 3:00 p.m. today?",why:"The revision gives a specific deadline and matches a new professional relationship."},{wrong:"Hey! We hereby request your attendance.",correct:"Hi, could you join us? / We hereby request your attendance.",why:"The greeting and body should belong to the same register."},{wrong:"Formal writing never uses I, we, or contractions.",correct:"Formal choices depend on genre; clear professional writing may use personal pronouns and occasional contractions.",why:"Absolute bans often create stiff or evasive prose."}]},
reference:{title:"Register levers",intro:"Adjust only the features the situation requires.",groups:[{heading:"Vocabulary",items:["find out / determine","help / assist","put off / postpone","use / employ"]},{heading:"Grammar",items:["Can you…?","Could you…?","Would it be possible to…?","Applicants are required to…"]},{heading:"Organization",items:["greeting","purpose early","reason","action and deadline","closing"]}]},
build:[
{question:"A fire alarm is sounding. Which instruction is appropriately direct?",answer:"Leave the building immediately.",options:[{value:"Leave the building immediately."},{value:"You might perhaps consider leaving someday."},{value:"Would departure theoretically be conceivable?"}],hint:"Safety and urgency justify a direct imperative."},
{question:"A new client has not sent a file. Which reminder balances clarity and politeness?",answer:"Could you please send the signed form by noon tomorrow?",options:[{value:"Could you please send the signed form by noon tomorrow?"},{value:"Send it now."},{value:"Yo, where’s the form?"}],hint:"Use a clear action and deadline with proportionate mitigation."},
{question:"Which sentence fits a neutral investigation report?",answer:"The team investigated three possible causes.",options:[{value:"The team investigated three possible causes."},{value:"The team poked around a bunch of stuff."},{value:"The team effectuated an ascertainment of causality."}],hint:"Neutral professional language is clear, not inflated."},
{question:"A close colleague asks for a quick update in chat. Which response fits?",answer:"I’m checking it now and I’ll message you in ten minutes.",options:[{value:"I’m checking it now and I’ll message you in ten minutes."},{value:"The undersigned hereby initiates an examination."},{value:"Your request is rejected without explanation."}],hint:"Shared context allows contractions and common verbs."},
{question:"Which disagreement is most diplomatic?",answer:"I see why that option is attractive; however, the current budget may not support it.",options:[{value:"I see why that option is attractive; however, the current budget may not support it."},{value:"That idea is ridiculous."},{value:"I fully agree, so I reject it."}],hint:"Acknowledge the rationale before presenting the constraint."},
{question:"Which closing gives a client a clear next step?",answer:"Please confirm by Friday so we can reserve the date.",options:[{value:"Please confirm by Friday so we can reserve the date."},{value:"Anyway, whatever."},{value:"Your compliance is mandated irrespective of feasibility."}],hint:"Connect action, deadline and reason."},
{question:"Which revision removes unnecessary bureaucratic language?",answer:"We used the results to improve the process.",options:[{value:"We used the results to improve the process."},{value:"We operationalized the utilization of results."},{value:"Results improvement thing happened."}],hint:"Prefer a precise common verb when it carries the meaning."},
{question:"A policy applies equally to all applicants. Which version fits the public genre?",answer:"All applicants must provide proof of address.",options:[{value:"All applicants must provide proof of address."},{value:"Can you guys maybe send us something?"},{value:"I personally feel like addresses are nice."}],hint:"A public rule needs explicit scope and obligation."}],
context:{title:"A delayed delivery in three genres",intro:"Track what changes and what remains stable.",lines:["Team chat: The shipment’s late again. I’m calling the supplier now and I’ll update you by two.","Client email: The shipment has been delayed. We are contacting the supplier and will provide a confirmed delivery time by 2:00 p.m.","Incident record: The carrier reported a delay at 10:15 a.m. The operations team requested a revised delivery estimate and scheduled a client update for 2:00 p.m."],questions:[{question:"Which version assumes the most shared context?",answer:"The team chat",options:[{value:"The team chat"},{value:"The incident record"},{value:"All three equally"}],hint:"Notice the contractions and omitted explanation."},{question:"Which version most clearly manages the client relationship?",answer:"The client email",options:[{value:"The client email"},{value:"The team chat"},{value:"The incident record only"}],hint:"It names the problem, action and promised update."},{question:"Which version prioritizes a factual audit trail?",answer:"The incident record",options:[{value:"The incident record"},{value:"The team chat"},{value:"The client email because it is warmer"}],hint:"Look for time, actor and documented actions."},{question:"What remains stable across all three?",answer:"The delivery is late, the supplier is being contacted, and an update is due at two.",options:[{value:"The delivery is late, the supplier is being contacted, and an update is due at two."},{value:"The supplier has already solved the delay."},{value:"The client canceled the order."}],hint:"Separate core meaning from register choices."}]},
builder:{title:"Build the professional request",prompt:"Ask clearly, politely, and with a reason.",answer:"Could you confirm the figures by Friday so we can finalize the report",tiles:["Could","you","confirm","the","figures","by","Friday","so","we","can","finalize","the","report"]},
repairs:[{title:"Replace an abrupt client request",sentence:"Send me the contract today.",answer:"Send",fix:"Could you please send me the contract by 5:00 p.m. today?",why:"A specific deadline and proportionate mitigation fit the client relationship.",tokens:[{value:"send",label:"Send"},{value:"me",label:"me"},{value:"contract",label:"the contract"},{value:"today",label:"today"}]},{title:"Remove inflated wording",sentence:"We will utilize the meeting to facilitate an exchange of learnings.",answer:"utilize",fix:"We will use the meeting to share what we learned.",why:"Common precise verbs make the purpose clearer.",tokens:[{value:"we",label:"We will"},{value:"utilize",label:"utilize"},{value:"meeting",label:"the meeting"},{value:"facilitate",label:"to facilitate an exchange of learnings"}]},{title:"Align greeting and body",sentence:"Hey Dr. Chen, We hereby demand your immediate response.",answer:"demand",fix:"Dear Dr. Chen, we would appreciate a response by Friday.",why:"The original mixes casual address with disproportionate formal force.",tokens:[{value:"hey",label:"Hey Dr. Chen"},{value:"we",label:"We hereby"},{value:"demand",label:"demand"},{value:"response",label:"your immediate response"}]},{title:"Make the action explicit",sentence:"Regarding the matter below, your attention would be appreciated.",answer:"attention",fix:"Please review the attached figures and confirm them by Thursday.",why:"The revision names the action and deadline instead of hiding them in vague formality.",tokens:[{value:"regarding",label:"Regarding the matter below"},{value:"your",label:"your"},{value:"attention",label:"attention"},{value:"appreciated",label:"would be appreciated"}]}],
fluency:[{prompt:"Deliver the same deadline to a friend, colleague and client.",answer:"Friend: Can you send it by Friday? Colleague: Could you send it by Friday so I can finish the report? Client: Could you please return the signed form by Friday?"},{prompt:"Turn a bureaucratic sentence into clear professional English.",answer:"An evaluation of the proposal will be undertaken becomes We will evaluate the proposal."},{prompt:"Disagree directly, neutrally and diplomatically.",answer:"No, that will not work. I do not think the current plan is feasible. I see the appeal, but the current budget may make a smaller pilot more realistic."},{prompt:"Use intonation to make the same words final, tentative and corrective.",answer:"Stress and a falling tone can make the deadline final; a fall-rise can invite discussion; contrastive stress can correct the misunderstood detail."}],
communicate:{title:"The audience-switch briefing",setup:"Choose one non-personal message and deliver it to three audiences with different roles and expectations.",roles:["Speaker: preserve the core meaning while adapting directness, vocabulary, organization and delivery.","Audience analyst: identify every register choice and challenge any version that sounds vague, rude or artificially formal."],prompts:["Who is the reader or listener?","What action must be clear?","How much mitigation is proportionate?","Which details belong in this medium?"],success:["The core message remains stable.","The level of directness fits urgency, rights and power.","Vocabulary and grammar sound natural for the genre, not merely more complex."]},
writing:{title:"Write one message in two registers",task:"Write a 120-word client email and a 60-word internal chat update about the same delay.",requirements:["Keep the facts and promised action identical.","Give the client a clear reason, deadline and next step.","Use natural contractions only where they fit the relationship and medium."],model:"Client email: The shipment has been delayed because the carrier missed its morning connection. We are contacting the regional depot and will send you a confirmed delivery time by 2:00 p.m. If the revised time does not meet your schedule, please let us know and we will arrange an alternative. Internal chat: The shipment’s late after a missed connection. I’m calling the depot now and will update everyone by two. If the new time is too late, we’ll arrange another option."},
reflect:{canDo:["Adapt directness, vocabulary and grammar to audience and purpose.","Recognize clear professional language versus inflated formality.","Preserve meaning while changing medium, tone and relationship."],nextUse:"Take one real low-risk message, create a more formal and a more conversational version, and explain every change you made."}
};
