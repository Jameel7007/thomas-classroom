import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Concession, contrast, and counterargument · C1 Grammar","slug":"concession-contrast-and-counterargument","level":"C1","topic":"Concession, contrast, and counterargument","category":"Grammar","contentType":"grammar","status":"ready","description":"Acknowledge serious opposing evidence, distinguish concession from contrast, and build proportionate counterarguments in speech and writing.","sequence":15,"prerequisites":["c1/advanced-discourse-markers-and-cohesion","c1/hedging-and-cautious-language"],"related":["c1/organizing-complex-spoken-arguments","c1/advanced-emphasis-and-cleft-structures"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Contrast, concession, rebuttal, qualification, steelmanning, evidence weighting, clause patterns, repair, spoken challenge, argument structure, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Acknowledge a strong opposing point fairly, show exactly what it changes, and build a proportionate counterargument instead of dismissing or surrendering the main claim.",focus:"concession, evidence weighting and rebuttal",tags:["counterargument","although/despite","fair argument"],
retrieval:[{prompt:"Contrast two neutral facts with whereas.",answer:"Clinic A reduced waiting time, whereas Clinic B showed no change."},{prompt:"Concede a limit but preserve a recommendation.",answer:"Although the sample was small, the consistent result justifies a larger trial."},{prompt:"Soften a rebuttal.",answer:"That concern is valid; however, it may not apply under the conditions tested here."}],
notice:{title:"A serious objection changes the argument, but does not always defeat it",setup:"A committee discusses remote work.",samples:["Remote work can reduce commuting time. By contrast, office work may support informal collaboration.","Although informal contact matters, the current survey does not show that daily attendance improves results.","Admittedly, the survey is short; even so, its consistent pattern supports a longer trial."],questions:["Which sentence simply contrasts two possible benefits?","Which sentence concedes a point before limiting its evidential force?","What does admittedly signal about the speaker’s treatment of the weakness?"],check:{question:"What makes a concession fair?",answer:"It represents a relevant opposing point accurately and states how much it affects the claim.",options:[{value:"It represents a relevant opposing point accurately and states how much it affects the claim."},{value:"It mocks the opposing view before ignoring it."},{value:"It agrees with every objection completely."}],hint:"A concession is neither dismissal nor surrender."}},
discover:{principle:"Contrast places differences side by side. Concession accepts that a fact or argument has weight despite the direction of the main claim. Counterargument evaluates that weight, then limits, answers or incorporates it with evidence.",formRows:[{label:"clause concession","form":"although/even though + clause",example:"Although the sample was small, the pattern was consistent."},{label:"noun/gerund concession","form":"despite/in spite of + noun/-ing",example:"Despite the small sample, the pattern was consistent."},{label:"sentence concession","form":"admittedly/to be sure + clause; nevertheless…",example:"Admittedly, costs rose. Nevertheless, access improved."},{label:"contrast","form":"whereas/by contrast/on the other hand",example:"Clinic A improved, whereas Clinic B did not."}],meaningRows:[{choice:"acknowledge",use:"the opposing point is valid or relevant",example:"That concern is well founded."},{choice:"limit",use:"you identify scope, evidence or applicability",example:"However, it applies mainly to very small teams."},{choice:"outweigh",use:"stronger evidence supports the main position",example:"Even so, the safety benefit is greater."},{choice:"integrate",use:"the objection leads to a revised proposal",example:"A hybrid trial would address both concerns."}],pronunciation:"Use a fall-rise to keep a concession open: The SAMPLE is small | but the PATTERN is consistent. Give the main counterclaim the stronger final fall.",errors:[{wrong:"Despite the sample was small, the result mattered.",correct:"Although the sample was small… / Despite the small sample…",why:"Despite takes a noun or -ing form, not a finite clause."},{wrong:"The objection is wrong because I disagree.",correct:"The objection identifies a real cost, but the available evidence suggests…",why:"A counterargument needs reasoning or evidence."},{wrong:"Although introduces the main conclusion automatically.",correct:"Although introduces the concessive clause; clause order can vary, but the logical relationship must remain clear.",why:"Grammar does not decide which evidence deserves greater weight."}]},
reference:{title:"Counterargument route",intro:"Treat the strongest relevant version of the opposing case.",groups:[{heading:"Represent",items:["A reasonable concern is…","Supporters argue…","The strongest evidence against this is…"]},{heading:"Evaluate",items:["This matters because…","Its scope is limited by…","The evidence is stronger/weaker because…"]},{heading:"Respond",items:["Even so…","This does not establish…","A revised proposal could…"]}]},
build:[
{question:"Which sentence expresses concession, not simple contrast?",answer:"Although costs rose, access improved.",options:[{value:"Although costs rose, access improved."},{value:"Costs rose, whereas access improved at another site."},{value:"Costs and access are two nouns."}],hint:"One result holds despite an expected obstacle."},
{question:"Complete with despite: ___, the trial continued.",answer:"Despite the higher cost",options:[{value:"Despite the higher cost"},{value:"Despite costs were higher"},{value:"Despite of the cost was high"}],hint:"Despite takes a noun phrase."},
{question:"Which response fairly acknowledges an objection?",answer:"The concern about informal collaboration is valid.",options:[{value:"The concern about informal collaboration is valid."},{value:"Only an idiot would worry about collaboration."},{value:"There are no possible disadvantages."}],hint:"State the strongest relevant concern without caricature."},
{question:"Which sentence limits an overbroad objection?",answer:"That evidence comes from new employees and may not apply to experienced teams.",options:[{value:"That evidence comes from new employees and may not apply to experienced teams."},{value:"The evidence is bad because I dislike it."},{value:"One study proves every context."}],hint:"Identify population and applicability."},
{question:"Which sentence integrates the objection into a revision?",answer:"A two-day office schedule could preserve informal contact while reducing commuting.",options:[{value:"A two-day office schedule could preserve informal contact while reducing commuting."},{value:"The objection changes nothing and needs no answer."},{value:"We must choose every extreme at once."}],hint:"Use the concern to improve the proposal."},
{question:"Which pair correctly balances concession and counterclaim?",answer:"Admittedly, the study was brief. Even so, the stable result supports a longer trial.",options:[{value:"Admittedly, the study was brief. Even so, the stable result supports a longer trial."},{value:"Therefore the study was brief, because the result was stable."},{value:"Admittedly means the result is false."}],hint:"Accept the weakness, then state what remains justified."},
{question:"Which structure uses whereas correctly?",answer:"The urban sites improved, whereas the rural sites showed no clear change.",options:[{value:"The urban sites improved, whereas the rural sites showed no clear change."},{value:"Whereas the cost, the trial continued."},{value:"The sites whereas improved."}],hint:"Whereas links contrasting clauses."},
{question:"Which counterclaim matches cautious evidence?",answer:"The objection reduces our confidence but does not rule out a limited pilot.",options:[{value:"The objection reduces our confidence but does not rule out a limited pilot."},{value:"The objection proves the proposal perfect."},{value:"The objection must be ignored completely."}],hint:"State proportionate effect, not total victory."}],
context:{title:"A balanced transport proposal",intro:"Map objection, concession, limit and revised recommendation.",lines:["A late-night bus could improve access for shift workers. Critics reasonably note that the current ridership estimate is uncertain and that an empty route would waste public funds.","Admittedly, the survey includes only three large employers. However, ticket data show substantial travel after the last existing bus. This evidence does not prove that a nightly service would be sustainable.","Even so, it supports a three-month Friday-and-Saturday pilot. A limited schedule would test real demand while controlling cost, and monthly review points would allow the city to stop or revise the service."],questions:[{question:"What is the strongest opposing concern?",answer:"Demand may be too low to justify public cost.",options:[{value:"Demand may be too low to justify public cost."},{value:"Shift workers never travel."},{value:"The city has already run the pilot."}],hint:"Combine uncertain ridership and empty-route cost."},{question:"What limitation does the writer concede?",answer:"The survey covers only three large employers.",options:[{value:"The survey covers only three large employers."},{value:"Ticket data do not exist."},{value:"Every bus is full."}],hint:"Read admittedly."},{question:"What does the evidence not prove?",answer:"A nightly service would be sustainable.",options:[{value:"A nightly service would be sustainable."},{value:"Some late travel exists."},{value:"The last bus has a schedule."}],hint:"The writer explicitly limits the inference."},{question:"How does the recommendation incorporate the objection?",answer:"It proposes a limited reviewed pilot rather than permanent nightly service.",options:[{value:"It proposes a limited reviewed pilot rather than permanent nightly service."},{value:"It ignores cost."},{value:"It cancels all transport."}],hint:"Find the scope and review points."}]},
builder:{title:"Build the proportionate counterclaim",prompt:"Acknowledge the limit while preserving the next step.",answer:"Although the evidence is limited it supports a carefully monitored pilot",tiles:["Although","the","evidence","is","limited","it","supports","a","carefully","monitored","pilot"]},
repairs:[{title:"Repair despite grammar",sentence:"Despite the sample was small, the trial continued.",answer:"was",fix:"Although the sample was small, the trial continued. / Despite the small sample, the trial continued.",why:"Despite takes a noun phrase, not a finite clause.",tokens:[{value:"despite",label:"Despite"},{value:"sample",label:"the sample"},{value:"was",label:"was small"},{value:"trial",label:"the trial continued"}]},{title:"Replace dismissal with response",sentence:"The cost objection is stupid, so we can ignore it.",answer:"stupid",fix:"The cost objection is valid; however, a limited pilot would control the financial risk.",why:"The revision acknowledges and answers the concern.",tokens:[{value:"cost",label:"The cost objection"},{value:"stupid",label:"is stupid"},{value:"ignore",label:"so we can ignore it"}]},{title:"Match contrast relation",sentence:"The sample was small. Therefore, the result was consistent.",answer:"Therefore",fix:"The sample was small. Nevertheless, the result was consistent.",why:"Consistency holds despite the limitation.",tokens:[{value:"sample",label:"The sample was small"},{value:"therefore",label:"Therefore"},{value:"result",label:"the result was consistent"}]},{title:"Limit the victory claim",sentence:"The objection is imperfect, so our proposal is definitely correct.",answer:"definitely",fix:"The objection does not rule out a limited pilot, but the proposal still requires testing.",why:"Weakness in an objection does not prove the main claim.",tokens:[{value:"objection",label:"The objection is imperfect"},{value:"proposal",label:"so our proposal is"},{value:"definitely",label:"definitely correct"}]}],
fluency:[{prompt:"State a strong objection before responding.",answer:"A serious concern is that the estimate covers only large employers. That limits generalization, but ticket data still justify a small pilot."},{prompt:"Transform although into despite.",answer:"Although the sample was small becomes Despite the small sample."},{prompt:"Integrate an objection into a revised plan.",answer:"Because cost is uncertain, begin with weekend service and review actual demand monthly."},{prompt:"Use intonation to keep concession subordinate to the main claim.",answer:"Use a fall-rise on the conceded limit and a stronger final fall on the recommendation."}],
communicate:{title:"The steelman panel",setup:"Debate a non-personal policy. Each speaker must present the strongest opposing case before defending a revised recommendation.",roles:["Proposer: state evidence, concede a real weakness and integrate it into the plan.","Reviewer: reject caricatures, test causal and scope claims, and decide what the objection actually changes."],prompts:["The strongest objection is…","This matters because…","Its scope is limited by…","A revised proposal could…"],success:["The opposing case is represented fairly.","Concessions have accurate grammar and proportionate weight.","The final counterargument follows from evidence rather than confidence alone."]},
writing:{title:"Write a concession and counterargument",task:"Write 200 to 240 words supporting a limited policy trial.",requirements:["Present the strongest objection in good faith.","Use although or despite plus one sentence-level concession.","Revise the proposal to address at least one valid concern."],model:"A late-night bus could improve access for shift workers. Critics reasonably note that ridership estimates are uncertain and that an empty route would waste public funds. Admittedly, the survey covers only three large employers. However, ticket records show substantial travel after the final existing bus. Although this evidence does not prove that nightly service is sustainable, it supports a three-month weekend pilot. A limited schedule and monthly review would test actual demand while controlling cost. The objection therefore changes the scale of the proposal, but it does not eliminate the case for testing it."},
reflect:{canDo:["Distinguish contrast, concession and counterargument.","Represent an opposing point fairly and evaluate its weight.","Revise a claim or proposal in response to valid concerns."],nextUse:"Write the strongest objection to one of your own views, then state exactly what it changes and what it leaves intact."}
};
