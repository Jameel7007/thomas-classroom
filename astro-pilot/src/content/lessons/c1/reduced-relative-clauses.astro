---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Reduced relative clauses · C1 Grammar","slug":"reduced-relative-clauses","level":"C1","topic":"Reduced relative clauses","category":"Grammar","contentType":"grammar","status":"ready","description":"Reduce active and passive relative clauses when reference remains clear, and retain the full clause when reduction would create ambiguity.","sequence":11,"prerequisites":["c1/participle-clauses","b2/non-defining-relative-clauses"],"related":["c1/nominalization-and-information-density","c1/referencing-and-avoiding-repetition"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Active, passive, infinitive and adjective reductions, defining reference, tense limits, ambiguity, punctuation, repair, description, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"70–85 min",outcome:"Reduce relative clauses for efficient noun phrases while preserving voice, time and reference, and retain a full clause when the shorter form would be ambiguous or misleading.",focus:"relative-clause reduction and reference clarity",tags:["noun-phrase density","active/passive meaning","editing"],
retrieval:[{prompt:"Identify the head noun and relative clause: The report that Maya submitted was approved.",answer:"Head noun: report. Relative clause: that Maya submitted."},{prompt:"Contrast active and passive: people waiting outside / documents stored online.",answer:"People actively wait; documents receive the storing action."},{prompt:"Remove an object relative pronoun: The file that I sent is attached.",answer:"The file I sent is attached."}],
notice:{title:"A full clause and its compact alternative",setup:"Compare descriptions from a recruitment report.",samples:["Applicants who live outside the region may interview online. / Applicants living outside the region may interview online.","Applications that were received after Friday were not reviewed. / Applications received after Friday were not reviewed.","The next candidate who will be interviewed is Maya. / The next candidate to be interviewed is Maya."],questions:["Which reduction keeps active meaning?","Which reduction keeps passive meaning?","Why does the final example use an infinitive?"],check:{question:"When is “received after Friday” passive?",answer:"Applications receive the action of being received; they do not receive something themselves.",options:[{value:"Applications receive the action of being received; they do not receive something themselves."},{value:"Applications actively receive the reviewers."},{value:"Received always marks future time."}],hint:"Ask whether the head noun performs or receives the verb’s action."}},
discover:{principle:"A reduced relative clause modifies a head noun without a finite relative marker and auxiliary. Use -ing for active meaning, a past participle for passive/result meaning, and to + verb for ordered, expected or available action. Keep the full clause when tense, modality or reference would be lost.",formRows:[{label:"active reduction","form":"noun + -ing phrase",example:"Staff working remotely need secure access."},{label:"passive reduction","form":"noun + past participle phrase",example:"Files created today appear here."},{label:"infinitive reduction","form":"the first/next/only + noun + to + verb",example:"The next person to speak is Ana."},{label:"object-relative omission","form":"noun + subject + verb",example:"The report we discussed is public."}],meaningRows:[{choice:"defining reference",use:"the phrase identifies which noun is meant",example:"Requests received after noon will wait"},{choice:"temporary active situation",use:"an -ing phrase describes ongoing activity",example:"people waiting outside"},{choice:"result/source",use:"a participle identifies something through an action received",example:"data collected in May"},{choice:"future/order",use:"an infinitive marks what is expected, available or next",example:"the first team to finish"}],pronunciation:"Keep the reduced phrase inside the noun phrase: the DATA collected in MAY. Do not pause as if it were a separate main clause unless the phrase is non-defining and clearly parenthetical.",errors:[{wrong:"The people worked remotely need access.",correct:"The people working remotely need access.",why:"Active reduction uses -ing, not a finite past form."},{wrong:"The report submitting yesterday was approved.",correct:"The report submitted yesterday was approved.",why:"The report receives the submission action."},{wrong:"The manager approved the plan arriving tomorrow.",correct:"The manager who approved the plan is arriving tomorrow.",why:"The original reduction makes plan appear to be the arriving noun."}]},
reference:{title:"Reduction test",intro:"Expand first, then reduce only if the relationship survives.",groups:[{heading:"Active",items:["who works → working","that affects → affecting"]},{heading:"Passive",items:["that was written → written","which is based → based"]},{heading:"Keep full",items:["different subject","important tense/modal","unclear head noun","needed non-defining comment"]}]},
build:[
{question:"Reduce “employees who work remotely.”",answer:"employees working remotely",options:[{value:"employees working remotely"},{value:"employees worked remotely"},{value:"employees being work remotely"}],hint:"The employees actively work."},
{question:"Reduce “documents that were signed yesterday.”",answer:"documents signed yesterday",options:[{value:"documents signed yesterday"},{value:"documents signing yesterday"},{value:"documents sign yesterday"}],hint:"Documents receive the signing action."},
{question:"Reduce “the first team that will finish.”",answer:"the first team to finish",options:[{value:"the first team to finish"},{value:"the first team finishing yesterday"},{value:"the first team finished by itself"}],hint:"First plus expected action favors an infinitive."},
{question:"Which object relative may omit the marker?",answer:"The proposal we reviewed was accepted.",options:[{value:"The proposal we reviewed was accepted."},{value:"The proposal reviewed us was accepted."},{value:"The proposal we was accepted."}],hint:"We is the subject of reviewed; proposal is its object."},
{question:"Which reduction preserves passive meaning?",answer:"Evidence collected from three sites supports the claim.",options:[{value:"Evidence collected from three sites supports the claim."},{value:"Evidence collecting three sites supports the claim."},{value:"Evidence collect supports sites."}],hint:"Evidence receives the collecting action."},
{question:"Which sentence should retain a full clause to preserve modality?",answer:"Applicants who may need support should contact us.",options:[{value:"Applicants who may need support should contact us."},{value:"Applicants may needing support should contact us."},{value:"Applicants needed support may contact us yesterday."}],hint:"The modal may is important and has no clean simple reduction."},
{question:"Which phrase clearly identifies an active ongoing group?",answer:"Passengers waiting on platform three",options:[{value:"Passengers waiting on platform three"},{value:"Passengers waited on platform three"},{value:"Passengers waited by platform three modify"}],hint:"Use -ing for active ongoing meaning."},
{question:"Which sentence avoids attachment ambiguity?",answer:"The director who approved the plan is arriving tomorrow.",options:[{value:"The director who approved the plan is arriving tomorrow."},{value:"The director approved the plan arriving tomorrow."},{value:"The plan approving director arrives itself."}],hint:"Keep the full clause so arriving clearly refers to director."}],
context:{title:"A compact research summary",intro:"Identify each reduced phrase and its head noun.",lines:["Participants living more than twenty miles from the clinic completed interviews online. Data collected during those interviews were stored separately.","Responses containing personal identifiers were removed before analysis. The first researcher to review the anonymous set reported two missing fields.","A correction that the research team issued later explained the omission. Readers who may need the original coding guide can request it."],questions:[{question:"Who lives far from the clinic?",answer:"Participants",options:[{value:"Participants"},{value:"The clinic"},{value:"Interviews"}],hint:"Living modifies the head noun participants."},{question:"What received the collecting action?",answer:"Data",options:[{value:"Data"},{value:"Participants"},{value:"The clinic"}],hint:"Collected is passive."},{question:"What does “to review” express?",answer:"The researcher was first in an ordered or expected action.",options:[{value:"The researcher was first in an ordered or expected action."},{value:"The data reviewed the researcher."},{value:"The review happened before the study existed."}],hint:"The first plus infinitive marks order."},{question:"Why is “who may need” not reduced?",answer:"The modal may carries important possibility meaning.",options:[{value:"The modal may carries important possibility meaning."},{value:"Readers cannot modify nouns."},{value:"All relative clauses must be reduced."}],hint:"A reduction would lose the modal."}]},
builder:{title:"Build the passive reduction",prompt:"Identify files through the time they were created.",answer:"Files created today appear at the top of the list",tiles:["Files","created","today","appear","at","the","top","of","the","list"]},
repairs:[{title:"Repair active reduction",sentence:"Employees worked remotely need secure access.",answer:"worked",fix:"Employees working remotely need secure access.",why:"The employees actively work, so use -ing.",tokens:[{value:"employees",label:"Employees"},{value:"worked",label:"worked remotely"},{value:"need",label:"need secure access"}]},{title:"Repair passive reduction",sentence:"The report submitting yesterday was approved.",answer:"submitting",fix:"The report submitted yesterday was approved.",why:"The report receives the submission action.",tokens:[{value:"report",label:"The report"},{value:"submitting",label:"submitting yesterday"},{value:"approved",label:"was approved"}]},{title:"Restore important modality",sentence:"Applicants needing require assistance should call.",answer:"needing",fix:"Applicants who may require assistance should call.",why:"The full clause preserves possibility and correct verb form.",tokens:[{value:"applicants",label:"Applicants"},{value:"needing",label:"needing require assistance"},{value:"should",label:"should call"}]},{title:"Repair attachment",sentence:"We interviewed the manager leading the project who arrived yesterday.",answer:"leading",fix:"We interviewed the manager who arrived yesterday and who leads the project.",why:"The expanded clauses make both descriptions attach clearly to manager.",tokens:[{value:"we",label:"We interviewed"},{value:"manager",label:"the manager"},{value:"leading",label:"leading the project"},{value:"who",label:"who arrived yesterday"}]}],
fluency:[{prompt:"Expand and reduce an active relative.",answer:"Staff who handle private data need training becomes Staff handling private data need training."},{prompt:"Expand and reduce a passive relative.",answer:"The files that were created today appear here becomes The files created today appear here."},{prompt:"Use an infinitive reduction with next.",answer:"The next person to speak is Dr. Chen."},{prompt:"Explain why one clause should stay full.",answer:"Applicants who may need support keeps may; reducing it would lose the intended possibility."}],
communicate:{title:"The clarity editor",setup:"Edit a dense professional paragraph, reducing four safe relatives and expanding two ambiguous reductions.",roles:["Writer: identify head nouns, voice, time and intended reference.","Editor: require an expanded source for every reduction and reject any loss of meaning."],prompts:["What is the head noun?","Does it perform or receive the action?","Is modality or tense important?","Could the phrase attach elsewhere?"],success:["Every reduction has a recoverable full clause.","Voice and reference remain clear.","Density improves without hiding time, modality or actors."]},
writing:{title:"Write a compact research description",task:"Write 170 to 210 words describing participants, evidence and procedures.",requirements:["Use two active, two passive and one infinitive reduction.","Keep one full relative clause because it contains important modality.","Underline each reduced phrase and identify its head noun."],model:"Participants living more than twenty miles from the clinic completed online interviews. Data collected in May were stored separately from responses gathered during the pilot. Files containing names were removed before analysis. The first researcher to examine the anonymous set reported two missing fields. A correction issued the following week explained the omission. Readers who may need the original coding guide can request it from the research office."},
reflect:{canDo:["Reduce active, passive and ordered relative meanings.","Preserve head-noun reference, voice and important modality.","Expand a reduction when attachment or meaning is unclear."],nextUse:"Edit one paragraph by expanding every reduced relative first, then keep only the reductions that remain fully clear."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
