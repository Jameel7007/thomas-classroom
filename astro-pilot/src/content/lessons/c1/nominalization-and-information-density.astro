---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Nominalization and information density · C1 Grammar","slug":"nominalization-and-information-density","level":"C1","topic":"Nominalization and information density","category":"Grammar","contentType":"grammar","status":"ready","description":"Use nominalization to manage information density and formality while preserving agents, actions and accountability when they matter.","sequence":12,"prerequisites":["c1/reduced-relative-clauses","b2/abstract-and-academic-topics"],"related":["c1/advanced-discourse-markers-and-cohesion","c1/register-tone-and-formality"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Nominal forms, information packaging, grammatical metaphor, agent visibility, cohesion, unpacking, pronunciation, repair, explanation, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Package actions and qualities as nouns when it improves cohesion or abstraction, then unpack dense wording to restore clear actors, actions and responsibility.",focus:"nominalization, density and agent visibility",tags:["formal writing","information packaging","accountability"],
retrieval:[{prompt:"Turn decide into a noun and use it in a chunk.",answer:"decision: make/reach a decision"},{prompt:"Turn The team analyzed the data into a noun phrase.",answer:"the team’s analysis of the data"},{prompt:"Unpack implementation of the policy.",answer:"someone implements the policy; name the actor if it matters."}],
notice:{title:"The same event as clause and noun phrase",setup:"Compare a clear action with two increasingly dense versions.",samples:["The committee rejected the proposal because costs had increased.","The committee’s rejection of the proposal followed an increase in costs.","The rejection followed cost increases."],questions:["Which version makes the committee most visible?","Which version turns two processes into nouns?","What responsibility or time detail becomes less explicit in the shortest version?"],check:{question:"What is nominalization?",answer:"It packages a process, quality or relationship as a noun or noun phrase.",options:[{value:"It packages a process, quality or relationship as a noun or noun phrase."},{value:"It changes every noun into an imperative."},{value:"It guarantees clearer writing in every context."}],hint:"Compare rejected with rejection and increased with increase."}},
discover:{principle:"Nominalization helps name concepts, build lexical chains and compress known information. It also hides tense, modality and actors unless those are restored elsewhere. Choose density deliberately, not automatically.",formRows:[{label:"verb to noun","form":"decide → decision; fail → failure",example:"The decision followed the review."},{label:"adjective to noun","form":"available → availability",example:"Limited availability delayed the launch."},{label:"agent retained","form":"actor’s noun + of",example:"The regulator’s approval of the plan"},{label:"unpacked clause","form":"actor + finite verb + object",example:"The regulator approved the plan."}],meaningRows:[{choice:"concept building",use:"a process becomes a topic for later reference",example:"The team evaluated the pilot. This evaluation…"},{choice:"information compression",use:"known actions become background inside a noun phrase",example:"Following approval of the plan…"},{choice:"formal abstraction",use:"the text discusses patterns rather than one event",example:"Access depends on resource distribution."},{choice:"agent management",use:"the writer names or suppresses responsibility",example:"The agency’s cancellation versus the cancellation"}],pronunciation:"Long nominal groups need clear chunking. Stress the final content word in each unit: the rapid IMPLEMENTATION | of the revised POLICY. Pause before adding another heavy phrase.",errors:[{wrong:"Nominalization is always more advanced and better.",correct:"Use it when abstraction or cohesion helps; unpack it when actors and actions matter.",why:"Excessive density makes prose vague and difficult to process."},{wrong:"The implementation failed.",correct:"The agency failed to implement the policy / The policy implementation failed because…",why:"Name what was implemented and who acted when those details matter."},{wrong:"We made an analysis of the data.",correct:"We analyzed the data / We conducted an analysis of the data.",why:"Avoid a weak light-verb phrase unless the noun is the needed discourse topic."}]},
reference:{title:"Density decisions",intro:"Ask what the reader needs to see as action and what can become a concept.",groups:[{heading:"Useful families",items:["decide/decision","assess/assessment","comply/compliance","available/availability","stable/stability"]},{heading:"Keep visible",items:["actor","time","modality","responsibility","causal strength"]},{heading:"Unpack when",items:["three or more dense nouns stack","the actor is unclear","the verb would be simpler","accountability matters"]}]},
build:[
{question:"Nominalize “the committee decided.”",answer:"the committee’s decision",options:[{value:"the committee’s decision"},{value:"the committee decidingly"},{value:"the decide committee"}],hint:"Use decision and retain the actor as possessive."},
{question:"Which version clearly names the approving actor?",answer:"The regulator’s approval of the plan",options:[{value:"The regulator’s approval of the plan"},{value:"Approval happened"},{value:"The plan approval thing"}],hint:"Retain the actor before the nominalized process."},
{question:"Which sentence is clearest when responsibility matters?",answer:"The contractor failed to inspect the bridge.",options:[{value:"The contractor failed to inspect the bridge."},{value:"Inspection failure occurred."},{value:"There was a non-inspection situation."}],hint:"Use a finite clause with a visible actor."},
{question:"Which nominalization creates a useful topic chain?",answer:"The team evaluated the pilot. This evaluation revealed two risks.",options:[{value:"The team evaluated the pilot. This evaluation revealed two risks."},{value:"The team evaluated the pilot. This table revealed two risks."},{value:"Evaluation team pilot risks did."}],hint:"The noun refers back to the earlier process."},
{question:"Unpack “the delayed implementation of the policy.”",answer:"The agency implemented the policy late.",options:[{value:"The agency implemented the policy late."},{value:"The policy delayed the agency automatically."},{value:"Implementation was implementation."}],hint:"Restore actor, action and time."},
{question:"Which version appropriately discusses a general concept?",answer:"Reliable access depends on the fair distribution of resources.",options:[{value:"Reliable access depends on the fair distribution of resources."},{value:"People distribute stuff and access maybe."},{value:"Distribution access reliability resource noun stack."}],hint:"Abstract nouns are useful when the text analyzes a general relationship."},
{question:"Which phrase avoids an excessive noun stack?",answer:"a plan to improve service quality",options:[{value:"a plan to improve service quality"},{value:"a service quality improvement implementation plan"},{value:"an improving quality service planning implementation"}],hint:"Use a to-infinitive to unpack one process."},
{question:"Which sentence preserves causal caution?",answer:"The reduction in hours may have contributed to lower attendance.",options:[{value:"The reduction in hours may have contributed to lower attendance."},{value:"Hour reduction attendance causation."},{value:"The reduction definitely caused every absence."}],hint:"Keep the modal and limited causal verb visible."}],
context:{title:"Dense and clear policy summaries",intro:"Compare how actors and actions are packaged.",lines:["Dense: The implementation of the access-policy revision followed the completion of the consultation process.","Clearer event account: The agency completed public consultation and then implemented the revised access policy.","Useful abstraction: This implementation marked a significant change in resource distribution, although its effect on service availability remains uncertain."],questions:[{question:"Who is invisible in the dense first sentence?",answer:"The agency or other actor that consulted and implemented",options:[{value:"The agency or other actor that consulted and implemented"},{value:"The access policy itself necessarily"},{value:"No actor could exist"}],hint:"Ask who completed each process."},{question:"What does the clearer version restore?",answer:"The actor and the order of two actions",options:[{value:"The actor and the order of two actions"},{value:"A claim that consultation never happened"},{value:"More abstract nouns"}],hint:"Follow agency, completed and implemented."},{question:"Why is “This implementation” useful in the third sentence?",answer:"It refers back to the known action as a topic for evaluation.",options:[{value:"It refers back to the known action as a topic for evaluation."},{value:"It hides every earlier sentence."},{value:"It changes implementation into a person."}],hint:"The action is already established."},{question:"Which important stance remains visible?",answer:"The effect on availability is still uncertain.",options:[{value:"The effect on availability is still uncertain."},{value:"The policy certainly solved access."},{value:"Distribution did not change."}],hint:"Read although and remains uncertain."}]},
builder:{title:"Build the clear event account",prompt:"Restore the actor and sequence.",answer:"The agency completed consultation and then implemented the revised policy",tiles:["The","agency","completed","consultation","and","then","implemented","the","revised","policy"]},
repairs:[{title:"Restore responsibility",sentence:"A failure to inspect the bridge occurred.",answer:"failure",fix:"The contractor failed to inspect the bridge.",why:"The finite clause names the responsible actor and action.",tokens:[{value:"failure",label:"A failure"},{value:"inspect",label:"to inspect the bridge"},{value:"occurred",label:"occurred"}]},{title:"Unpack the noun stack",sentence:"The service quality improvement implementation plan was delayed.",answer:"implementation",fix:"The plan to improve service quality was delayed.",why:"A to-infinitive makes the intended process easier to parse.",tokens:[{value:"service",label:"The service quality"},{value:"improvement",label:"improvement"},{value:"implementation",label:"implementation"},{value:"plan",label:"plan was delayed"}]},{title:"Use the natural verb",sentence:"We made an evaluation of the pilot yesterday.",answer:"made",fix:"We evaluated the pilot yesterday.",why:"The direct verb is clearer when evaluation is not yet a discourse topic.",tokens:[{value:"we",label:"We"},{value:"made",label:"made"},{value:"evaluation",label:"an evaluation"},{value:"pilot",label:"of the pilot yesterday"}]},{title:"Keep causal stance visible",sentence:"The reduction of hours was the causation of lower attendance.",answer:"causation",fix:"The reduction in hours may have contributed to lower attendance.",why:"The revision uses a natural noun phrase and preserves limited certainty.",tokens:[{value:"reduction",label:"The reduction of hours"},{value:"was",label:"was"},{value:"causation",label:"the causation"},{value:"attendance",label:"of lower attendance"}]}],
fluency:[{prompt:"Nominalize a process, then unpack it.",answer:"The regulator’s approval of the plan. The regulator approved the plan."},{prompt:"Create a lexical chain from evaluate.",answer:"We evaluated the pilot. The evaluation identified two risks. This assessment informed the revision."},{prompt:"Repair a heavy noun stack aloud.",answer:"The customer service access improvement strategy becomes the strategy to improve access to customer service."},{prompt:"Explain when hiding the actor is unacceptable.",answer:"When responsibility, authority or evidence depends on who acted, name the actor in the noun phrase or use a finite clause."}],
communicate:{title:"The density editor",setup:"Edit a fictional policy paragraph twice: once for a specialist summary and once for a public explanation.",roles:["Analyst: decide which processes should become concepts and which actors must remain visible.","Public editor: unpack dense groups, restore time and responsibility, and preserve necessary technical terms."],prompts:["What action is hidden in this noun?","Who performed it?","Is the process already known?","Would a verb be clearer?"],success:["Nominalization supports cohesion or abstraction.","Actors and causal stance remain visible where they matter.","No noun stack forces the reader to decode the sentence twice."]},
writing:{title:"Write dense and clear versions",task:"Write a 180-word policy summary, then create a clearer public version of the same facts.",requirements:["Use three justified nominalizations in the specialist version.","Restore actors and finite verbs in the public version.","Preserve modality, sequence and causal strength across both."],model:"Specialist: Implementation of the revised policy followed completion of the consultation and approval of the funding allocation. This implementation may contribute to improved service availability. Public: The agency consulted residents, approved the funding, and then implemented the revised policy. The change may help make services more available, but the agency has not yet measured its full effect. Both versions preserve the sequence and cautious causal claim; the second makes the actor and actions easier to see."},
reflect:{canDo:["Form and interpret common nominalizations.","Use nominalization for cohesion and abstraction.","Unpack dense prose to restore actors, actions and stance."],nextUse:"Choose one dense paragraph and produce an actor-visible version without removing necessary technical meaning."}
};
