---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Phrasal verbs in formal and informal contexts · C1 Vocabulary","slug":"phrasal-verbs-in-formal-and-informal-contexts","level":"C1","topic":"Phrasal verbs in formal and informal contexts","category":"Vocabulary & Topics","contentType":"vocabulary","status":"ready","description":"Choose between phrasal verbs and single-word alternatives according to meaning, syntax, register and the communication norms of each context.","sequence":19,"prerequisites":["c1/idiomatic-language-and-fixed-expressions","b2/phrasal-verbs"],"related":["c1/register-tone-and-formality","c1/collocation-and-lexical-precision"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Phrasal-verb syntax, polysemy, object placement, register, lexical alternatives, genre editing, repair, spoken stress, discussion, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Choose phrasal or single-word verbs for exact meaning and genre, preserve object patterns and connotation, and avoid the false rule that formal writing must eliminate every phrasal verb.",focus:"multiword-verb syntax, meaning and register",tags:["register shift","object placement","polysemy"],
retrieval:[{prompt:"Place the pronoun with rule out.",answer:"rule it out, not rule out it"},{prompt:"Replace look into in a formal report.",answer:"investigate or examine"},{prompt:"Explain why carry out may remain in formal writing.",answer:"Carry out is conventional and neutral in combinations such as carry out research or a test."}],
notice:{title:"Register is not a phrasal-versus-Latin switch",setup:"Compare an internal update and a formal report.",samples:["We looked into the delay and found out that the carrier had backed out.","We investigated the delay and determined that the carrier had withdrawn.","The team carried out a full review and set out three recommendations."],questions:["Which version sounds more conversational?","Do all single-word replacements preserve the same tone and meaning?","Why do carried out and set out fit the formal final sentence?"],check:{question:"Which principle is most accurate?",answer:"Choose the verb whose meaning, syntax and register fit the context; many phrasal verbs are neutral or formal.",options:[{value:"Choose the verb whose meaning, syntax and register fit the context; many phrasal verbs are neutral or formal."},{value:"Replace every phrasal verb in all formal writing."},{value:"Phrasal verbs have no grammar patterns."}],hint:"Consider carry out research and set out recommendations."}},
discover:{principle:"A register shift is a meaning-preserving option only when the alternative matches sense, pattern and stance. Learn each multiword verb with transitivity, separability, typical objects and genre.",formRows:[{label:"separable","form":"verb + noun + particle / verb + particle + noun; pronoun middle",example:"rule the option out / rule it out"},{label:"inseparable","form":"verb + particle/preposition + object",example:"look into the complaint"},{label:"intransitive","form":"verb + particle; no object",example:"The agreement fell through."},{label:"three-part","form":"verb + particle + preposition + object",example:"follow through on the promise"}],meaningRows:[{choice:"conversation",use:"common phrasal verb gives direct natural action",example:"find out what happened"},{choice:"neutral professional",use:"phrasal verb is conventional in the domain",example:"carry out an audit"},{choice:"formal precision",use:"single-word verb names the exact relation",example:"determine the cause; discontinue the service"},{choice:"stance difference",use:"alternatives add attitude or process",example:"back out suggests withdrawal from commitment"}],pronunciation:"Verb-particle combinations often stress the particle: back OUT, rule OUT. Verb plus preposition patterns usually stress the content word after the preposition: look into the COMPLAINT.",errors:[{wrong:"Formal writing cannot use phrasal verbs.",correct:"Evaluate each item; carry out, set out and follow up are common in professional genres.",why:"Register belongs to the whole combination and context."},{wrong:"We ruled out it.",correct:"We ruled it out.",why:"A pronoun goes between a separable verb and particle."},{wrong:"Withdraw is always an exact replacement for back out.",correct:"Back out often adds the idea of abandoning an agreement or commitment.",why:"Near-equivalents can differ in connotation and typical objects."}]},
reference:{title:"Meaning-preserving shifts",intro:"Check syntax and nuance before replacing.",groups:[{heading:"Often conversational",items:["find out → discover/determine","put off → postpone","come up with → devise/propose"]},{heading:"Neutral across genres",items:["carry out research","set out criteria","follow up on a request","point out a limitation"]},{heading:"Process difference",items:["phase out → discontinue gradually","back out → withdraw from commitment","bring about → cause/produce"]}]},
build:[
{question:"Which formal alternative preserves investigate?",answer:"We investigated the complaint.",options:[{value:"We investigated the complaint."},{value:"We invented the complaint."},{value:"We canceled the complaint."}],hint:"Look into means investigate here."},
{question:"Replace the pronoun correctly with rule out.",answer:"We ruled it out.",options:[{value:"We ruled it out."},{value:"We ruled out it."},{value:"We it ruled out."}],hint:"Rule out is separable."},
{question:"Which phrasal verb is natural in a formal research report?",answer:"The team carried out a controlled trial.",options:[{value:"The team carried out a controlled trial."},{value:"The team messed around a trial."},{value:"The team chilled out the trial."}],hint:"Carry out is conventional in formal research language."},
{question:"Which verb emphasizes gradual discontinuation?",answer:"phase out",options:[{value:"phase out"},{value:"throw away"},{value:"fall through"}],hint:"Phase out names a gradual process."},
{question:"The agreement failed to happen. Which intransitive verb fits?",answer:"The agreement fell through.",options:[{value:"The agreement fell through."},{value:"The agreement fell it through."},{value:"The agreement carried out."}],hint:"Fall through takes no object in this meaning."},
{question:"Which formal verb best replaces put off a meeting?",answer:"postpone",options:[{value:"postpone"},{value:"dispose"},{value:"oppose"}],hint:"Preserve the meaning delay until later."},
{question:"Which phrase accurately names completing a commitment?",answer:"follow through on the promise",options:[{value:"follow through on the promise"},{value:"follow the promise through it"},{value:"fall through the promise"}],hint:"Use the three-part verb plus object."},
{question:"Which sentence avoids a needless register change?",answer:"The report points out two important limitations.",options:[{value:"The report points out two important limitations."},{value:"The report gestures outwardly limitations."},{value:"The report performs an indication externalization."}],hint:"Point out is clear and conventional in reports."}],
context:{title:"Internal update and public report",intro:"Track which shifts preserve meaning and which add nuance.",lines:["Internal update: We looked into the outage, found out what triggered it, and came up with a temporary workaround.","Public report: We investigated the outage, determined its trigger, and developed a temporary workaround.","Both versions: The team carried out additional tests, ruled out a hardware fault, and set out three actions to prevent recurrence."],questions:[{question:"What replaces looked into?",answer:"investigated",options:[{value:"investigated"},{value:"triggered"},{value:"prevented"}],hint:"Compare the first actions."},{question:"What nuance does found out share with determined here?",answer:"Both mean reaching or discovering the answer.",options:[{value:"Both mean reaching or discovering the answer."},{value:"Both mean delaying the outage."},{value:"Both mean abandoning a contract."}],hint:"The object is the trigger."},{question:"Why do carried out and set out remain?",answer:"They are conventional neutral professional combinations.",options:[{value:"They are conventional neutral professional combinations."},{value:"The writer forgot the formal rule."},{value:"They have no alternatives in English."}],hint:"Formality does not ban every particle."},{question:"What does ruled out mean?",answer:"The team eliminated a hardware fault as an explanation.",options:[{value:"The team eliminated a hardware fault as an explanation."},{value:"The team repaired the hardware."},{value:"The fault abandoned a contract."}],hint:"Interpret option elimination."}]},
builder:{title:"Build the formal investigation summary",prompt:"Use precise single-word verbs.",answer:"We investigated the outage and determined its cause",tiles:["We","investigated","the","outage","and","determined","its","cause"]},
repairs:[{title:"Repair pronoun placement",sentence:"We ruled out it after testing.",answer:"out",fix:"We ruled it out after testing.",why:"The pronoun belongs between rule and out.",tokens:[{value:"we",label:"We"},{value:"ruled",label:"ruled"},{value:"out",label:"out"},{value:"it",label:"it"},{value:"testing",label:"after testing"}]},{title:"Repair inseparable order",sentence:"We looked the complaint into.",answer:"complaint",fix:"We looked into the complaint.",why:"Look into is inseparable.",tokens:[{value:"we",label:"We"},{value:"looked",label:"looked"},{value:"complaint",label:"the complaint"},{value:"into",label:"into"}]},{title:"Repair intransitive use",sentence:"The agreement fell through it.",answer:"it",fix:"The agreement fell through.",why:"Fall through takes no object when it means fail to happen.",tokens:[{value:"agreement",label:"The agreement"},{value:"fell",label:"fell through"},{value:"it",label:"it"}]},{title:"Repair false equivalence",sentence:"The company phased out the service overnight.",answer:"overnight",fix:"The company discontinued the service overnight. / The company phased out the service over six months.",why:"Phase out implies gradual discontinuation.",tokens:[{value:"company",label:"The company"},{value:"phased",label:"phased out"},{value:"service",label:"the service"},{value:"overnight",label:"overnight"}]}],
fluency:[{prompt:"Shift an internal update into a formal report.",answer:"We looked into it and found out the cause becomes We investigated it and determined the cause."},{prompt:"Defend one phrasal verb in formal writing.",answer:"Carry out an audit is a conventional neutral collocation, so replacing it is unnecessary."},{prompt:"Contrast phase out and discontinue.",answer:"Phase out foregrounds gradual removal; discontinue names stopping without specifying the process."},{prompt:"Self-correct object placement.",answer:"We ruled out it, correction, we ruled it out."}],
communicate:{title:"The register-switch briefing",setup:"Deliver the same incident update to a colleague and to a formal review panel.",roles:["Speaker: change only verbs whose register or precision requires it and preserve all facts.","Editor: check object pattern, sense and connotation for every shift."],prompts:["Is this verb separable?","Does the alternative preserve process?","Is the phrasal verb already neutral?","What does the audience gain from the shift?"],success:["Grammar patterns remain accurate.","Register shifts preserve factual meaning.","Neutral professional phrasal verbs are retained when natural."]},
writing:{title:"Write two incident versions",task:"Write a 100-word internal update and a 150-word formal report about the same outage.",requirements:["Use at least six multiword verbs in the internal version.","Make four justified lexical shifts in the report.","Retain two professional phrasal verbs and explain why."],model:"Internal: We looked into the outage, found out what triggered it, came up with a workaround, and carried out extra tests. We ruled out hardware and followed up with the provider. Formal: We investigated the outage, determined its trigger, and developed a temporary workaround. The team carried out additional tests, eliminated hardware as a cause, and followed up with the network provider. Carry out and follow up remain because both are conventional in professional incident reporting."},
reflect:{canDo:["Control separable, inseparable, intransitive and three-part verbs.","Shift register without losing meaning or process nuance.","Recognize professional phrasal verbs that need no replacement."],nextUse:"Take one email and one report, compare their multiword verbs, and justify every retained or replaced item."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
