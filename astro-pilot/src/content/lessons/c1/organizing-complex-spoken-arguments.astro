import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Organizing complex spoken arguments · C1 Vocabulary","slug":"organizing-complex-spoken-arguments","level":"C1","topic":"Organizing complex spoken arguments","category":"Vocabulary & Topics","contentType":"vocabulary","status":"ready","description":"Sustain multi-stage spoken arguments with signposting, controlled digression, reformulation, challenge responses and discourse-level intonation.","sequence":17,"prerequisites":["c1/concession-contrast-and-counterargument","c1/referencing-and-avoiding-repetition"],"related":["c1/collocation-and-lexical-precision","c1/idiomatic-language-and-fixed-expressions"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Claim architecture, signposting, evidence, concession, digression control, reformulation, challenge response, discourse intonation, repair, presentation, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Deliver and defend a three-minute argument whose claim, reasons, evidence, concession and conclusion remain easy to follow even after interruption or self-correction.",focus:"spoken argument architecture and signposting",tags:["turn management","reformulation","discourse intonation"],
retrieval:[{prompt:"Give a claim, reason and example in three sentences.",answer:"The city should extend library hours. Many adults can visit only after work. For example, evening attendance doubled during the pilot."},{prompt:"Concede a valid concern and return to your claim.",answer:"Cost is a valid concern. Even so, a limited weekend trial would test demand without committing to permanent expansion."},{prompt:"Repair yourself without restarting.",answer:"The result proves, or rather suggests, that the change may help."}],
notice:{title:"Listeners need a route, not a pile of good sentences",setup:"A speaker answers whether a city should extend library hours.",samples:["My main claim is that the city should run a six-month evening pilot.","There are two reasons. First, current hours exclude many workers. Second, pilot attendance suggests real demand.","A fair concern is cost. I will return to that after clarifying what the pilot would include."],questions:["Where is the conclusion stated?","How does the speaker preview organization?","What phrase controls the temporary digression?"],check:{question:"What does “I will return to that” do?",answer:"It acknowledges a relevant point while postponing it and promising a clear return.",options:[{value:"It acknowledges a relevant point while postponing it and promising a clear return."},{value:"It permanently dismisses the concern."},{value:"It proves the concern is false."}],hint:"A controlled digression needs an explicit return path."}},
discover:{principle:"A complex spoken argument needs visible architecture, manageable information units and recovery language. Signpost the route, state relations, respond to challenges and reformulate locally instead of restarting the whole turn.",formRows:[{label:"frame","form":"My main claim is… / I’ll make two points",example:"I’ll begin with access, then turn to cost."},{label:"develop","form":"The first reason… / For example… / This matters because…",example:"This matters because current hours exclude workers."},{label:"concede and return","form":"A fair concern is… Even so…",example:"Cost matters. Even so, a pilot limits risk."},{label:"repair","form":"or rather / more precisely / let me rephrase",example:"The policy caused, or rather contributed to, the change."}],meaningRows:[{choice:"signpost",use:"the listener sees the structure",example:"Turning to the second point…"},{choice:"evidence link",use:"the listener knows why evidence matters",example:"This supports the claim because…"},{choice:"digression control",use:"a side point is bounded",example:"A brief point about timing, then I’ll return to cost."},{choice:"challenge response",use:"the speaker answers and integrates interruption",example:"That is a fair question. The short answer is…"}],pronunciation:"Use a low fall to complete major points, a fall-rise to keep a concession open, and brief pauses at signposts. Stress the claim words and evidence contrast, not every connector.",errors:[{wrong:"First… second… anyway… another thing…",correct:"Preview the route and state how each point supports the claim.",why:"Enumeration without logical relations is not an argument."},{wrong:"An interruption means restart from the beginning.",correct:"Answer briefly, mark where you were, and resume the relevant point.",why:"Recovery language preserves the listener’s map."},{wrong:"Fluent speakers never self-correct.",correct:"Precise speakers reformulate efficiently when wording overstates or obscures meaning.",why:"Controlled repair is a C1 skill."}]},
reference:{title:"Spoken argument route",intro:"Keep one visible line from claim to conclusion.",groups:[{heading:"Open",items:["My main claim is…","I’ll make two points…"]},{heading:"Develop",items:["This matters because…","For example…","The implication is…"]},{heading:"Manage",items:["I’ll return to that…","More precisely…","That is a fair question…"]},{heading:"Close",items:["Taken together…","For these reasons…"]}]},
build:[
{question:"Which opening gives a clear route?",answer:"I’ll argue for a six-month pilot using evidence about access and cost.",options:[{value:"I’ll argue for a six-month pilot using evidence about access and cost."},{value:"There are many things and stuff."},{value:"Anyway, libraries."}],hint:"State claim, scope and route."},
{question:"Which phrase links evidence to relevance?",answer:"This matters because current hours exclude many workers.",options:[{value:"This matters because current hours exclude many workers."},{value:"This is a number."},{value:"Evidence exists, next topic."}],hint:"Explain why the evidence supports the claim."},
{question:"Which phrase controls a digression?",answer:"A brief point about timing, then I’ll return to cost.",options:[{value:"A brief point about timing, then I’ll return to cost."},{value:"I forgot the topic, so here is another one."},{value:"Timing cancels everything."}],hint:"Bound the side point and promise a return."},
{question:"Which reformulation corrects overclaiming?",answer:"The pilot proves, or rather suggests, that demand exists.",options:[{value:"The pilot proves, or rather suggests, that demand exists."},{value:"The pilot proves suggests demand."},{value:"I will repeat proves more loudly."}],hint:"Use or rather to replace the earlier wording."},
{question:"Which response handles a challenge constructively?",answer:"That is a fair question. The current data cover only two sites.",options:[{value:"That is a fair question. The current data cover only two sites."},{value:"Do not interrupt me."},{value:"Your question proves my claim."}],hint:"Acknowledge and answer directly."},
{question:"Which concession returns to the main claim?",answer:"Cost is a real concern. Even so, a limited pilot controls the risk.",options:[{value:"Cost is a real concern. Even so, a limited pilot controls the risk."},{value:"Cost exists, so no trial can occur."},{value:"Cost is irrelevant because I say so."}],hint:"Accept the concern and state what remains justified."},
{question:"Which signpost changes subtopic?",answer:"Turning to implementation, the pilot could begin in May.",options:[{value:"Turning to implementation, the pilot could begin in May."},{value:"Implementation however because."},{value:"May turns implementation itself."}],hint:"Announce the new section."},
{question:"Which closing synthesizes rather than repeats?",answer:"Taken together, the access evidence and limited cost justify a monitored pilot.",options:[{value:"Taken together, the access evidence and limited cost justify a monitored pilot."},{value:"I said pilot many times."},{value:"In conclusion, unrelated issue."}],hint:"Combine the argument’s main supports into the final judgment."}],
context:{title:"A three-minute policy answer",intro:"Map each sentence to its discourse job.",lines:["My main claim is that the city should run a six-month evening-library pilot. I’ll make two points: access and financial risk.","First, current hours exclude many shift workers. During a four-week test, evening attendance doubled. This matters because it shows demand among people the existing schedule does not serve.","A fair concern is cost. The test covered only one branch, so it cannot establish citywide demand. Even so, a limited two-branch pilot with monthly review would control risk. Taken together, the access evidence and reversible design justify testing rather than permanent expansion."],questions:[{question:"What route is previewed?",answer:"Access followed by financial risk",options:[{value:"Access followed by financial risk"},{value:"Staff names then weather"},{value:"A permanent decision only"}],hint:"Read the opening frame."},{question:"How is the attendance figure connected to the claim?",answer:"It shows demand among people excluded by current hours.",options:[{value:"It shows demand among people excluded by current hours."},{value:"It proves every branch will double attendance."},{value:"It shows cost is zero."}],hint:"Read This matters because."},{question:"What limitation is conceded?",answer:"The test covered only one branch.",options:[{value:"The test covered only one branch."},{value:"No evening attendance occurred."},{value:"The pilot cannot be stopped."}],hint:"Find the scope limit."},{question:"How is the concern integrated?",answer:"The proposal becomes a limited reversible pilot with monthly review.",options:[{value:"The proposal becomes a limited reversible pilot with monthly review."},{value:"The concern is ignored."},{value:"The city expands permanently."}],hint:"The answer changes design, not only wording."}]},
builder:{title:"Build the synthesis",prompt:"Combine evidence and risk in one conclusion.",answer:"Taken together the evidence and limited risk justify a monitored pilot",tiles:["Taken","together","the","evidence","and","limited","risk","justify","a","monitored","pilot"]},
repairs:[{title:"Replace empty enumeration",sentence:"First, access. Second, cost. Third, things.",answer:"things",fix:"I’ll make two points: how the pilot improves access and how its design limits cost.",why:"The revision previews meaningful relations.",tokens:[{value:"first",label:"First, access"},{value:"second",label:"Second, cost"},{value:"things",label:"Third, things"}]},{title:"Repair overclaiming",sentence:"The one-site test proves citywide demand.",answer:"proves",fix:"The one-site test suggests local demand but does not establish a citywide pattern.",why:"The reformulation matches scope.",tokens:[{value:"test",label:"The one-site test"},{value:"proves",label:"proves"},{value:"citywide",label:"citywide demand"}]},{title:"Control the digression",sentence:"About cost, but first let me discuss three unrelated policies.",answer:"unrelated",fix:"A brief point about timing, then I’ll return to cost.",why:"A useful digression is bounded and connected.",tokens:[{value:"cost",label:"About cost"},{value:"first",label:"but first"},{value:"unrelated",label:"three unrelated policies"}]},{title:"Resume after challenge",sentence:"That question made me forget everything, so I will start again.",answer:"start",fix:"That is a fair question. The data cover two sites. Returning to the cost point, monthly reviews would limit risk.",why:"Answer, mark the return and continue.",tokens:[{value:"question",label:"That question"},{value:"forget",label:"made me forget everything"},{value:"start",label:"so I will start again"}]}],
fluency:[{prompt:"Preview a two-point argument in one sentence.",answer:"I’ll argue for a limited pilot using evidence about access and a plan to control cost."},{prompt:"Answer an interruption and resume.",answer:"That is a fair question. The sample covers two sites. Returning to my second point, the proposal remains reversible."},{prompt:"Reformulate an overstrong causal claim.",answer:"The schedule caused, or more precisely may have contributed to, the attendance increase."},{prompt:"Close by synthesis.",answer:"Taken together, the measured demand, limited scope and review points justify a monitored trial."}],
communicate:{title:"The three-minute defense",setup:"Deliver a timed argument, accept two interruptions, make one self-correction and finish without losing the route.",roles:["Speaker: frame, develop, concede, respond, resume and synthesize.","Challenger: interrupt with one evidence question and one counterargument, then report whether the route remained clear."],prompts:["My main claim is…","This matters because…","That is a fair question…","Returning to…","Taken together…"],success:["The listener can reconstruct the argument map.","Challenges are answered without derailment.","Stress, pausing and reformulation support meaning."]},
writing:{title:"Turn the spoken map into notes",task:"Create 180 to 220 words of speaker notes for a three-minute argument.",requirements:["Include claim, two reasons, evidence, concession and synthesis.","Mark one controlled digression and return.","Write phrases for oral delivery, not a dense essay script."],model:"Claim: run a six-month evening-library pilot. Route: access, then cost. Access: current hours exclude shift workers; evening attendance doubled in the test. Why it matters: demand among people not served now. Brief timing point: winter demand may differ; return to cost. Cost concern is valid; one branch cannot establish citywide demand. Response: two-branch reversible pilot, monthly review. Synthesis: measured demand plus controlled risk justify testing, not permanent expansion."},
reflect:{canDo:["Frame and sustain a multi-stage spoken argument.","Handle interruption, digression and self-correction without losing the route.","Use discourse-level stress and pausing to signal structure."],nextUse:"Record a three-minute argument, draw its map afterward, and revise any point whose role is not immediately clear."}
};
