---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import StructuredLesson from "../../../components/lesson/StructuredLesson.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Inversion after negative expressions · C1 Grammar","slug":"inversion-after-negative-expressions","level":"C1","topic":"Inversion after negative expressions","category":"Grammar","contentType":"grammar","status":"ready","description":"Use negative and restrictive fronting with controlled subject-auxiliary inversion to create formal emphasis without distorting meaning.","sequence":6,"prerequisites":["c1/mixed-and-implied-conditionals","b2/advanced-discourse-markers"],"related":["c1/advanced-emphasis-and-cleft-structures","c1/register-tone-and-formality"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Negative and restrictive fronting, auxiliary support, paired structures, meaning limits, formal spoken emphasis, contextual reading, repair, speech, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Use negative and restrictive fronting accurately for formal emphasis, choosing the correct auxiliary and preserving the scope and time of the original statement.",focus:"negative fronting and subject-auxiliary inversion",tags:["formal emphasis","auxiliary support","scope"],
retrieval:[{prompt:"Turn a statement into a question: She understood the risk.",answer:"Did she understand the risk? The auxiliary did carries past time and the main verb returns to its base form."},{prompt:"Front this time boundary without inversion: We acted only after the audit.",answer:"Only after the audit did we act."},{prompt:"Explain the ordinary order in I had never seen such a result.",answer:"Subject + auxiliary + negative adverb + main verb: I had never seen."}],
notice:{title:"Moving the limit changes the grammar",setup:"Compare ordinary and fronted versions of the same claims.",samples:["We had never encountered that error. / Never had we encountered that error.","The team understood the scale only after the second test. / Only after the second test did the team understand the scale.","The files must not leave the room under any circumstances. / Under no circumstances must the files leave the room."],questions:["What moves before the subject in each fronted version?","Which auxiliary appears before the subject?","Does the fronted version change the factual time or mainly add formal emphasis?"],check:{question:"Why does the sentence use “did the team understand,” not “did the team understood”?",answer:"Did carries past time, so understand returns to its base form.",options:[{value:"Did carries past time, so understand returns to its base form."},{value:"Every fronted sentence uses a past participle."},{value:"Understand cannot appear after a subject."}],hint:"Apply the same one-past-marker principle used in questions."}},
discover:{principle:"When a negative or strongly restrictive expression is fronted, the finite auxiliary normally comes before the subject. If no auxiliary exists, add do, does or did. Keep the original time, voice and meaning scope.",formRows:[{label:"existing auxiliary","form":"negative phrase + auxiliary + subject + main verb",example:"Never have I seen such demand."},{label:"do support","form":"negative phrase + do/does/did + subject + base verb",example:"Rarely does the system fail."},{label:"only + boundary","form":"only after/when/by + clause/phrase + inversion",example:"Only after we tested it did we understand."},{label:"paired sequence","form":"no sooner + had + subject + participle + than",example:"No sooner had we arrived than the alarm sounded."}],meaningRows:[{choice:"rare frequency","use":"never, rarely, seldom or hardly ever is emphasized",example:"Rarely do clients request that option."},{choice:"strict prohibition","use":"under no circumstances or on no account sets a firm limit",example:"Under no circumstances should you share the code."},{choice:"late realization","use":"only later/then/after marks the boundary for understanding or action",example:"Only then did I notice the error."},{choice:"immediate sequence","use":"hardly/scarcely/no sooner links two close past events",example:"Hardly had we begun when the power failed."}],pronunciation:"Fronted expressions often form their own tone unit: NEVER | had we SEEN such demand. Stress the restrictive expression and the new information, but avoid theatrical stress on every word.",errors:[{wrong:"Never I have seen that.",correct:"Never have I seen that.",why:"The auxiliary moves before the subject after fronted never."},{wrong:"Only then did she realized the problem.",correct:"Only then did she realize the problem.",why:"Did carries past time, so the main verb is base form."},{wrong:"Only the manager approved the change did we continue.",correct:"Only after the manager approved the change did we continue.",why:"Only modifying a subject does not trigger inversion; a fronted restrictive adverbial does."}]},
reference:{title:"High-value triggers",intro:"Use these forms selectively. Ordinary order is usually more natural in everyday conversation.",groups:[{heading:"Frequency",items:["never","rarely","seldom","hardly ever"]},{heading:"Restriction",items:["under no circumstances","on no account","at no point","only then/later/after"]},{heading:"Sequence",items:["hardly…when","scarcely…when","no sooner…than"]}]},
build:[
{question:"Front “never” in: I have never seen a clearer result.",answer:"Never have I seen a clearer result.",options:[{value:"Never have I seen a clearer result."},{value:"Never I have seen a clearer result."},{value:"Never did I have saw a clearer result."}],hint:"The existing auxiliary have moves before I."},
{question:"Front “rarely” in: The system fails during normal use.",answer:"Rarely does the system fail during normal use.",options:[{value:"Rarely does the system fail during normal use."},{value:"Rarely the system fails during normal use."},{value:"Rarely does the system fails during normal use."}],hint:"Add does and return fail to base form."},
{question:"Which sentence emphasizes a strict prohibition?",answer:"Under no circumstances may visitors enter the archive alone.",options:[{value:"Under no circumstances may visitors enter the archive alone."},{value:"Under no circumstances visitors may enter alone."},{value:"Visitors under enter no circumstances."}],hint:"Move the modal before the subject."},
{question:"The team understood the risk after the final test. Which fronted form fits?",answer:"Only after the final test did the team understand the risk.",options:[{value:"Only after the final test did the team understand the risk."},{value:"Only after the final test the team understood the risk."},{value:"Only after did the team understood the risk."}],hint:"The fronted boundary triggers did plus base verb."},
{question:"Which paired structure correctly shows two immediate past events?",answer:"No sooner had we arrived than the alarm sounded.",options:[{value:"No sooner had we arrived than the alarm sounded."},{value:"No sooner we arrived when the alarm had sounded."},{value:"No sooner did we arrived than the alarm sounds."}],hint:"Use past perfect inversion with no sooner and than."},
{question:"Which sentence correctly uses hardly?",answer:"Hardly had the meeting begun when the connection failed.",options:[{value:"Hardly had the meeting begun when the connection failed."},{value:"Hardly the meeting had begun than the connection failed."},{value:"Hardly did the meeting began when the connection fails."}],hint:"Hardly pairs with when and an inverted past perfect."},
{question:"Which use of only does not require inversion?",answer:"Only Maya understood the warning.",options:[{value:"Only Maya understood the warning."},{value:"Only then Maya understood the warning."},{value:"Only after the call Maya did understand."}],hint:"Only directly modifies the subject Maya."},
{question:"Front “at no point” while preserving passive voice: The data were not exposed.",answer:"At no point were the data exposed.",options:[{value:"At no point were the data exposed."},{value:"At no point did the data were exposed."},{value:"At no point the data exposed."}],hint:"The existing passive auxiliary were moves before the subject."}],
context:{title:"A formal compliance statement",intro:"Notice how inversion emphasizes limits without changing the timeline.",lines:["At no point were customer passwords stored in the test environment. Under no circumstances could external contractors access the production database.","Only after the security team completed a second review did the company authorize the release. Rarely has a routine update received this level of scrutiny.","No sooner had the release begun than monitoring systems detected an unrelated network fault. Only then did engineers realize that two separate incidents were occurring."],questions:[{question:"What was never stored in the test environment?",answer:"Customer passwords",options:[{value:"Customer passwords"},{value:"The production database"},{value:"An unrelated network fault"}],hint:"Read the first fronted limit."},{question:"What had to happen before authorization?",answer:"The security team had to complete a second review.",options:[{value:"The security team had to complete a second review."},{value:"Contractors had to access production."},{value:"Monitoring had to be disabled."}],hint:"Only after marks the necessary boundary."},{question:"What does “Rarely has” communicate?",answer:"This amount of scrutiny is unusual.",options:[{value:"This amount of scrutiny is unusual."},{value:"The review never happened."},{value:"Routine updates are illegal."}],hint:"Rarely marks low frequency, not impossibility."},{question:"Which two events happened in immediate sequence?",answer:"The release began, and monitoring detected a network fault.",options:[{value:"The release began, and monitoring detected a network fault."},{value:"Passwords were stored, and contractors entered."},{value:"The second review and first test happened next year."}],hint:"No sooner…than links the pair."}]},
builder:{title:"Build the delayed realization",prompt:"Emphasize the boundary after which the team understood.",answer:"Only after the second test did the team understand the risk",tiles:["Only","after","the","second","test","did","the","team","understand","the","risk"]},
repairs:[{title:"Move the auxiliary",sentence:"Never I have experienced such demand.",answer:"I",fix:"Never have I experienced such demand.",why:"Have must precede the subject after fronted never.",tokens:[{value:"never",label:"Never"},{value:"i",label:"I"},{value:"have",label:"have experienced"},{value:"demand",label:"such demand"}]},{title:"Restore the base verb",sentence:"Only then did we understood the scale.",answer:"understood",fix:"Only then did we understand the scale.",why:"Did carries past time.",tokens:[{value:"only",label:"Only then"},{value:"did",label:"did"},{value:"we",label:"we"},{value:"understood",label:"understood"},{value:"scale",label:"the scale"}]},{title:"Keep passive voice",sentence:"At no point did the files were removed.",answer:"did",fix:"At no point were the files removed.",why:"The passive auxiliary were itself inverts with the subject.",tokens:[{value:"point",label:"At no point"},{value:"did",label:"did"},{value:"files",label:"the files"},{value:"were",label:"were removed"}]},{title:"Do not invert after subject-only",sentence:"Only Maya did understand the warning first.",answer:"did",fix:"Only Maya understood the warning first.",why:"Only modifies the subject, so ordinary statement order remains.",tokens:[{value:"only",label:"Only Maya"},{value:"did",label:"did"},{value:"understand",label:"understand"},{value:"warning",label:"the warning first"}]}],
fluency:[{prompt:"Reformulate a neutral statement with never, then explain the emphasis.",answer:"We had never faced that problem becomes Never had we faced that problem. The fronted version sounds formal and strongly marks novelty."},{prompt:"Use only after to mark a delayed realization.",answer:"Only after we compared the logs did we realize that the incidents were unrelated."},{prompt:"Link two immediate events with no sooner and with ordinary order.",answer:"No sooner had I sat down than the phone rang. Ordinary: The phone rang as soon as I sat down."},{prompt:"Correct an unnecessary inversion after only plus subject.",answer:"Only the director did approve it becomes Only the director approved it."}],
communicate:{title:"The formal emphasis briefing",setup:"Deliver a compliance or incident briefing using four different fronted triggers, then restate each point in ordinary order.",roles:["Briefing lead: use inversion selectively to emphasize prohibition, rarity, sequence and late realization.","Editor: verify every auxiliary, base form and meaning scope, and ask whether ordinary order would sound more natural."],prompts:["At no point…","Only after…","Rarely…","No sooner…than…"],success:["Every trigger licenses inversion.","Time, voice and polarity remain unchanged.","Emphasis supports the message instead of making every sentence dramatic."]},
writing:{title:"Write a formal incident summary",task:"Write 170 to 210 words using exactly four fronted negative or restrictive expressions.",requirements:["Include one do-support form and one existing-auxiliary form.","Use one only boundary and one paired sequence structure.","Rewrite the paragraph in ordinary order to confirm that the facts stay unchanged."],model:"At no point were customer records exposed. Only after the monitoring team compared both alerts did it recognize that two separate faults were occurring. Rarely does a routine update require a full incident response, but the timing made the first alert appear more serious. No sooner had engineers restored the application than the network provider reported a regional outage. In ordinary order, the same facts are that records were never exposed, recognition came after comparison, this response level is unusual, and the provider reported the outage immediately after restoration."},
reflect:{canDo:["Identify fronted expressions that trigger inversion.","Choose and position the correct auxiliary while preserving tense and voice.","Use formal emphasis selectively and restate it in ordinary order."],nextUse:"Take four sentences from a formal report, front one suitable negative or restrictive expression in each, and explain whether the stronger emphasis improves the text."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
