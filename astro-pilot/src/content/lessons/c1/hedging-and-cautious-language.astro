---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Hedging and cautious language · C1 Grammar","slug":"hedging-and-cautious-language","level":"C1","topic":"Hedging and cautious language","category":"Grammar","contentType":"grammar","status":"ready","description":"Match the strength of a claim to the available evidence through hedges, boosters, reporting choices and carefully limited generalizations.","sequence":13,"prerequisites":["c1/advanced-modal-meaning-and-stance","c1/register-tone-and-formality","b2/advanced-discourse-markers"],"related":["c1/register-tone-and-formality","c1/concession-contrast-and-counterargument"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Epistemic hedges, scope limits, attribution, boosters, evidence calibration, spoken qualification, contextual reading, repair, discussion, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Match claim strength to evidence by limiting scope, probability and causal commitment, while retaining confident language when the evidence genuinely warrants it.",focus:"evidence strength, scope and attribution",tags:["epistemic stance","limited generalization","responsible claims"],
retrieval:[{prompt:"Soften: The policy caused the improvement.",answer:"The policy may have contributed to the improvement."},{prompt:"Limit a generalization about users.",answer:"In this sample, many users reported… / Some participants appeared to…"},{prompt:"Attribute rather than endorse: The system is unsafe.",answer:"Critics argue that the system is unsafe."}],
notice:{title:"Four claims from one small study",setup:"A pilot involved forty volunteers for two weeks.",samples:["The app improves sleep.","The app may improve sleep.","The results suggest that the app may improve sleep for some users.","Within this small sample, reported sleep improved slightly during the trial."],questions:["Which sentence makes the strongest general causal claim?","Which version limits population, evidence type and degree?","Does cautious wording necessarily mean the result is unimportant?"],check:{question:"Which claim best matches a small short self-report study?",answer:"Within this small sample, reported sleep improved slightly during the trial.",options:[{value:"Within this small sample, reported sleep improved slightly during the trial."},{value:"The app permanently cures sleep problems for everyone."},{value:"No statement can ever be made from a pilot."}],hint:"Name what was measured, for whom, by how much and during what period."}},
discover:{principle:"Hedging calibrates commitment; it should not hide weak thinking. Limit the exact dimension the evidence cannot support: probability, frequency, quantity, population, cause, time or source. Use boosters when evidence and purpose justify strength.",formRows:[{label:"modal/adverb","form":"may, might, could; probably, apparently",example:"The change may reduce waiting times."},{label:"reporting frame","form":"suggests/appears/seems that",example:"The evidence suggests that access improved."},{label:"scope limit","form":"in this sample; for some users; under these conditions",example:"In this sample, most users improved."},{label:"causal limit","form":"contribute to; be associated with; coincide with",example:"Training was associated with higher retention."}],meaningRows:[{choice:"probability",use:"the event or explanation is possible rather than certain",example:"The delay may reflect staff shortages."},{choice:"scope",use:"the claim applies to a limited group, time or condition",example:"Among new users, satisfaction rose."},{choice:"attribution",use:"a view belongs to a source",example:"The authors argue that the policy is effective."},{choice:"booster",use:"strong evidence warrants commitment",example:"The records clearly show that payment was received."}],pronunciation:"In speech, place a hedge early enough for the listener to interpret the whole claim: It MAY be that… Use a brief pause around scope limits: In THIS sample | the effect was small.",errors:[{wrong:"Hedges make every claim polite and accurate.",correct:"A hedge must target the actual uncertainty or scope limit.",why:"Vague caution can still mislead."},{wrong:"The study proves the treatment might help.",correct:"The study suggests that the treatment might help.",why:"Proves conflicts with might and overstates the evidence."},{wrong:"It is definitely possible that costs may perhaps rise.",correct:"Costs may rise.",why:"Stacked hedges make the commitment unclear without adding precision."}]},
reference:{title:"Claim-strength controls",intro:"Identify which dimension needs limitation.",groups:[{heading:"Likelihood",items:["may/might","probably","appears to","is likely to"]},{heading:"Scope",items:["some/many","in this sample","under these conditions","to a limited extent"]},{heading:"Evidence relation",items:["suggest","indicate","be associated with","contribute to"]},{heading:"Strength",items:["clearly","strongly supports","demonstrates","is established by"]}]},
build:[
{question:"A correlation does not establish cause. Which claim fits?",answer:"Higher training time was associated with better retention.",options:[{value:"Higher training time was associated with better retention."},{value:"Training definitely caused every employee to stay."},{value:"Retention created training in all cases."}],hint:"Describe association without direct causation."},
{question:"A result occurred only among new users. Which scope limit fits?",answer:"Among new users, satisfaction increased.",options:[{value:"Among new users, satisfaction increased."},{value:"Satisfaction increased for everyone everywhere."},{value:"New users prove all users are satisfied."}],hint:"Name the population observed."},
{question:"A source holds a disputed view. Which attribution is accurate?",answer:"The authors argue that the measure is effective.",options:[{value:"The authors argue that the measure is effective."},{value:"The measure is unquestionably effective."},{value:"Everyone proved the authors."}],hint:"Keep the view attached to its source."},
{question:"Records conclusively show payment. Which booster is justified?",answer:"The records clearly show that payment was received.",options:[{value:"The records clearly show that payment was received."},{value:"Payment might possibly have perhaps occurred."},{value:"Payment is emotionally likely."}],hint:"Strong direct records warrant clear commitment."},
{question:"Which sentence limits degree?",answer:"The change appears to have had a modest effect.",options:[{value:"The change appears to have had a modest effect."},{value:"The change transformed everything completely."},{value:"The change did effect maybe huge."}],hint:"Modest limits magnitude; appears limits certainty."},
{question:"Which claim fits an observed timing relationship only?",answer:"The decline coincided with the policy change.",options:[{value:"The decline coincided with the policy change."},{value:"The policy change certainly caused the decline."},{value:"The decline caused the policy before it existed."}],hint:"Coincided with states timing without cause."},
{question:"Which revision avoids useless hedge stacking?",answer:"Costs may rise next quarter.",options:[{value:"Costs may rise next quarter."},{value:"It is definitely possible that costs may perhaps rise."},{value:"Costs certainly might definitely perhaps rise."}],hint:"One precise modal is enough."},
{question:"Which sentence accurately names self-reported evidence?",answer:"Participants reported feeling less stressed.",options:[{value:"Participants reported feeling less stressed."},{value:"The study objectively proved their stress disappeared."},{value:"Every person became calm forever."}],hint:"State the measurement source."}],
context:{title:"A responsible pilot summary",intro:"Track every limit placed on the claim.",lines:["In a six-week pilot involving eighty employees, participants reported slightly lower stress and fewer missed deadlines. The results suggest that flexible start times may have helped some teams.","The pilot did not use a control group, and workload also fell during the period. The schedule change therefore cannot be treated as the sole cause of the improvement.","However, attendance records clearly show a 12 percent reduction in late arrivals. A larger controlled study would be needed to determine whether the pattern continues across departments."],questions:[{question:"Which population is covered?",answer:"Eighty employees in a six-week pilot",options:[{value:"Eighty employees in a six-week pilot"},{value:"Every worker in the country"},{value:"Only managers for ten years"}],hint:"Read the opening scope."},{question:"Why is may have helped appropriate?",answer:"Other factors changed and no control group isolated the cause.",options:[{value:"Other factors changed and no control group isolated the cause."},{value:"There was no observed improvement."},{value:"May always means the result is false."}],hint:"Follow the design limitations."},{question:"Which finding supports stronger wording?",answer:"Late arrivals fell by 12 percent in attendance records.",options:[{value:"Late arrivals fell by 12 percent in attendance records."},{value:"All stress disappeared permanently."},{value:"Workload never changed."}],hint:"This result comes from direct records."},{question:"What remains unknown?",answer:"Whether the pattern will continue across departments.",options:[{value:"Whether the pattern will continue across departments."},{value:"Whether eighty employees existed."},{value:"Whether attendance records were mentioned."}],hint:"Read the final research need."}]},
builder:{title:"Build the calibrated causal claim",prompt:"Limit cause and population.",answer:"The change may have helped some teams under these conditions",tiles:["The","change","may","have","helped","some","teams","under","these","conditions"]},
repairs:[{title:"Limit causal certainty",sentence:"The pilot proved that flexible hours caused the improvement.",answer:"proved",fix:"The pilot suggests that flexible hours may have contributed to the improvement.",why:"The design did not isolate a sole cause.",tokens:[{value:"pilot",label:"The pilot"},{value:"proved",label:"proved"},{value:"flexible",label:"flexible hours caused"},{value:"improvement",label:"the improvement"}]},{title:"Name the population",sentence:"Employees prefer flexible hours, according to eighty volunteers.",answer:"Employees",fix:"In this sample, many of the eighty volunteers preferred flexible hours.",why:"The evidence does not cover all employees.",tokens:[{value:"employees",label:"Employees"},{value:"prefer",label:"prefer flexible hours"},{value:"according",label:"according to eighty volunteers"}]},{title:"Remove hedge stacking",sentence:"It is definitely possible that costs might perhaps rise.",answer:"definitely",fix:"Costs might rise.",why:"One modal expresses the intended possibility clearly.",tokens:[{value:"definitely",label:"It is definitely possible"},{value:"costs",label:"that costs"},{value:"might",label:"might"},{value:"perhaps",label:"perhaps rise"}]},{title:"Match reporting verb and stance",sentence:"The report proves that the change may help.",answer:"proves",fix:"The report suggests that the change may help.",why:"Suggests is compatible with the limited modal claim.",tokens:[{value:"report",label:"The report"},{value:"proves",label:"proves"},{value:"change",label:"that the change"},{value:"may",label:"may help"}]}],
fluency:[{prompt:"State a strong claim, then calibrate probability, scope and cause.",answer:"The policy improved performance becomes In this sample, the policy may have contributed to a modest improvement in reported performance."},{prompt:"Attribute a disputed claim.",answer:"Supporters argue that the measure improves access, while the current data remain inconclusive."},{prompt:"Use a justified booster from direct records.",answer:"The payment records clearly show that the full amount was received on Tuesday."},{prompt:"Self-correct a generalization.",answer:"Users prefer the new design. More accurately, most participants in this small trial preferred it."}],
communicate:{title:"The claim calibration panel",setup:"Evaluate a fictional study and negotiate the strongest defensible public claim.",roles:["Researcher: present findings, limits and recommended wording.","Reviewer: challenge population, measurement, cause and certainty, then approve or revise each claim."],prompts:["What was directly measured?","Who and what conditions are covered?","Is the relationship causal or associative?","Where is strong wording justified?"],success:["Every hedge targets a specific limit.","Strong claims cite strong evidence.","The final message remains informative rather than evasive."]},
writing:{title:"Write an evidence-calibrated summary",task:"Write 180 to 220 words about a fictional pilot study.",requirements:["Limit population, time and measurement source.","Use one association claim, one cautious causal possibility and one justified booster.","Name at least two study limitations."],model:"In a six-week pilot involving eighty employees, participants reported slightly lower stress and fewer missed deadlines. The findings suggest that flexible start times may have contributed to improvement for some teams. However, the pilot had no control group, and workload fell during the same period, so the schedule cannot be treated as the sole cause. Attendance records clearly show a 12 percent reduction in late arrivals. A larger controlled study is needed to determine whether this pattern continues across departments and over a longer period."},
reflect:{canDo:["Limit probability, scope, degree, cause and source precisely.","Use boosters when direct evidence warrants them.","Avoid empty hedge stacking and unsupported generalization."],nextUse:"Take three claims from a report and annotate the evidence needed to justify each level of strength."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
