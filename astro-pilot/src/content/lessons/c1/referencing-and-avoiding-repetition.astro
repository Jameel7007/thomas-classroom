import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Referencing and avoiding repetition · C1 Grammar","slug":"referencing-and-avoiding-repetition","level":"C1","topic":"Referencing and avoiding repetition","category":"Grammar","contentType":"grammar","status":"ready","description":"Maintain clear reference across long discourse through substitution, ellipsis, lexical chains and selective repetition that prevents ambiguity.","sequence":16,"prerequisites":["c1/advanced-discourse-markers-and-cohesion","c1/nominalization-and-information-density"],"related":["c1/organizing-complex-spoken-arguments","c1/reduced-relative-clauses"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Pronoun reference, substitution, ellipsis, lexical chains, selective repetition, ambiguity, cohesion, repair, spoken clarification, editing, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"70–85 min",outcome:"Build clear reference chains across extended discourse, using pronouns, substitution, ellipsis and related vocabulary without sacrificing clarity merely to avoid repetition.",focus:"reference chains, substitution and selective repetition",tags:["cohesion","ellipsis","ambiguity repair"],
retrieval:[{prompt:"Replace a repeated noun: I read the report, and the report was useful.",answer:"I read the report, and it was useful."},{prompt:"Substitute a repeated count noun: We need a larger room, not this room.",answer:"We need a larger room, not this one."},{prompt:"Explain why repeating a key noun can be helpful.",answer:"Repeat it when a pronoun could refer to more than one noun or when the topic must be re-established."}],
notice:{title:"Less repetition, but more potential ambiguity",setup:"Compare three versions of a project update.",samples:["The pilot produced a report. The report identified two barriers. The report recommended a longer trial.","The pilot produced a report. It identified two barriers and recommended a longer trial.","The pilot produced a report and a cost estimate. It recommended a longer trial."],questions:["Which repetition is safely removed in the second version?","What can it refer to in the third version?","How could you repair the ambiguous reference?"],check:{question:"Which repair is clearest for the third version?",answer:"The report recommended a longer trial.",options:[{value:"The report recommended a longer trial."},{value:"It recommended one."},{value:"This did that."}],hint:"Repeat the exact head noun when two singular candidates compete."}},
discover:{principle:"Cohesive reference helps the listener recover the intended person, thing, process or proposition. Avoid repetition only when the substitute has one clear antecedent. Selective repetition is a clarity tool, not a stylistic failure.",formRows:[{label:"pronoun reference","form":"noun → it/they/this/that",example:"The report arrived. It was incomplete."},{label:"nominal substitution","form":"one/ones; the former/latter",example:"We chose the smaller one."},{label:"verbal substitution","form":"do so/do it",example:"They revised the plan, and we did so too."},{label:"ellipsis","form":"omit recoverable words",example:"Maya chose Tuesday; Leo, Thursday."}],meaningRows:[{choice:"same entity",use:"a pronoun tracks one accessible referent",example:"The clinic opened. It serves two towns."},{choice:"same type",use:"one/ones replaces a count noun but selects another item",example:"This room is small; we need a larger one."},{choice:"whole proposition",use:"this/that refers to an earlier idea",example:"Costs fell. This supports expansion."},{choice:"lexical chain",use:"related nouns maintain topic with added meaning",example:"policy, measure, change, proposal"}],pronunciation:"In speech, pronouns are light while repeated or clarified nouns receive stress: IT was delayed. The REPORT, not the estimate, recommended expansion.",errors:[{wrong:"Maya told Ana that she was late.",correct:"Maya told Ana, “I’m late.” / Maya told Ana that Ana was late.",why:"She has two possible human antecedents."},{wrong:"Never repeat a noun.",correct:"Repeat a key noun when reference would otherwise be ambiguous.",why:"Variety is less important than recoverability."},{wrong:"The former always means the first noun anywhere before.",correct:"Former/latter should refer to a clear nearby pair and can sound heavy in speech.",why:"Long-distance pairs burden the reader."}]},
reference:{title:"Reference hierarchy",intro:"Choose the shortest form that remains unmistakable.",groups:[{heading:"Shortest",items:["ellipsis","pronoun","one/ones"]},{heading:"More explicit",items:["this finding","the proposal","the earlier result"]},{heading:"Repair",items:["repeat head noun","add a demonstrative + noun","name the actor","split the sentence"]}]},
build:[
{question:"The report and estimate arrived. ___ recommends a longer trial. Which is clear?",answer:"The report recommends a longer trial.",options:[{value:"The report recommends a longer trial."},{value:"It recommends a longer trial."},{value:"This recommends that."}],hint:"Two singular nouns make it ambiguous."},
{question:"Replace the repeated room: This room is too small; we need a larger room.",answer:"This room is too small; we need a larger one.",options:[{value:"This room is too small; we need a larger one."},{value:"This room is too small; we need larger it."},{value:"This room one is larger need."}],hint:"One substitutes for a singular count noun of the same type."},
{question:"Which this phrase clearly refers to the earlier result?",answer:"This reduction supports a larger trial.",options:[{value:"This reduction supports a larger trial."},{value:"This supports one."},{value:"It and that support."}],hint:"Add a summary noun to guide reference."},
{question:"Which sentence uses do so for the same action?",answer:"The first team revised the plan, and the second did so too.",options:[{value:"The first team revised the plan, and the second did so too."},{value:"The second did the plan so."},{value:"The first team so revised and second."}],hint:"Do so substitutes for revise the plan."},
{question:"Which ellipsis is clear?",answer:"Maya selected Tuesday; Leo, Thursday.",options:[{value:"Maya selected Tuesday; Leo, Thursday."},{value:"Maya selected; Leo was Thursday."},{value:"Selected Maya Tuesday Leo."}],hint:"Selected is recoverable in the parallel second clause."},
{question:"Which reference to a pair is clear in formal writing?",answer:"The clinic and the library applied; the former received funding.",options:[{value:"The clinic and the library applied; the former received funding."},{value:"Several places applied; the former got it."},{value:"The former without a pair received."}],hint:"Former refers to the first member of a nearby explicit pair."},
{question:"Which sentence repairs human-pronoun ambiguity?",answer:"Maya told Ana that Ana was late.",options:[{value:"Maya told Ana that Ana was late."},{value:"Maya told Ana that she was late."},{value:"She told her that she was late."}],hint:"Repeat the intended person’s name."},
{question:"Which lexical chain remains on one topic?",answer:"The proposal introduces a new fee. This measure would fund evening service.",options:[{value:"The proposal introduces a new fee. This measure would fund evening service."},{value:"The proposal introduces a fee. The bicycle is blue."},{value:"The fee proposes a proposal measure proposal."}],hint:"Measure summarizes the proposal as a policy action."}],
context:{title:"A reference chain in a policy update",intro:"Identify what each shorter form points to.",lines:["The city tested a late-night bus and a booking app. The service carried 340 passengers, while the app recorded 510 searches.","This difference suggests that interest was greater than actual ridership. It does not, however, show why some users searched without traveling.","The transport team recommends another trial, and the budget committee does too. The former wants a longer route; the latter prefers a shorter schedule."],questions:[{question:"What does “the service” refer to?",answer:"The late-night bus",options:[{value:"The late-night bus"},{value:"The booking app"},{value:"The budget committee"}],hint:"Follow the lexical chain."},{question:"What does “This difference” summarize?",answer:"The gap between 340 passengers and 510 searches",options:[{value:"The gap between 340 passengers and 510 searches"},{value:"A difference between committees"},{value:"The route length"}],hint:"The summary noun packages the preceding comparison."},{question:"What action does “does too” replace?",answer:"recommends another trial",options:[{value:"recommends another trial"},{value:"recorded 510 searches"},{value:"carried 340 passengers"}],hint:"Look at the parallel predicate."},{question:"Who prefers the shorter schedule?",answer:"The budget committee",options:[{value:"The budget committee"},{value:"The transport team"},{value:"The booking app"}],hint:"Latter refers to the second member of the pair."}]},
builder:{title:"Build the explicit reference repair",prompt:"Name the source of the recommendation.",answer:"The report not the estimate recommends a longer trial",tiles:["The","report","not","the","estimate","recommends","a","longer","trial"]},
repairs:[{title:"Repair two-person ambiguity",sentence:"Maya told Ana that she was late.",answer:"she",fix:"Maya told Ana that Ana was late. / Maya told Ana, “I’m late.”",why:"Name or quote the intended person.",tokens:[{value:"maya",label:"Maya"},{value:"told",label:"told Ana"},{value:"she",label:"that she"},{value:"late",label:"was late"}]},{title:"Repair two-object ambiguity",sentence:"The report accompanied the estimate, but it was incomplete.",answer:"it",fix:"The report accompanied the estimate, but the estimate was incomplete.",why:"Two singular inanimate nouns compete as antecedents.",tokens:[{value:"report",label:"The report"},{value:"estimate",label:"accompanied the estimate"},{value:"it",label:"but it"},{value:"incomplete",label:"was incomplete"}]},{title:"Repair vague this",sentence:"Costs rose while attendance fell. This was unexpected.",answer:"This",fix:"This combination of higher cost and lower attendance was unexpected.",why:"A summary noun identifies the proposition being evaluated.",tokens:[{value:"costs",label:"Costs rose"},{value:"attendance",label:"while attendance fell"},{value:"this",label:"This"},{value:"unexpected",label:"was unexpected"}]},{title:"Remove forced variation",sentence:"The policy created a fee. The regulation, initiative and scheme costs $2.",answer:"regulation",fix:"The policy created a $2 fee. The policy would fund evening service.",why:"Changing labels without a meaning reason can make one policy sound like several entities.",tokens:[{value:"policy",label:"The policy created a fee"},{value:"regulation",label:"The regulation, initiative and scheme"},{value:"costs",label:"costs $2"}]}],
fluency:[{prompt:"Track one noun through pronoun, summary noun and repetition.",answer:"The pilot reduced delays. It ran for six weeks. This improvement supports expansion, but the pilot needs replication."},{prompt:"Use one for same type, not same entity.",answer:"This charger is broken; I need another one."},{prompt:"Clarify a two-person pronoun sentence aloud.",answer:"Maya told Ana, “I’m late,” or Maya told Ana that Ana was late."},{prompt:"Create a short parallel ellipsis.",answer:"Maya chose Tuesday; Leo, Thursday; and Ana, Friday."}],
communicate:{title:"The reference tracker",setup:"Give a two-minute policy explanation while a listener draws arrows from every pronoun and substitute to its antecedent.",roles:["Speaker: use pronouns, summary nouns, substitution and selective repetition.","Tracker: stop any form with two plausible antecedents and request the smallest clear repair."],prompts:["What exactly does it refer to?","Is this an entity or a whole proposition?","Would one mean the same item or another of the same type?","Should the head noun be repeated?"],success:["Every shorter form has one accessible antecedent.","Lexical variation adds meaning rather than decoration.","Selective repetition restores clarity at topic shifts."]},
writing:{title:"Edit a reference-heavy paragraph",task:"Write 190 to 220 words about two proposals and two committees, then edit every reference chain.",requirements:["Use one, do so and one clear ellipsis.","Use two summary nouns after whole propositions.","Repeat a key noun at least twice where a pronoun would be ambiguous."],model:"The transport team proposed a late-night bus, while the budget committee recommended an expanded taxi voucher. The former would serve a fixed route; the latter would support individual trips. Both groups recommend a pilot, and the mayor does too. This agreement does not resolve the cost question. The bus proposal requires a vehicle and driver, while the voucher proposal requires a payment system. This difference affects implementation. The transport team prefers a six-month trial; the budget committee, three months. Because both proposals remain active, each proposal must be named whenever it becomes the subject of a new comparison."},
reflect:{canDo:["Track people, entities and propositions across extended discourse.","Use pronouns, substitution and ellipsis only when reference is recoverable.","Repeat or summarize a noun when variation would create ambiguity."],nextUse:"Annotate every pronoun and substitute in one paragraph with an arrow to its antecedent, then repair any crossed or uncertain arrows."}
};
