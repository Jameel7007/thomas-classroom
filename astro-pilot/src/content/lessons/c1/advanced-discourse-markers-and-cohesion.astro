---
import LessonPage from"../../../components/lesson/LessonPage.astro";import StructuredLesson from"../../../components/lesson/StructuredLesson.astro";import{defineLesson}from"../../../data/lesson-schema.mjs";
export const page = defineLesson({"title":"Advanced discourse markers and cohesion · C1 Grammar","slug":"advanced-discourse-markers-and-cohesion","level":"C1","topic":"Advanced discourse markers and cohesion","category":"Grammar","contentType":"grammar","status":"ready","description":"Build cohesion across extended discourse by signaling sequence, reformulation, consequence, concession and shifts in argumentative direction.","sequence":14,"prerequisites":["c1/nominalization-and-information-density","c1/hedging-and-cautious-language","b2/advanced-discourse-markers"],"related":["c1/concession-contrast-and-counterargument","c1/referencing-and-avoiding-repetition"],"assessments":["c1-exit"],"tutorReviewRequired":true,"qualityReview":{"status":"editorial-review","generatedPedagogy":true,"learnerPilotCount":0,"scoredItemCount":18,"revisionSummary":"Logical relations, reformulation, framing, consequence, concession, sequencing, reference chains, punctuation, repair, spoken signposting, and writing were authored; three learner pilots remain."}});
export const lesson={duration:"75–90 min",outcome:"Guide a reader or listener through an extended explanation using explicit logical relations, reformulation and reference chains without filling every sentence with connectors.",focus:"logical relations and discourse guidance",tags:["reformulation","argument flow","cohesion"],
retrieval:[{prompt:"Contrast however and therefore.",answer:"However signals contrast or concession; therefore signals a consequence or inference."},{prompt:"Reformulate a technical point for a general audience.",answer:"In other words,… / Put simply,…"},{prompt:"Sequence three stages without repeating then.",answer:"Initially,… Subsequently,… Finally,…"}],
notice:{title:"Connectors tell the reader what to do with the next idea",setup:"A policy summary moves through evidence, limitation and conclusion.",samples:["The pilot reduced waiting times. However, it covered only two clinics.","The sample was limited. Nevertheless, the result justifies a larger trial.","The process is reversible. In other words, the original schedule can be restored if necessary."],questions:["Does however cancel the first result or limit how broadly it applies?","What expectation does nevertheless resist?","Which marker changes wording without adding new evidence?"],check:{question:"What relationship does “In other words” signal?",answer:"The next wording reformulates the same core idea for clarity.",options:[{value:"The next wording reformulates the same core idea for clarity."},{value:"The next sentence contradicts all earlier facts."},{value:"The writer introduces an unrelated topic."}],hint:"Compare reversible with the explanation that follows."}},
discover:{principle:"Cohesion comes from meaningful relations, reference and information flow. A discourse marker makes one relation explicit; it cannot repair a missing logical connection. Choose the relation first, then decide whether a marker is needed.",formRows:[{label:"sentence adverbial","form":"However/Therefore, + clause",example:"However, the sample was small."},{label:"prepositional frame","form":"In light of/With respect to + noun",example:"In light of the results, we extended the trial."},{label:"reformulation","form":"In other words/More precisely + clause",example:"More precisely, the effect occurred only at night."},{label:"metadiscourse","form":"The key point is… / Turning to…",example:"Turning to costs, the pilot stayed within budget."}],meaningRows:[{choice:"addition",use:"the next point develops the same direction",example:"Furthermore, costs fell."},{choice:"concession",use:"a fact holds despite an expectation",example:"Nevertheless, demand remained high."},{choice:"consequence",use:"the next claim follows from evidence or decision",example:"Consequently, the deadline moved."},{choice:"reformulation",use:"the speaker restates, narrows or corrects",example:"More precisely, three sites were affected."}],pronunciation:"In speech, give signposts their own short tone unit: TURNING to COSTS | the pilot stayed within budget. Keep routine connectors light; stress a marker only when the relation itself is corrective.",errors:[{wrong:"The sample was small. Therefore, the result may still be useful.",correct:"The sample was small. Nevertheless, the result may still be useful.",why:"The second claim holds despite the limitation; it is not caused by it."},{wrong:"However the sample was small, the result mattered.",correct:"Although the sample was small, the result mattered. / The sample was small; however, the result mattered.",why:"However does not normally introduce a finite concession clause like although."},{wrong:"Every sentence needs a different connector.",correct:"Use reference, topic continuity and paragraph structure; mark only relations the reader needs help interpreting.",why:"Connector density can make prose mechanical and obscure the real logic."}]},
reference:{title:"Relation inventory",intro:"Name the relation before selecting the marker.",groups:[{heading:"Develop",items:["furthermore","in addition","more importantly"]},{heading:"Turn",items:["however","nevertheless","by contrast","turning to"]},{heading:"Result",items:["therefore","consequently","as a result"]},{heading:"Restate",items:["in other words","more precisely","that is"]}]},
build:[
{question:"The sample was small, but the result remained useful. Which marker fits?",answer:"Nevertheless",options:[{value:"Nevertheless"},{value:"Therefore"},{value:"For example"}],hint:"The result holds despite the limitation."},
{question:"The deadline moved because testing took longer. Which marker fits?",answer:"Consequently",options:[{value:"Consequently"},{value:"By contrast"},{value:"In other words"}],hint:"Signal a result."},
{question:"You want to restate a technical claim more simply. Which marker fits?",answer:"In other words",options:[{value:"In other words"},{value:"Nevertheless"},{value:"Meanwhile"}],hint:"The core meaning remains the same."},
{question:"You need to narrow an earlier broad statement. Which marker fits?",answer:"More precisely",options:[{value:"More precisely"},{value:"Furthermore"},{value:"As a result"}],hint:"Introduce a correction or tighter scope."},
{question:"Which sentence punctuates however correctly?",answer:"The cost fell; however, demand remained unchanged.",options:[{value:"The cost fell; however, demand remained unchanged."},{value:"However the cost fell, demand remained unchanged."},{value:"The cost however fell demand."}],hint:"Use however as a sentence adverbial between independent clauses."},
{question:"Which frame shifts to a new subtopic?",answer:"Turning to implementation, the first phase begins in May.",options:[{value:"Turning to implementation, the first phase begins in May."},{value:"Therefore implementation means contrast."},{value:"In other words, a completely unrelated topic."}],hint:"Use metadiscourse to announce the move."},
{question:"Which connector introduces evidence in the same direction?",answer:"Furthermore, attendance improved at both sites.",options:[{value:"Furthermore, attendance improved at both sites."},{value:"Nevertheless, attendance caused the sites."},{value:"By contrast, both identical sites improved."}],hint:"The next fact adds support."},
{question:"Which version needs no explicit connector?",answer:"The clinic extended its hours. The longer schedule allowed evening appointments.",options:[{value:"The clinic extended its hours. The longer schedule allowed evening appointments."},{value:"The clinic extended hours. Nevertheless, therefore, evening appointments."},{value:"However because the schedule, appointments."}],hint:"Lexical reference and clear cause may already carry the relation."}],
context:{title:"A cohesive recommendation",intro:"Follow the logic rather than counting connectors.",lines:["The pilot reduced average waiting time by eleven minutes. Furthermore, the improvement appeared at both participating clinics. The sample, however, covered only six weeks.","Nevertheless, the consistency of the result justifies a larger trial. More precisely, the next phase should test whether the improvement continues during winter demand.","Turning to cost, the pilot stayed within its existing staffing budget. The change is reversible; in other words, clinics can restore the earlier schedule if the larger trial creates problems."],questions:[{question:"What additional support does furthermore introduce?",answer:"Both clinics showed improvement.",options:[{value:"Both clinics showed improvement."},{value:"The sample lasted for years."},{value:"Costs exceeded the budget."}],hint:"Find the added evidence."},{question:"What expectation does nevertheless resist?",answer:"A short sample might be expected to prevent further testing.",options:[{value:"A short sample might be expected to prevent further testing."},{value:"Both clinics necessarily closed."},{value:"Winter demand is already known."}],hint:"Connect the limitation to the recommendation."},{question:"What does more precisely narrow?",answer:"It specifies what the larger trial should test.",options:[{value:"It specifies what the larger trial should test."},{value:"It cancels the waiting-time result."},{value:"It changes the topic to staff names."}],hint:"Read the exact research question."},{question:"What does in other words reformulate?",answer:"The meaning of reversible",options:[{value:"The meaning of reversible"},{value:"The amount of winter demand"},{value:"The number of clinics"}],hint:"The next clause explains the same concept."}]},
builder:{title:"Build the concessive transition",prompt:"Keep the recommendation despite the limit.",answer:"The sample was limited nevertheless the result justifies a larger trial",tiles:["The","sample","was","limited","nevertheless","the","result","justifies","a","larger","trial"]},
repairs:[{title:"Choose concession, not result",sentence:"The sample was small. Therefore, the result may still be useful.",answer:"Therefore",fix:"The sample was small. Nevertheless, the result may still be useful.",why:"Use concession for a claim that holds despite the limit.",tokens:[{value:"sample",label:"The sample was small"},{value:"therefore",label:"Therefore"},{value:"result",label:"the result may still be useful"}]},{title:"Repair however grammar",sentence:"However the pilot was short, it produced useful evidence.",answer:"However",fix:"Although the pilot was short, it produced useful evidence.",why:"Although introduces the finite concession clause.",tokens:[{value:"however",label:"However"},{value:"pilot",label:"the pilot was short"},{value:"result",label:"it produced useful evidence"}]},{title:"Remove connector stacking",sentence:"However, nevertheless, the team continued.",answer:"nevertheless",fix:"Nevertheless, the team continued.",why:"One accurate marker is enough.",tokens:[{value:"however",label:"However"},{value:"nevertheless",label:"nevertheless"},{value:"team",label:"the team continued"}]},{title:"Match reformulation",sentence:"Costs fell. In other words, attendance increased at a different clinic.",answer:"other",fix:"Costs fell. In addition, attendance increased at a different clinic.",why:"The second claim adds evidence; it does not restate the first.",tokens:[{value:"costs",label:"Costs fell"},{value:"other",label:"In other words"},{value:"attendance",label:"attendance increased"},{value:"clinic",label:"at a different clinic"}]}],
fluency:[{prompt:"Give one result, limitation, concession and recommendation.",answer:"Waiting times fell. However, the sample was short. Nevertheless, the consistency justifies a larger trial. Therefore, we recommend extending the pilot."},{prompt:"Restate, then narrow a claim.",answer:"The change is reversible. In other words, the old schedule can be restored. More precisely, restoration would take about two days."},{prompt:"Shift subtopic in a spoken briefing.",answer:"Turning to cost, the pilot remained within the existing budget."},{prompt:"Remove two unnecessary connectors from a short paragraph.",answer:"Keep the relation that needs marking and use lexical reference or ordinary sequence for the rest."}],
communicate:{title:"The cohesion map",setup:"Give a three-minute recommendation with a visible map of evidence, limitation, consequence, reformulation and next step.",roles:["Speaker: guide the listener through the map without reading a list of connectors.","Listener: name each logical relation and stop any marker that does not match it."],prompts:["What relation comes next?","Does this add, turn, result or restate?","Can reference carry the link without a marker?","Where does the subtopic change?"],success:["Every explicit marker matches the logical relation.","Paragraphs remain cohesive without connector overload.","Spoken signposts and intonation make the route easy to follow."]},
writing:{title:"Write a cohesive recommendation",task:"Write 190 to 230 words moving from evidence through limitation to a proportionate next step.",requirements:["Use addition, concession, consequence and reformulation once each.","Use one metadiscourse phrase to shift subtopic.","Leave at least two clear sentence relations unmarked and carried by reference."],model:"The pilot reduced waiting time by eleven minutes. The improvement appeared at both clinics, which strengthens the case for further testing. However, the sample covered only six weeks. Nevertheless, the consistency of the result justifies a larger trial. More precisely, the next phase should test performance during winter demand. Turning to cost, the pilot remained within its existing staffing budget. The change is reversible; in other words, clinics can restore the earlier schedule if problems emerge. We therefore recommend a six-month extension with monthly review points."},
reflect:{canDo:["Name addition, concession, consequence and reformulation relations.","Choose and punctuate markers accurately.","Create cohesion through reference and structure as well as explicit connectors."],nextUse:"Outline one spoken explanation as a relation map, deliver it, and note where a listener actually needed a signpost."}
};
---
<LessonPage page={page}><StructuredLesson page={page} lesson={lesson}/></LessonPage>
