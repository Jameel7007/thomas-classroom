    <div class="tile-bank" data-build-bank><button class="tile" data-build-tile="staff">staff</button><button class="tile" data-build-tile="offline">offline</button><button class="tile" data-build-tile="now">now</button><button class="tile" data-build-tile="plan">plan</button><button class="tile" data-build-tile="work">work</button><button class="tile" data-build-tile="an">an</button><button class="tile" data-build-tile="had">had</button><button class="tile" data-build-tile="If">If</button><button class="tile" data-build-tile="would">would</button><button class="tile" data-build-tile="included">included</button><button class="tile" data-build-tile="less">less</button><button class="tile" data-build-tile="have">have</button><button class="tile" data-build-tile="form">form</button><button class="tile" data-build-tile="the">the</button></div>
