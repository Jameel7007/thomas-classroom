        <div class="quiz-options"><button class="quiz-option" data-quiz-option="Japan">Japan</button><button class="quiz-option" data-quiz-option="Japanese">Japanese</button><button class="quiz-option" data-quiz-option="japan">japan</button></div>
      </div>
