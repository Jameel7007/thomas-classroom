  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day question-word retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <p>Come back tomorrow. Read each short answer, then choose the question word and say the full question.</p>

    <div class="practice" data-choice-gap-drill data-success-message="Correct. Reception gives a place for Where, Maya identifies a person for Who, and tired gives a condition for How.">
      <h3>Choose from memory</h3>
      <p class="choice-hint">Tap each gap, then choose the question word</p>
      <div class="choice-bank" aria-label="Answer choices">
        <button class="choice-option" data-choice-option="What">What</button>
        <button class="choice-option" data-choice-option="Where">Where</button>
        <button class="choice-option" data-choice-option="Who">Who</button>
        <button class="choice-option" data-choice-option="How">How</button>
      </div>
      <div class="q"><span class="n">1</span><span><button class="choice-gap" data-choice-gap data-answer="Where" data-hint="At reception is a place." data-fix="Where is your manager?" data-placeholder="choose">choose</button> is your manager? &nbsp;<span class="contraction">(Answer: At reception.)</span></span></div>
      <div class="q"><span class="n">2</span><span><button class="choice-gap" data-choice-gap data-answer="Who" data-hint="Maya identifies a person." data-fix="Who is the new analyst?" data-placeholder="choose">choose</button> is the new analyst? &nbsp;<span class="contraction">(Answer: Maya.)</span></span></div>
      <div class="q"><span class="n">3</span><span><button class="choice-gap" data-choice-gap data-answer="How" data-hint="Tired describes the speaker’s condition." data-fix="How are you?" data-placeholder="choose">choose</button> are you? &nbsp;<span class="contraction">(Answer: I'm tired.)</span></span></div>
      <div class="drill-actions">
        <button class="lesson-btn" data-check-choices>Check</button>
        <button class="lesson-btn" data-reset-choices>Reset</button>
      </div>
      <p class="feedback" data-feedback></p>
    </div>

    <div class="micro-drill" data-spot-error data-answer="what" data-hint="The answer gives the restroom’s location." data-fix="Where is the restroom?" data-why="Down the hall is a place, so use where, not what.">
      <h3>Repair from memory</h3>
      <p>The answer is “Down the hall.” Tap the wrong word.</p>
      <p class="ex">What is the restroom?</p>
      <div class="spot-options">
        <button class="error-choice" data-error-choice="what">What</button>
        <button class="error-choice" data-error-choice="is">is</button>
        <button class="error-choice" data-error-choice="restroom">restroom?</button>
      </div>
      <p class="hidden-answer" data-error-feedback></p>
    </div>

    <div class="micro-drill" data-transform>
      <h3>Say it without notes</h3>
      <p>Build and say the question before you reveal it.</p>
      <div class="transform-list">
        <div class="transform-item" data-transform-item>
          <p class="transform-cue"><b>1</b> what + is + your email address</p>
          <button class="lesson-btn" data-reveal-transform>Reveal</button>
          <p class="transform-answer" data-transform-answer><strong>What is your email address?</strong></p>
        </div>
        <div class="transform-item" data-transform-item>
          <p class="transform-cue"><b>2</b> where + are + your keys</p>
          <button class="lesson-btn" data-reveal-transform>Reveal</button>
          <p class="transform-answer" data-transform-answer><strong>Where are your keys?</strong></p>
        </div>
      </div>
    </div>

