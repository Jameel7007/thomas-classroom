---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Question words · A0 Grammar",
  "slug": "question-words-what-where-who-how",
  "level": "A0",
  "topic": "Question words: what, where, who, how",
  "category": "Grammar",
  "contentType": "grammar",
  "status": "ready",
  "description": "Ask useful beginner questions with what, where, who, and how, choosing the word that matches a thing, place, person, or way.",
  "sequence": 7,
  "prerequisites": [
    "a0/the-verb-to-be",
    "a0/possessive-adjectives"
  ],
  "related": [
    "a0/greetings-and-introductions",
    "a1/present-simple"
  ],
  "assessments": [
    "a0-exit"
  ],
  "tutorReviewRequired": true,
  "qualityReview": {
    "status": "editorial-review",
    "generatedPedagogy": true,
    "learnerPilotCount": 0,
    "scoredItemCount": 31,
    "revisionSummary": "Information type, be-question scope and order, natural answer-question pairs, sentence capitalization, contextual feedback, intonation, timing, production, and retrieval were audited; three learner pilots remain."
  }
