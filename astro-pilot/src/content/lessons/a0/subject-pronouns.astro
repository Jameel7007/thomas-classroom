---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Subject pronouns · A0 Grammar",
  "slug": "subject-pronouns",
  "level": "A0",
  "topic": "Subject pronouns (I, you, he, she, it, we, they)",
  "category": "Grammar",
  "contentType": "grammar",
  "status": "ready",
  "description": "Choose I, you, he, she, it, we, or they to show who a sentence is about without repeating a person’s or thing’s name.",
  "sequence": 2,
  "prerequisites": [
