        <div class="quiz-options"><button class="quiz-option" data-quiz-option="twenty">twenty</button><button class="quiz-option" data-quiz-option="twenty-two">twenty-two</button><button class="quiz-option" data-quiz-option="twenty-one">twenty-one</button></div>
      </div>
