---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Family members · A0 Vocabulary",
  "slug": "family-members",
  "level": "A0",
  "topic": "Family members",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Name close and extended family members and explain relationships naturally with possessive adjectives and possessive ’s.",
  "sequence": 13,
  "prerequisites": [
    "a0/possessive-adjectives",
    "a0/regular-plural-nouns",
    "a0/this-that-these-those"
  ],
  "related": [
    "a1/have-got",
    "b1/relationships"
  ],
  "assessments": [
    "a0-exit"
  ],
  "tutorReviewRequired": true,
  "qualityReview": {
    "status": "editorial-review",
    "generatedPedagogy": true,
    "learnerPilotCount": 0,
    "scoredItemCount": 45,
    "revisionSummary": "Family diversity, neutral and gender-specific terms, possessive meaning, irregular plurals, spoken forms, privacy, item context, feedback, production, and retrieval were audited; three learner pilots remain."
  }
});
---
<LessonPage page={page}>
<main class="wrap" data-core-duration="45–55 minutes" data-extension-duration="15–20 minutes">
  <p class="kicker"><span class="dot"></span> Vocabulary · Lesson 13</p>
  <h1>Family <em>members</em></h1>
  <p class="standfirst">Name close and extended family relationships with specific words such as <span class="ex">mother</span> and <span class="ex">brother</span>, or neutral words such as <span class="ex">parent</span> and <span class="ex">sibling</span>. Connect people with <strong>my, his, her, our, their</strong>, and possessive <strong>'s</strong>: <span class="ex">my sibling</span>, <span class="ex">Omar's brother</span>, <span class="ex">their children</span>.</p>
  <div class="meta-row">
    <span class="tag">45–55 min core</span>
    <span class="tag">specific and neutral words</span>
    <span class="tag">my · his · her · our · their · 's</span>
    <span class="tag">15–20 min optional practice</span>
  </div>

  <div class="lesson-flow" aria-label="Lesson flow">
    <div class="flow-step"><b>Notice</b><span>Read a short family description.</span></div>
    <div class="flow-step"><b>Discover</b><span>Specific words, neutral words, and one irregular plural.</span></div>
    <div class="flow-step"><b>Build</b><span>Match meanings, choose, and build chunks.</span></div>
    <div class="flow-step"><b>Use</b><span>Describe a real, pictured, or invented family.</span></div>
  </div>

  <p class="note-line"><span class="ex">Mother, father, grandmother, grandfather</span>, and <span class="ex">children</span> are standard or more formal choices. In U.S. English, <span class="ex">mom, dad, grandma, grandpa</span>, and <span class="ex">kids</span> are common informal choices. Use the family words each person uses for their own relationships.</p>

  <h2>Two-minute retrieval</h2>
  <div class="lead-rule"></div>
  <div class="practice" data-choice-gap-drill data-success-message="Correct. You retrieved my for the speaker's relationship, a plural noun after two, and are with the plural subject Ana's parents.">
    <h3>Bring possessives, plurals, and <em>be</em> into the lesson</h3>
    <p class="choice-hint">Use earlier lessons. Complete each full family description, then say it aloud.</p>
    <div class="choice-bank" aria-label="Earlier grammar choices">
      <button class="choice-option" data-choice-option="my">my</button>
      <button class="choice-option" data-choice-option="her">her</button>
      <button class="choice-option" data-choice-option="cousin">cousin</button>
      <button class="choice-option" data-choice-option="cousins">cousins</button>
      <button class="choice-option" data-choice-option="is">is</button>
      <button class="choice-option" data-choice-option="are">are</button>
    </div>
    <div class="q"><span class="n">1</span><span>Ana says, “This is <button class="choice-gap" data-choice-gap data-answer="my" data-hint="Ana is speaking about her own sister, so use the speaker word my." data-fix="Ana says, ‘This is my sister.’" data-placeholder="choose">choose</button> sister.”</span></div>
    <div class="q"><span class="n">2</span><span>I have two <button class="choice-gap" data-choice-gap data-answer="cousins" data-hint="Two requires the regular plural noun cousins." data-fix="I have two cousins." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">3</span><span>Ana's parents <button class="choice-gap" data-choice-gap data-answer="are" data-hint="Parents is plural, so use the plural form are." data-fix="Ana's parents are here." data-placeholder="choose">choose</button> here.</span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Meet the family</h2>
  <div class="lead-rule"></div>
  <p>Use the written label under each representative picture: <span class="ex">This is my mother. This is my brother.</span> A person's appearance does not tell you their family role, so learn the label and relationship, not the face or clothing.</p>
  <div class="figure-grid">
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/grandmother.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">grandmother</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/grandfather.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">grandfather</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/mother.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">mother</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/father.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">father</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/sister.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">sister</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/brother.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">brother</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/boy.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">son</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/girl.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">daughter</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/man.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">husband</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/woman.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">wife</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/family.svg" alt="" width="62" height="62" loading="lazy" decoding="async" /></span><span class="nm">family</span></div>
  </div>

  <h2>Notice before the rule</h2>
  <div class="lead-rule"></div>
  <div class="thinking-card">
    <h3>Read about Sofia's fictional family</h3>
    <p><span class="ex">"My mother is a nurse. My father is a teacher. I have one sister and one brother. My sister's husband is Diego."</span></p>
    <ul>
      <li>Which words give a specific relationship and gender: <strong>mother, father, sister, brother</strong>, or <strong>family</strong>?</li>
      <li>For Sofia, <strong>mother</strong> and <strong>father</strong> are both types of <strong>parent</strong>. <strong>Sister</strong> and <strong>brother</strong> are both types of <strong>sibling</strong>. Which neutral word names each pair?</li>
      <li>Look at <span class="ex">my sister's husband</span>. The little <span class="ex">'s</span> shows a family relationship. What is Diego’s relationship to Sofia’s sister?</li>
    </ul>
  </div>

  <div class="practice" data-choice-gap-drill data-success-message="Correct. The fictional description distinguishes mother, father, parents, sister, and brother from explicit relationship clues.">
    <h3>Discovery check: read the clue, then choose the word</h3>
    <p class="choice-hint">Each clue describes one person. Choose the family word that matches.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="mother">mother</button>
      <button class="choice-option" data-choice-option="father">father</button>
      <button class="choice-option" data-choice-option="sister">sister</button>
      <button class="choice-option" data-choice-option="brother">brother</button>
      <button class="choice-option" data-choice-option="parents">parents</button>
    </div>
    <div class="q"><span class="n">1</span><span>Sofia says, “Rosa is my female parent.” Rosa is Sofia's <button class="choice-gap" data-choice-gap data-answer="mother" data-hint="The clue says female parent; the specific family word is mother." data-fix="Rosa is Sofia's mother." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">2</span><span>Sofia says, “Luis is my male parent.” Luis is Sofia's <button class="choice-gap" data-choice-gap data-answer="father" data-hint="The clue says male parent; the specific family word is father." data-fix="Luis is Sofia's father." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">3</span><span>Rosa and Luis are both Sofia's parents. Together, they are her <button class="choice-gap" data-choice-gap data-answer="parents" data-hint="The sentence says both people are Sofia's parents, so use the plural parents." data-fix="Rosa and Luis are Sofia's parents." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">4</span><span>In this story, Marta and Sofia have the same parents. Marta is their daughter and is not Sofia. Marta is Sofia's <button class="choice-gap" data-choice-gap data-answer="sister" data-hint="A female sibling is a sister; the clue names Marta as a daughter with the same parents." data-fix="Marta is Sofia's sister." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">5</span><span>In this story, Leo and Sofia have the same parents. Leo is their son and is not Sofia. Leo is Sofia's <button class="choice-gap" data-choice-gap data-answer="brother" data-hint="A male sibling is a brother; the clue names Leo as a son with the same parents." data-fix="Leo is Sofia's brother." data-placeholder="choose">choose</button>.</span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>The system: specific words, neutral words, and one special plural</h2>
  <div class="lead-rule"></div>
  <p>Some family words give a specific relationship and gender. A neutral word can describe the relationship without giving gender. Use the word that matches how the person describes their family:</p>
  <table>
    <thead><tr><th>relationship</th><th>specific words</th><th>neutral or general word</th></tr></thead>
    <tbody>
      <tr><td><b>parent</b></td><td><b>mother</b> / <b>mom</b> · <b>father</b> / <b>dad</b></td><td><b>parent</b></td></tr>
      <tr><td><b>sibling</b></td><td><b>sister</b> · <b>brother</b></td><td><b>sibling</b></td></tr>
      <tr><td><b>child</b></td><td><b>daughter</b> · <b>son</b></td><td><b>child</b></td></tr>
      <tr><td><b>married partner</b></td><td><b>wife</b> · <b>husband</b></td><td><b>spouse</b></td></tr>
      <tr><td><b>partner</b></td><td>use the word the person gives you</td><td><b>partner</b></td></tr>
      <tr><td><b>grandparent</b></td><td><b>grandmother</b> / <b>grandma</b> · <b>grandfather</b> / <b>grandpa</b></td><td><b>grandparent</b></td></tr>
      <tr><td><b>parent's sibling</b></td><td><b>aunt</b> · <b>uncle</b></td><td>say <b>my parent's sibling</b> if needed</td></tr>
      <tr><td><b>aunt or uncle's child</b></td><td><b>cousin</b></td><td><b>cousin</b></td></tr>
    </tbody>
  </table>

  <div class="note">
    <h3>Pronunciation focus: family words hide a few sounds</h3>
    <p>Some family words are easier to understand when you learn their spoken parts. Say each one slowly once, then use it in a natural chunk such as <span class="ex">my brother</span> or <span class="ex">her daughter</span>.</p>
    <table>
      <thead><tr><th>word</th><th>sound help</th><th>example chunk</th></tr></thead>
      <tbody>
        <tr><td>mother · father · brother</td><td>put the tongue gently between the teeth and use your voice for the <span class="ex">th</span> sound</td><td><span class="contraction">my <strong>BROTH</strong>er</span></td></tr>
        <tr><td>daughter</td><td><span class="ex"><strong>DAW</strong>-ter</span>; <span class="ex">gh</span> is silent, and in many U.S. accents the <span class="ex">t</span> sounds like a quick <span class="ex">d</span></td><td><span class="contraction">their <strong>DAW</strong>ter</span></td></tr>
        <tr><td>children</td><td><span class="ex"><strong>CHIL</strong>-dren</span>; two spoken parts</td><td><span class="contraction">three <strong>CHIL</strong>dren</span></td></tr>
        <tr><td>cousin</td><td><span class="ex"><strong>CUZ</strong>-in</span>; the second part is light</td><td><span class="contraction">my <strong>CUZ</strong>in Ana</span></td></tr>
        <tr><td>sibling</td><td><span class="ex"><strong>SIB</strong>-ling</span>; the first part is strong</td><td><span class="contraction">her <strong>SIB</strong>ling</span></td></tr>
        <tr><td>aunt</td><td>both “ant” and “ahnt” are common in American English</td><td><span class="contraction">my aunt Maria</span></td></tr>
      </tbody>
    </table>
    <p>In long family words, the first part is usually the clear beat: <span class="ex"><strong>GRAND</strong>mother · <strong>GRAND</strong>father · <strong>PAR</strong>ents</span>.</p>
    <p>Possessive <span class="ex">'s</span> joins closely to a name. After a voiced sound, it often sounds like <span class="ex">z</span>: <span class="ex">Omar's</span> sounds like <span class="ex">Omarz</span>. Say the relationship as one chunk: <span class="ex">Omar's brother · Ana's spouse</span>.</p>
  </div>

  <div class="note">
    <h3>Families and meanings</h3>
    <ul>
      <li>How do we say more than one child? <strong>Not</strong> <span class="ex">childs</span>. The plural of <span class="ex">child</span> is <span class="ex">children</span> (warmly, <span class="ex">kids</span>).</li>
      <li>One person is a <span class="ex">parent</span>; two or more are <span class="ex">parents</span>. A family may have one parent, two parents, or another structure. A <span class="ex">grandparent</span> is a parent's parent.</li>
      <li><span class="ex">Sibling, parent, child, spouse, partner, grandparent</span>, and <span class="ex">cousin</span> do not state gender. They are useful when gender is not relevant or when they are the words a person uses.</li>
      <li>In this A0 lesson, an <span class="ex">aunt</span> or <span class="ex">uncle</span> is a parent's sibling. People also commonly use these words for the spouse or partner of a parent's sibling.</li>
      <li>Families can be connected by birth, adoption, marriage, partnership, or other committed family relationships. Do not guess a relationship from appearance; listen for the word the person uses.</li>
    </ul>
  </div>

  <section data-lesson-extension="Tutor-read family relationship listening check">
    <h2>Hear the family relationship</h2>
    <div class="lead-rule"></div>
    <p>Keep the script closed while you listen. Your teacher reads each sentence once, then once more. Choose the exact relationship word or plural you hear.</p>
    <div class="practice" data-choice-gap-drill data-success-message="Correct. You distinguished sibling, children, spouse, cousin, parents, and daughter in complete spoken family descriptions.">
      <h3>Listening check: complete the description</h3>
      <div class="choice-bank" aria-label="Listening family-word choices">
        <button class="choice-option" data-choice-option="sibling">sibling</button>
        <button class="choice-option" data-choice-option="sister">sister</button>
        <button class="choice-option" data-choice-option="children">children</button>
        <button class="choice-option" data-choice-option="child">child</button>
        <button class="choice-option" data-choice-option="spouse">spouse</button>
        <button class="choice-option" data-choice-option="parent">parent</button>
        <button class="choice-option" data-choice-option="cousin">cousin</button>
        <button class="choice-option" data-choice-option="uncle">uncle</button>
        <button class="choice-option" data-choice-option="parents">parents</button>
        <button class="choice-option" data-choice-option="grandparents">grandparents</button>
        <button class="choice-option" data-choice-option="daughter">daughter</button>
        <button class="choice-option" data-choice-option="brother">brother</button>
      </div>
      <div class="q"><span class="n">1</span><span>This is my <button class="choice-gap" data-choice-gap data-answer="sibling" data-hint="Listen for SIB-ling, the neutral word for a sister or brother." data-fix="This is my sibling." data-placeholder="listen">listen</button>.</span></div>
      <div class="q"><span class="n">2</span><span>They have two <button class="choice-gap" data-choice-gap data-answer="children" data-hint="Listen for the two spoken parts in CHIL-dren and notice the number two." data-fix="They have two children." data-placeholder="listen">listen</button>.</span></div>
      <div class="q"><span class="n">3</span><span>Her <button class="choice-gap" data-choice-gap data-answer="spouse" data-hint="Listen for spouse, the neutral word for a husband or wife." data-fix="Her spouse is a doctor." data-placeholder="listen">listen</button> is a doctor.</span></div>
      <div class="q"><span class="n">4</span><span>Omar's <button class="choice-gap" data-choice-gap data-answer="cousin" data-hint="Listen for CUZ-in, not uncle." data-fix="Omar's cousin lives nearby." data-placeholder="listen">listen</button> lives nearby.</span></div>
      <div class="q"><span class="n">5</span><span>My <button class="choice-gap" data-choice-gap data-answer="parents" data-hint="Listen for parents, not the longer word grandparents." data-fix="My parents are in Texas." data-placeholder="listen">listen</button> are in Texas.</span></div>
      <div class="q"><span class="n">6</span><span>Ana's <button class="choice-gap" data-choice-gap data-answer="daughter" data-hint="Listen for DAW-ter with silent gh." data-fix="Ana's daughter is twenty." data-placeholder="listen">listen</button> is twenty.</span></div>
      <div class="drill-actions">
        <button class="lesson-btn" data-check-choices>Check</button>
        <button class="lesson-btn" data-reset-choices>Reset</button>
      </div>
      <p class="feedback" data-feedback></p>
    </div>
    <details>
      <summary>Teacher: open the script after the learner checks</summary>
      <ol>
        <li>This is my sibling.</li>
        <li>They have two children.</li>
        <li>Her spouse is a doctor.</li>
        <li>Omar's cousin lives nearby.</li>
        <li>My parents are in Texas.</li>
        <li>Ana's daughter is twenty.</li>
      </ol>
    </details>
  </section>

  <h2>Show the family connection &nbsp;<em>my · his · her · 's</em></h2>
  <div class="lead-rule"></div>
  <p>Put a possessive adjective before the family word to show the relationship. Keep the chunk together:</p>
  <p><span class="ex">my mother &nbsp; · &nbsp; her brother &nbsp; · &nbsp; his spouse &nbsp; · &nbsp; our children &nbsp; · &nbsp; their cousin</span></p>
  <p>For a name, add possessive <span class="ex">'s</span> to the name that identifies the connection:</p>
  <p><span class="ex">Omar's brother &nbsp; · &nbsp; Ana's spouse &nbsp; · &nbsp; my sister's son</span></p>
  <p><span class="ex">Omar's brother</span> shows a relationship; it does not mean Omar owns a person. Do not use both systems together: say <span class="ex">Omar's brother</span>, not <span class="ex">Omar's his brother</span>.</p>

  <div class="practice" data-choice-gap-drill data-success-message="Correct. Each family word follows from the stated connection, and children is the irregular plural after three.">
    <h3>Drill 1: choose the family word</h3>
    <p class="choice-hint">The clue and the possessive tell you exactly who the person is</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="grandmother">grandmother</button>
      <button class="choice-option" data-choice-option="uncle">uncle</button>
      <button class="choice-option" data-choice-option="daughter">daughter</button>
      <button class="choice-option" data-choice-option="wife">wife</button>
      <button class="choice-option" data-choice-option="cousin">cousin</button>
      <button class="choice-option" data-choice-option="children">children</button>
    </div>
    <div class="q"><span class="n">1</span><span>In this fictional family, my mother Rosa says, “Elena is my mother.” Elena is my <button class="choice-gap" data-choice-gap data-answer="grandmother" data-hint="Elena is the mother of my parent Rosa, so she is my grandmother." data-fix="Elena is my grandmother." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">2</span><span>In this fictional family, my father Luis says, “Tom is my brother.” Tom is my <button class="choice-gap" data-choice-gap data-answer="uncle" data-hint="Tom is my parent's brother, so the family word in this lesson is uncle." data-fix="Tom is my uncle." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">3</span><span>Omar's wife is Leyla. They say, “Nina is our female child.” Nina is their <button class="choice-gap" data-choice-gap data-answer="daughter" data-hint="The people describe Nina as their female child; the specific word is daughter." data-fix="Nina is their daughter." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">4</span><span>My brother says, “Maya and I are married, and Maya is my wife.” Maya is his <button class="choice-gap" data-choice-gap data-answer="wife" data-hint="The speaker explicitly uses wife for Maya, so repeat that family word." data-fix="Maya is his wife." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">5</span><span>My aunt says, “Leo is my son.” Leo is my <button class="choice-gap" data-choice-gap data-answer="cousin" data-hint="An aunt's child is a cousin in the family pattern taught here." data-fix="Leo is my cousin." data-placeholder="choose">choose</button>.</span></div>
    <div class="q"><span class="n">6</span><span>A fictional coworker has two sons and one daughter. The three people are the coworker's <button class="choice-gap" data-choice-gap data-answer="children" data-hint="Two sons plus one daughter are three children; child has an irregular plural." data-fix="The coworker has three children." data-placeholder="choose">choose</button>.</span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Build the meaning, then the sentence</h2>
  <div class="lead-rule"></div>

  <div class="tile-game" data-tile-game data-success-message="Correct. You matched each family word to an explicit relationship rather than guessing from a name or appearance.">
    <h3>Drill 2: match each meaning to its family word</h3>
    <p class="tile-target">Tap a word, then tap the meaning that fits it</p>
    <div class="tile-bank">
      <button class="tile" data-tile="grandmother">grandmother</button>
      <button class="tile" data-tile="uncle">uncle</button>
      <button class="tile" data-tile="sister">sister</button>
      <button class="tile" data-tile="parents">parents</button>
      <button class="tile" data-tile="husband">husband</button>
    </div>
    <div class="slot-board">
      <button class="slot" data-slot="grandmother" data-hint="Move up one generation: my mother's mother is my grandmother." data-fix="grandmother → my mother's mother" data-placeholder="my mother's mother">my mother's mother</button>
      <button class="slot" data-slot="uncle" data-hint="In this family, my father's brother is my uncle." data-fix="uncle → my father's brother" data-placeholder="my father's brother">my father's brother</button>
      <button class="slot" data-slot="sister" data-hint="A female sibling is a sister; the clue says daughter with the same parents." data-fix="sister → my parents' daughter, not me" data-placeholder="my parents' daughter, not me">my parents' daughter, not me</button>
