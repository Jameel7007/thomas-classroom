---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "The verb “to be” · A0 Grammar",
  "slug": "the-verb-to-be",
  "level": "A0",
  "topic": "The verb to be (am / is / are)",
  "category": "Grammar",
  "contentType": "grammar",
  "status": "ready",
  "description": "Use the verb be to identify people and things, describe feelings and age, and say where someone or something is.",
