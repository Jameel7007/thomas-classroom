  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day plural retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <p>Come back tomorrow. Decide from memory, then say every complete plural phrase aloud.</p>

    <div class="practice" data-choice-gap-drill data-success-message="Correct. Project uses -s, dish uses -es, country changes y to -ies, and key keeps its y before -s.">
      <h3>Choose the spelling change from memory</h3>
      <p class="choice-hint">Look only at the final letters of each singular noun</p>
      <div class="choice-bank" aria-label="Plural spelling choices">
        <button class="choice-option" data-choice-option="-s" data-value-label-variant="token">add -s</button>
        <button class="choice-option" data-choice-option="-es" data-value-label-variant="token">add -es</button>
        <button class="choice-option" data-choice-option="-ies" data-value-label-variant="token">change y to -ies</button>
      </div>
      <div class="q"><span class="n">1</span><span>two projects: project <button class="choice-gap" data-choice-gap data-answer="-s" data-hint="Project has no special final spelling." data-fix="project + -s → projects" data-placeholder="choose">choose</button></span></div>
      <div class="q"><span class="n">2</span><span>three dishes: dish <button class="choice-gap" data-choice-gap data-answer="-es" data-hint="Dish ends in -sh." data-fix="dish + -es → dishes" data-placeholder="choose">choose</button></span></div>
      <div class="q"><span class="n">3</span><span>four countries: country <button class="choice-gap" data-choice-gap data-answer="-ies" data-hint="Country ends in consonant + y." data-fix="country: drop y, add -ies → countries" data-placeholder="choose">choose</button></span></div>
