---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Regular plural nouns · A0 Grammar",
  "slug": "regular-plural-nouns",
  "level": "A0",
  "topic": "Regular plural nouns",
  "category": "Grammar",
  "contentType": "grammar",
  "status": "ready",
