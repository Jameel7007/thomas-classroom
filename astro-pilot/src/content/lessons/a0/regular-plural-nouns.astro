      <div class="spot-options">
        <button class="error-choice" data-error-choice="customer">customer</button>
        <button class="error-choice" data-error-choice="gave">gave</button>
        <button class="error-choice" data-error-choice="me">me</button>
        <button class="error-choice" data-error-choice="two">two</button>
        <button class="error-choice" data-error-choice="address">address.</button>
