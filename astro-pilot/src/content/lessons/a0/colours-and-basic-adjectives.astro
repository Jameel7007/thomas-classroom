---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Colors and basic adjectives · A0 Vocabulary",
  "slug": "colours-and-basic-adjectives",
  "level": "A0",
  "topic": "Colors & basic adjectives",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Describe everyday people and things with colors and basic adjectives, placing the adjective correctly before a noun or after be.",
  "sequence": 12,
  "prerequisites": [
    "a0/the-verb-to-be",
    "a0/articles-a-an",
    "a0/regular-plural-nouns"
  ],
  "related": [
