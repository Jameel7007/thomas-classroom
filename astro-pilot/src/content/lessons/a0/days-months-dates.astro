---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Days, months, dates · A0 Vocabulary",
  "slug": "days-months-dates",
  "level": "A0",
  "topic": "Days, months, dates",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Name the days and months, understand American-style dates, and use them to discuss meetings, appointments, and deadlines.",
  "sequence": 11,
  "prerequisites": [
    "a0/cardinal-numbers-0-100",
