    <div class="micro-drill" data-spot-error data-answer="on" data-hint="Tomorrow already locates the event in time and does not need a preposition." data-fix="The appointment is tomorrow." data-why="Use no preposition before today, tomorrow, or yesterday. Use on before an exact named day or date, such as on Tuesday.">
      <h3>Repair the time phrase</h3>
      <p>The appointment is on tomorrow. Tap the unnecessary word.</p>
      <div class="spot-options">
        <button class="error-choice" data-error-choice="appointment">appointment</button>
        <button class="error-choice" data-error-choice="is">is</button>
        <button class="error-choice" data-error-choice="on">on</button>
        <button class="error-choice" data-error-choice="tomorrow">tomorrow</button>
