        <div class="quiz-options"><button class="quiz-option" data-quiz-option="on">on</button><button class="quiz-option" data-quiz-option="at">at</button><button class="quiz-option" data-quiz-option="in">in</button></div>
      </div>
      <div class="quiz-item" data-quiz-item data-answer="on" data-hint="The cup touches the shelf’s top surface." data-fix="The cup is on the shelf.">
