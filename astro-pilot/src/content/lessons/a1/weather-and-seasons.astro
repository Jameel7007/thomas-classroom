  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day weather word-family, forecast, and season retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <div class="practice" data-choice-gap-drill data-success-message="Correct. You retrieved a live rain event, the rain noun after chance of, and the Southern Hemisphere season.">
      <h3>Choose the missing weather language before rereading</h3>
      <div class="choice-bank" aria-label="Next-day weather choices">
        <button class="choice-option" data-choice-option="raining">raining</button><button class="choice-option" data-choice-option="rainy">rainy</button>
