---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Hobbies and free time · A1 Vocabulary · Curriculum Map",
  "slug": "hobbies-and-free-time",
  "level": "A1",
  "topic": "Hobbies & free time",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Talk about what you do after work and on weekends. The trick is the verb: we play sports and instruments, we go with -ing activities, and we do a few others — play soccer , go swim",
  "sequence": 16,
  "prerequisites": [],
  "related": [],
  "assessments": [
    "a1-exit"
  ]
});
---
<LessonPage page={page}>
<main class="wrap">
  <p class="kicker"><span class="dot"></span> Vocabulary · Lesson 16</p>
  <h1>Hobbies &amp; <em>free time</em></h1>
  <p class="standfirst">Talk about what you do after work and on weekends. The trick is the verb: we <strong>play</strong> sports and instruments, we <strong>go</strong> with <span class="ex">-ing</span> activities, and we <strong>do</strong> a few others — <span class="ex">play soccer</span>, <span class="ex">go swimming</span>, <span class="ex">do yoga</span>. To say you enjoy it, use <strong>like / love / enjoy</strong> + <span class="ex">-ing</span>: <span class="ex">I like cooking.</span></p>
  <div class="meta-row">
    <span class="tag">≈ 45–55 min</span>
    <span class="tag">play · go · do</span>
    <span class="tag">like / love + -ing</span>
    <span class="tag">10 interactive tasks</span>
  </div>

  <div class="lesson-flow" aria-label="Lesson flow">
    <div class="flow-step"><b>Notice</b><span>Three activities, three different verbs.</span></div>
    <div class="flow-step"><b>Discover</b><span>When is it play, go, or do?</span></div>
    <div class="flow-step"><b>Build</b><span>Match, choose, and build chunks.</span></div>
    <div class="flow-step"><b>Use</b><span>Talk about your weekends and routines.</span></div>
  </div>

  <p class="note-line">After <span class="ex">like</span>, <span class="ex">love</span>, and <span class="ex">enjoy</span>, the next verb takes <span class="ex">-ing</span>: <span class="ex">like cooking</span>, <span class="ex">love running</span>, <span class="ex">enjoy reading</span>. We also add a frequency word to say how often: <span class="ex">always, usually, often, sometimes, never</span>.</p>

  <h2>Two-minute retrieval</h2>
  <div class="lead-rule"></div>
  <div class="practice" data-choice-gap-drill>
    <h3>Three quick checks from earlier lessons</h3>
    <p class="choice-hint">Answer from memory, then check. Say each complete sentence aloud.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="on">on</button>
      <button class="choice-option" data-choice-option="in">in</button>
      <button class="choice-option" data-choice-option="some">some</button>
      <button class="choice-option" data-choice-option="any">any</button>
      <button class="choice-option" data-choice-option="plays">plays</button>
      <button class="choice-option" data-choice-option="play">play</button>
    </div>
    <div class="q"><span class="n">1</span><span>The lamp is <button class="choice-gap" data-choice-gap data-answer="on" data-placeholder="choose">choose</button> the desk. &nbsp;<span class="contraction">(previous lesson · place word)</span></span></div>
    <div class="q"><span class="n">2</span><span>Can I have <button class="choice-gap" data-choice-gap data-answer="some" data-placeholder="choose">choose</button> water, please? &nbsp;<span class="contraction">(older lesson · polite request)</span></span></div>
    <div class="q"><span class="n">3</span><span>She <button class="choice-gap" data-choice-gap data-answer="plays" data-placeholder="choose">choose</button> soccer on Saturdays. &nbsp;<span class="contraction">(common contrast · she + verb-s)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Meet the hobbies</h2>
  <div class="lead-rule"></div>
  <p>Free-time activities. Which ones are yours?</p>
  <div class="figure-grid">
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/soccer-ball.svg" alt="" loading="lazy" /></span><span class="nm">soccer</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/basketball.svg" alt="" loading="lazy" /></span><span class="nm">basketball</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/book.svg" alt="" loading="lazy" /></span><span class="nm">reading</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/guitar.svg" alt="" loading="lazy" /></span><span class="nm">guitar</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/headphones.svg" alt="" loading="lazy" /></span><span class="nm">music</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/video-game.svg" alt="" loading="lazy" /></span><span class="nm">video games</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/bicycle.svg" alt="" loading="lazy" /></span><span class="nm">biking</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/camera.svg" alt="" loading="lazy" /></span><span class="nm">photography</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/swimming.svg" alt="" loading="lazy" /></span><span class="nm">swimming</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/running.svg" alt="" loading="lazy" /></span><span class="nm">running</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/painting.svg" alt="" loading="lazy" /></span><span class="nm">painting</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/movies.svg" alt="" loading="lazy" /></span><span class="nm">movies</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/chess.svg" alt="" loading="lazy" /></span><span class="nm">chess</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/cooking.svg" alt="" loading="lazy" /></span><span class="nm">cooking</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/gardening.svg" alt="" loading="lazy" /></span><span class="nm">gardening</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/fishing.svg" alt="" loading="lazy" /></span><span class="nm">fishing</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/yoga.svg" alt="" loading="lazy" /></span><span class="nm">yoga</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/tennis.svg" alt="" loading="lazy" /></span><span class="nm">tennis</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/table-tennis.svg" alt="" loading="lazy" /></span><span class="nm">table tennis</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/volleyball.svg" alt="" loading="lazy" /></span><span class="nm">volleyball</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/golf.svg" alt="" loading="lazy" /></span><span class="nm">golf</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/skiing.svg" alt="" loading="lazy" /></span><span class="nm">skiing</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/dancer.svg" alt="" loading="lazy" /></span><span class="nm">dancing</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/airplane.svg" alt="" loading="lazy" /></span><span class="nm">traveling</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/board-games.svg" alt="" loading="lazy" /></span><span class="nm">board games</span></div>
  </div>

  <h2>Notice before the rule</h2>
  <div class="lead-rule"></div>
  <div class="thinking-card">
    <h3>Read about Marco's free time</h3>
    <p><span class="ex">"After work I usually go running in the park. On weekends I play soccer with friends, and on Sunday mornings I do yoga. I also love cooking for my family."</span></p>
    <ul>
      <li>Three activities use three different verbs: <strong>go</strong> running, <strong>play</strong> soccer, <strong>do</strong> yoga. Which verb goes with the activity that ends in <span class="ex">-ing</span>?</li>
      <li>Look at <span class="ex">play soccer</span>. Soccer is a sport. What kind of word do you think follows <strong>play</strong>?</li>
      <li>In <span class="ex">love cooking</span>, why is it <span class="ex">cooking</span> and not <span class="ex">cook</span>? What word comes just before it?</li>
    </ul>
  </div>

  <div class="practice" data-choice-gap-drill>
    <h3>Discovery check — read the clue, then choose the verb</h3>
    <p class="choice-hint">The activity in the sentence tells you which verb fits</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="play">play</button>
      <button class="choice-option" data-choice-option="go">go</button>
      <button class="choice-option" data-choice-option="do">do</button>
    </div>
    <div class="q"><span class="n">1</span><span>I <button class="choice-gap" data-choice-gap data-answer="play" data-placeholder="choose">choose</button> soccer with friends. &nbsp;<span class="contraction">(a sport)</span></span></div>
    <div class="q"><span class="n">2</span><span>I <button class="choice-gap" data-choice-gap data-answer="go" data-placeholder="choose">choose</button> swimming after work. &nbsp;<span class="contraction">(an -ing activity)</span></span></div>
    <div class="q"><span class="n">3</span><span>I <button class="choice-gap" data-choice-gap data-answer="do" data-placeholder="choose">choose</button> yoga on Sundays. &nbsp;<span class="contraction">(not play, not -ing)</span></span></div>
    <div class="q"><span class="n">4</span><span>I <button class="choice-gap" data-choice-gap data-answer="play" data-placeholder="choose">choose</button> the guitar in the evening. &nbsp;<span class="contraction">(an instrument)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>The system: play, go, or do?</h2>
  <div class="lead-rule"></div>
  <p>Each activity has one usual verb. Learn the activity and the verb together as a chunk:</p>
  <p><strong>play</strong> &nbsp;→&nbsp; sports and instruments. <br /><strong>go</strong> &nbsp;→&nbsp; activities that end in <span class="ex">-ing</span>. <br /><strong>do</strong> &nbsp;→&nbsp; a few others (exercise, yoga).</p>
  <table>
    <thead><tr><th>verb</th><th>when</th><th>examples</th></tr></thead>
    <tbody>
      <tr><td><b>play</b></td><td>a sport or an instrument</td><td><span class="contraction">play soccer · play tennis · play the guitar</span></td></tr>
      <tr><td><b>go</b></td><td>activity ending in <span class="ex">-ing</span></td><td><span class="contraction">go swimming · go running · go hiking</span></td></tr>
      <tr><td><b>do</b></td><td>exercise and a few set phrases</td><td><span class="contraction">do yoga · do exercise</span></td></tr>
    </tbody>
  </table>

  <div class="note">
    <h3>Meaning check</h3>
    <ul>
      <li>Why is it <span class="ex">go swimming</span>, not <span class="ex">go to swim</span>? After <strong>go</strong> for a free-time activity, we use the <span class="ex">-ing</span> form: <span class="ex">go swimming, go running, go hiking</span>.</li>
      <li>After <span class="ex">like</span>, <span class="ex">love</span>, and <span class="ex">enjoy</span>, what form follows? The <span class="ex">-ing</span> form: <span class="ex">I like cooking. She enjoys reading.</span> Not <span class="ex">I like cook.</span></li>
      <li>Where does the frequency word go? Before the main verb: <span class="ex">I <b>sometimes</b> go swimming.</span> &nbsp;<span class="ex">She <b>never</b> plays soccer.</span></li>
    </ul>
  </div>

  <h2>Say you enjoy it: <em>like / love / enjoy</em> + -ing</h2>
  <div class="lead-rule"></div>
  <p>To say how you feel about an activity, start with <strong>like</strong>, <strong>love</strong>, or <strong>enjoy</strong>, then add the <span class="ex">-ing</span> form:</p>
  <p><span class="ex">I like cooking. &nbsp; · &nbsp; She loves running. &nbsp; · &nbsp; They enjoy traveling.</span></p>
  <p>Add a frequency word to say how often you do it:</p>
  <p><span class="ex">I usually go to the gym. &nbsp; · &nbsp; He often plays the guitar. &nbsp; · &nbsp; We sometimes go hiking.</span></p>

  <div class="practice" data-choice-gap-drill>
    <h3>Drill 1 — choose the -ing form</h3>
    <p class="choice-hint">After like / love / enjoy, the verb takes <b>-ing</b></p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="cooking">cooking</button>
      <button class="choice-option" data-choice-option="reading">reading</button>
      <button class="choice-option" data-choice-option="running">running</button>
      <button class="choice-option" data-choice-option="swimming">swimming</button>
      <button class="choice-option" data-choice-option="traveling">traveling</button>
      <button class="choice-option" data-choice-option="painting">painting</button>
    </div>
    <div class="q"><span class="n">1</span><span>I like <button class="choice-gap" data-choice-gap data-answer="cooking" data-placeholder="choose">choose</button> dinner for my family. &nbsp;<span class="contraction">(make food)</span></span></div>
    <div class="q"><span class="n">2</span><span>She enjoys <button class="choice-gap" data-choice-gap data-answer="reading" data-placeholder="choose">choose</button> novels in the evening. &nbsp;<span class="contraction">(books)</span></span></div>
    <div class="q"><span class="n">3</span><span>He loves <button class="choice-gap" data-choice-gap data-answer="running" data-placeholder="choose">choose</button> in the park before work. &nbsp;<span class="contraction">(go + this)</span></span></div>
    <div class="q"><span class="n">4</span><span>We enjoy <button class="choice-gap" data-choice-gap data-answer="traveling" data-placeholder="choose">choose</button> to new countries. &nbsp;<span class="contraction">(visiting places)</span></span></div>
    <div class="q"><span class="n">5</span><span>My coworker likes <button class="choice-gap" data-choice-gap data-answer="painting" data-placeholder="choose">choose</button> with watercolors. &nbsp;<span class="contraction">(art)</span></span></div>
    <div class="q"><span class="n">6</span><span>They love <button class="choice-gap" data-choice-gap data-answer="swimming" data-placeholder="choose">choose</button> at the pool on weekends. &nbsp;<span class="contraction">(go + this)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Build the chunk, then the sentence</h2>
  <div class="lead-rule"></div>

  <div class="tile-game" data-tile-game>
    <h3>Drill 2 — match each activity to its verb</h3>
    <p class="tile-target">Tap a verb, then tap the activity that goes with it</p>
    <div class="tile-bank">
      <button class="tile" data-tile="soccer">play</button>
      <button class="tile" data-tile="swimming">go</button>
      <button class="tile" data-tile="yoga">do</button>
      <button class="tile" data-tile="guitar">play</button>
    </div>
    <div class="slot-board">
      <button class="slot" data-slot="soccer" data-placeholder="___ soccer (a sport)">___ soccer (a sport)</button>
      <button class="slot" data-slot="swimming" data-placeholder="___ swimming (-ing activity)">___ swimming (-ing activity)</button>
      <button class="slot" data-slot="yoga" data-placeholder="___ yoga (exercise)">___ yoga (exercise)</button>
      <button class="slot" data-slot="guitar" data-placeholder="___ the guitar (an instrument)">___ the guitar (an instrument)</button>
    </div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-tiles>Check</button>
      <button class="lesson-btn" data-reset-tiles>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <div class="tile-game" data-tile-builder data-answer="i like playing the guitar">
    <h3>Drill 3 — build the sentence</h3>
    <p class="tile-target">Say how you feel about the instrument. Build the sentence, then say it.</p>
    <div class="tile-bank" data-build-bank>
      <button class="tile" data-build-tile="guitar">guitar</button>
      <button class="tile" data-build-tile="i">I</button>
      <button class="tile" data-build-tile="playing">playing</button>
      <button class="tile" data-build-tile="like">like</button>
      <button class="tile" data-build-tile="the">the</button>
    </div>
    <div class="build-area" data-build-area data-placeholder="Tap words in order"></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-build>Check</button>
      <button class="lesson-btn" data-reset-build>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <div class="tile-game" data-tile-builder data-answer="she goes running on weekends">
    <h3>Drill 4 — build the sentence with how often</h3>
    <p class="tile-target">Say when she runs. Use <span class="ex">goes</span> for she, and put the time at the end.</p>
    <div class="tile-bank" data-build-bank>
      <button class="tile" data-build-tile="running">running</button>
      <button class="tile" data-build-tile="she">She</button>
      <button class="tile" data-build-tile="weekends">weekends</button>
      <button class="tile" data-build-tile="goes">goes</button>
      <button class="tile" data-build-tile="on">on</button>
    </div>
    <div class="build-area" data-build-area data-placeholder="Tap words in order"></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-build>Check</button>
      <button class="lesson-btn" data-reset-build>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Notice and repair errors</h2>
  <div class="lead-rule"></div>
  <div class="micro-drill" data-spot-error data-answer="play" data-fix="I like playing tennis." data-why="After like, the next verb takes -ing. We say like playing, not like play.">
    <h3>Drill 5 — which form after like?</h3>
    <p>Tap the word that is wrong.</p>
    <div class="spot-options">
      <button class="error-choice" data-error-choice="i">I</button>
      <button class="error-choice" data-error-choice="like">like</button>
      <button class="error-choice" data-error-choice="play">play</button>
      <button class="error-choice" data-error-choice="tennis">tennis.</button>
    </div>
    <p class="hidden-answer" data-error-feedback></p>
  </div>

  <div class="micro-drill" data-spot-error data-answer="swim" data-fix="On Saturdays I go swimming." data-why="After go for this free-time activity, use the -ing form: go swimming, not go swim.">
    <h3>Drill 6 — go + which form?</h3>
    <p>Tap the word that needs the <span class="ex">-ing</span> form.</p>
    <div class="spot-options">
      <button class="error-choice" data-error-choice="on">On</button>
      <button class="error-choice" data-error-choice="saturdays">Saturdays</button>
      <button class="error-choice" data-error-choice="i">I</button>
      <button class="error-choice" data-error-choice="go">go</button>
      <button class="error-choice" data-error-choice="swim">swim.</button>
    </div>
    <p class="hidden-answer" data-error-feedback></p>
  </div>

  <div class="micro-drill" data-transform>
    <h3>Drill 7 — say you enjoy it, then say it aloud</h3>
    <p>Turn the activity into a full sentence with <span class="ex">I like</span> + <span class="ex">-ing</span>. Say it first, then reveal.</p>
    <div class="transform-list">
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>1</b> cook &nbsp;→&nbsp; I like…</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>I like cooking.</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>2</b> read &nbsp;→&nbsp; I like…</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>I like reading.</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>3</b> hike &nbsp;→&nbsp; I like…</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>I like hiking.</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>4</b> play soccer &nbsp;→&nbsp; I like…</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>I like playing soccer.</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>5</b> listen to music &nbsp;→&nbsp; I like…</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>I like listening to music.</strong></p>
      </div>
    </div>
  </div>

  <h2>Read and choose</h2>
  <div class="lead-rule"></div>
  <div class="thinking-card">
    <h3>My weekend</h3>
    <p><span class="ex">“On Saturday morning I play soccer with friends. In the afternoon I read or play the guitar. On Sunday my wife and I ride our bikes by the river, and in the evening we watch a movie.”</span></p>
  </div>
  <div class="quiz" data-quiz data-success-message="Good reading. You understood a real weekend plan.">
    <h3>Read, then choose</h3>
    <div class="quiz-list">
      <div class="quiz-item" data-quiz-item data-answer="on Saturday morning">
        <p class="quiz-question">1. When does the writer play soccer?</p>
        <div class="quiz-options"><button class="quiz-option" data-quiz-option="on Saturday morning">on Saturday morning</button><button class="quiz-option" data-quiz-option="on Sunday evening">on Sunday evening</button><button class="quiz-option" data-quiz-option="on Saturday afternoon">on Saturday afternoon</button></div>
      </div>
      <div class="quiz-item" data-quiz-item data-answer="the guitar">
        <p class="quiz-question">2. What does the writer play at home?</p>
        <div class="quiz-options"><button class="quiz-option" data-quiz-option="the guitar">the guitar</button><button class="quiz-option" data-quiz-option="video games">video games</button><button class="quiz-option" data-quiz-option="basketball">basketball</button></div>
      </div>
      <div class="quiz-item" data-quiz-item data-answer="watch a movie">
        <p class="quiz-question">3. What do they do on Sunday evening?</p>
        <div class="quiz-options"><button class="quiz-option" data-quiz-option="watch a movie">watch a movie</button><button class="quiz-option" data-quiz-option="ride bikes">ride bikes</button><button class="quiz-option" data-quiz-option="play soccer">play soccer</button></div>
      </div>
    </div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-quiz>Check</button>
      <button class="lesson-btn" data-reset-quiz>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Use it in real life</h2>
  <div class="lead-rule"></div>
  <div class="prompt-card"><b>Your hobbies:</b> Name three things you do in your free time, each in a full sentence. <span class="ex">I like cooking. I play tennis. I go hiking on weekends.</span></div>
  <div class="prompt-card"><b>After work:</b> Say what you usually do after work. Use a frequency word. <span class="ex">After work I usually go to the gym.</span> &nbsp;<span class="ex">I often listen to music.</span></div>
  <div class="prompt-card"><b>Your weekend:</b> Describe a typical weekend. <span class="ex">On Saturdays I go running. On Sundays I sometimes do yoga and watch movies.</span></div>
  <div class="prompt-card"><b>How often?</b> The teacher names an activity; you say how often you do it. <span class="ex">go swimming → I never go swimming.</span> &nbsp;<span class="ex">play soccer → I sometimes play soccer.</span></div>
  <div class="prompt-card"><b>Find a partner:</b> Ask and answer to find a shared hobby. <span class="ex">Do you like cooking? What do you do on weekends? How often do you go to the gym?</span></div>

  <h2>Reflect</h2>
  <div class="lead-rule"></div>
  <div class="thinking-card">
    <h3>Say the verbs back</h3>
    <p>Complete this aloud: “For a sport or an instrument I use ______. For an activity ending in <span class="ex">-ing</span> I use ______. For yoga and exercise I use ______. After <strong>like</strong>, <strong>love</strong>, and <strong>enjoy</strong>, the next verb ends in ______.”</p>
    <p>Then say two true sentences: one about a hobby you love, and one about something you never do, with a frequency word in each.</p>
  </div>

  <div class="quiz" data-quiz data-success-message="Great. You can choose play, go, or do, use like / love / enjoy + -ing, and say how often with a frequency word.">
