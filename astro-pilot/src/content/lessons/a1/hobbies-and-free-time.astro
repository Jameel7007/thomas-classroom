  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day activity chunk, verb-form, and availability retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <div class="practice" data-choice-gap-drill data-success-message="Correct. You retrieved an independent activity verb, the required form after enjoy, and availability language.">
      <h3>Choose the missing free-time language</h3>
      <div class="choice-bank" aria-label="Next-day free-time choices">
        <button class="choice-option" data-choice-option="read">read</button><button class="choice-option" data-choice-option="go">go</button>
        <button class="choice-option" data-choice-option="playing">playing</button><button class="choice-option" data-choice-option="to play">to play</button>
