export const page = defineLesson({
  "title": "Possessive noun ’s · A1 Grammar",
  "slug": "possessive-noun-s",
  "level": "A1",
  "topic": "Possessive noun ’s",
  "category": "Grammar",
  "contentType": "grammar",
  "status": "ready",
  "description": "Use noun + ’s to connect people, organizations, places, and things, and distinguish possession from the contraction of is.",
