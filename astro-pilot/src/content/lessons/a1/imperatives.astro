      <button class="choice-option" data-choice-option="she">she</button>
      <button class="choice-option" data-choice-option="can">can</button>
      <button class="choice-option" data-choice-option="can’t">can’t</button>
      <button class="choice-option" data-choice-option="between">between</button>
