  <h2>Notice and repair errors</h2>
  <div class="lead-rule"></div>
  <div class="micro-drill" data-spot-error data-answer="try-on-them" data-hint="A short object pronoun goes between try and on." data-fix="Can I try them on?" data-why="Try on is separable, and a pronoun must occupy the middle position: try them on, not try on them." data-success-message="Correct. You placed the plural object pronoun inside the separable verb.">
