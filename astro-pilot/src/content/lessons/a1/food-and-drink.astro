    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/water.svg" alt="" loading="lazy" /></span><span class="nm">water</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/orange.svg" alt="" loading="lazy" /></span><span class="nm">orange</span></div>
