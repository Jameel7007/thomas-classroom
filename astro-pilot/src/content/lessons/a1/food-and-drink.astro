---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Food and drink · A1 Vocabulary · Curriculum Map",
  "slug": "food-and-drink",
  "level": "A1",
  "topic": "Food & drink",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Order in a cafe, shop for groceries, talk about your meals. Learn the everyday food and drink words, then choose a / an for one thing you can count and some / any for an amount: a ",
  "sequence": 14,
  "prerequisites": [],
  "related": [],
  "assessments": [
    "a1-exit"
  ]
});
---
<LessonPage page={page}>
<main class="wrap">
  <p class="kicker"><span class="dot"></span> Vocabulary · Lesson 14</p>
  <h1>Food &amp; <em>drink</em></h1>
  <p class="standfirst">Order in a cafe, shop for groceries, talk about your meals. Learn the everyday food and drink words, then choose <strong>a / an</strong> for one thing you can count and <strong>some / any</strong> for an amount: <span class="ex">a sandwich</span>, <span class="ex">an apple</span>, <span class="ex">some water</span>, <span class="ex">Is there any milk?</span></p>
  <div class="meta-row">
    <span class="tag">≈ 45–55 min</span>
    <span class="tag">countable / uncountable</span>
    <span class="tag">a · an · some · any</span>
    <span class="tag">9 interactive tasks</span>
  </div>

  <div class="lesson-flow" aria-label="Lesson flow">
    <div class="flow-step"><b>Notice</b><span>Read a short cafe order.</span></div>
    <div class="flow-step"><b>Discover</b><span>Things you count vs. amounts you don't.</span></div>
    <div class="flow-step"><b>Build</b><span>Sort, choose, and build chunks.</span></div>
    <div class="flow-step"><b>Use</b><span>Order food and talk about meals.</span></div>
  </div>

  <p class="note-line">Three meals a day: <span class="ex">breakfast</span> (morning), <span class="ex">lunch</span> (midday), <span class="ex">dinner</span> (evening). To order politely, use <span class="ex">I'd like…</span>, <span class="ex">Can I have…?</span>, and answer <span class="ex">Would you like…?</span></p>

  <h2>Two-minute retrieval</h2>
  <div class="lead-rule"></div>
  <div class="practice" data-choice-gap-drill>
    <h3>Three quick checks from earlier lessons</h3>
    <p class="choice-hint">Answer from memory, then check. Say each complete sentence aloud.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="as">as</button>
      <button class="choice-option" data-choice-option="at">at</button>
      <button class="choice-option" data-choice-option="half past">half past</button>
      <button class="choice-option" data-choice-option="quarter to">quarter to</button>
      <button class="choice-option" data-choice-option="a">a</button>
      <button class="choice-option" data-choice-option="an">an</button>
    </div>
    <div class="q"><span class="n">1</span><span>Luis works <button class="choice-gap" data-choice-gap data-answer="as" data-placeholder="choose">choose</button> a chef. &nbsp;<span class="contraction">(previous lesson · job)</span></span></div>
    <div class="q"><span class="n">2</span><span>I have lunch at 12:30 — <button class="choice-gap" data-choice-gap data-answer="half past" data-placeholder="choose">choose</button> twelve. &nbsp;<span class="contraction">(older lesson · telling the time)</span></span></div>
    <div class="q"><span class="n">3</span><span>Mina is <button class="choice-gap" data-choice-gap data-answer="an" data-placeholder="choose">choose</button> accountant. &nbsp;<span class="contraction">(common contrast · a or an)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Meet the food</h2>
  <div class="lead-rule"></div>
  <p>Everyday food and drinks. Say each one aloud with <span class="ex">I like…</span> or <span class="ex">I don’t like…</span></p>
