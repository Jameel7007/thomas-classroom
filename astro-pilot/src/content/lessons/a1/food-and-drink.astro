  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day food, portion, and service retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <div class="practice" data-choice-gap-drill data-success-message="Correct. You retrieved the preference-request contrast, one-serving frame, and neutral inventory use of any.">
      <h3>Choose the missing food-service language</h3>
      <div class="choice-bank" aria-label="Next-day food-service choices">
