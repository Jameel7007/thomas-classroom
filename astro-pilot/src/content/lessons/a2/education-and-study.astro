  <div class="lead-rule"></div>
  <div class="tile-game" data-tile-builder data-answer="i study for thirty minutes and then practice one update" data-hint="Use study for the time with course material, then practice for the repeated performance." data-fix="I study for thirty minutes and then practice one update." data-success-message="Correct. Study presents time with the material, and practice presents the repeated performance.">
