    <div class="tile-bank" data-build-bank><button class="tile" data-build-tile="practice">practice</button><button class="tile" data-build-tile="minutes">minutes</button><button class="tile" data-build-tile="i">I</button><button class="tile" data-build-tile="update">update</button><button class="tile" data-build-tile="study">study</button><button class="tile" data-build-tile="then">then</button><button class="tile" data-build-tile="one">one</button><button class="tile" data-build-tile="for">for</button><button class="tile" data-build-tile="and">and</button><button class="tile" data-build-tile="thirty">thirty</button></div>
