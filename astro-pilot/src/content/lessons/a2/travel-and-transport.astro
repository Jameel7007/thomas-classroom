        <div class="quiz-options"><button class="quiz-option" data-quiz-option="on">on</button><button class="quiz-option" data-quiz-option="by">by</button><button class="quiz-option" data-quiz-option="in">in</button></div>
      </div>
      <div class="quiz-item" data-quiz-item data-answer="miss">
