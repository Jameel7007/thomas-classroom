  <section id="next-day-retrieval" data-lesson-extension="Five-minute next-day core complement, second performer, and prepositional-to retrieval">
    <h2>Next-day retrieval</h2>
    <div class="lead-rule"></div>
    <div class="practice" data-choice-gap-drill data-success-message="Correct. You retrieved the -ing complement, person plus to-infinitive, and prepositional-to pattern.">
      <h3>Choose from memory before looking back</h3>
      <div class="choice-bank" aria-label="Next-day verb pattern choices"><button class="choice-option" data-choice-option="solving">solving</button><button class="choice-option" data-choice-option="to solve">to solve</button><button class="choice-option" data-choice-option="Leo to test">Leo to test</button><button class="choice-option" data-choice-option="to Leo test">to Leo test</button><button class="choice-option" data-choice-option="welcoming">welcoming</button><button class="choice-option" data-choice-option="welcome">welcome</button></div>
