  <div class="lead-rule"></div>
  <div class="tile-game" data-tile-builder data-answer="turn left at the second light onto pine avenue" data-hint="Order the side, exact turn point, and new street after the imperative Turn." data-fix="Turn left at the second light onto Pine Avenue." data-success-message="Correct. The instruction names the turn side, exact point, and street entered.">
