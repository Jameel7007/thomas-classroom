---
import LessonPage from "../../../components/lesson/LessonPage.astro";
import { defineLesson } from "../../../data/lesson-schema.mjs";
export const page = defineLesson({
  "title": "Town & directions · A2 Vocabulary · Curriculum Map",
  "slug": "town-and-directions",
  "level": "A2",
  "topic": "Town & directions",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Find your way around town in English. Learn the places you pass every day, then give and follow directions with chunks you can trust: turn left , go straight , go past the bank , a",
  "sequence": 14,
  "prerequisites": [],
  "related": [],
  "assessments": [
    "a2-exit"
  ]
});
---
<LessonPage page={page}>
<main class="wrap">
  <p class="kicker"><span class="dot"></span> Vocabulary · Lesson 14</p>
  <h1>Town &amp; <em>directions</em></h1>
  <p class="standfirst">Find your way around town in English. Learn the places you pass every day, then give and follow directions with chunks you can trust: <span class="ex">turn left</span>, <span class="ex">go straight</span>, <span class="ex">go past the bank</span>, <span class="ex">across from the park</span>.</p>
  <div class="meta-row">
    <span class="tag">≈ 45–55 min</span>
    <span class="tag">places in town</span>
    <span class="tag">direction · position chunks</span>
    <span class="tag">11 interactive tasks</span>
  </div>

  <div class="lesson-flow" aria-label="Lesson flow">
    <div class="flow-step"><b>Notice</b><span>Read a short street conversation.</span></div>
    <div class="flow-step"><b>Discover</b><span>Moving chunks vs. sitting chunks.</span></div>
    <div class="flow-step"><b>Build</b><span>Choose, type, and build directions.</span></div>
    <div class="flow-step"><b>Use</b><span>Ask for and give real directions.</span></div>
  </div>

  <p class="note-line">Directions are imperatives from A1: start with the verb, no subject. <span class="ex">Turn left.</span> <span class="ex">Go straight.</span> Open politely with <span class="ex">Excuse me…</span> and close with <span class="ex">Thanks so much!</span></p>

  <h2>Two-minute retrieval</h2>
  <div class="lead-rule"></div>
  <div class="practice" data-choice-gap-drill>
    <h3>Three quick checks from earlier lessons</h3>
    <p class="choice-hint">Answer from memory, then check. Say each complete sentence aloud.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="is there">Is there</button>
      <button class="choice-option" data-choice-option="there is">There is</button>
      <button class="choice-option" data-choice-option="on">on</button>
      <button class="choice-option" data-choice-option="in">in</button>
      <button class="choice-option" data-choice-option="open">Open</button>
      <button class="choice-option" data-choice-option="opens">Opens</button>
    </div>
    <div class="q"><span class="n">1</span><span><button class="choice-gap" data-choice-gap data-answer="is there" data-placeholder="choose">choose</button> a pharmacy near here? &nbsp;<span class="contraction">(A1 · there is / there are)</span></span></div>
    <div class="q"><span class="n">2</span><span>The store is <button class="choice-gap" data-choice-gap data-answer="on" data-placeholder="choose">choose</button> Main Street, next to the bank. &nbsp;<span class="contraction">(A1 · prepositions of place)</span></span></div>
    <div class="q"><span class="n">3</span><span><button class="choice-gap" data-choice-gap data-answer="open" data-placeholder="choose">choose</button> the map, please. &nbsp;<span class="contraction">(A1 · imperatives start with the verb)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Meet the town</h2>
  <div class="lead-rule"></div>
  <p>Places you pass every day. Say each one aloud with <span class="ex">There’s a … on my street.</span> or <span class="ex">There isn’t a … near here.</span></p>
  <div class="figure-grid">
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/bank.svg" alt="" loading="lazy" /></span><span class="nm">bank</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/hospital.svg" alt="" loading="lazy" /></span><span class="nm">hospital</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/school.svg" alt="" loading="lazy" /></span><span class="nm">school</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/hotel.svg" alt="" loading="lazy" /></span><span class="nm">hotel</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/store.svg" alt="" loading="lazy" /></span><span class="nm">store</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/office.svg" alt="" loading="lazy" /></span><span class="nm">office building</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/house.svg" alt="" loading="lazy" /></span><span class="nm">house</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/church.svg" alt="" loading="lazy" /></span><span class="nm">church</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/post-office.svg" alt="" loading="lazy" /></span><span class="nm">post office</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/fire-truck.svg" alt="" loading="lazy" /></span><span class="nm">fire station</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/police-car.svg" alt="" loading="lazy" /></span><span class="nm">police station</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/gas-station.svg" alt="" loading="lazy" /></span><span class="nm">gas station</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/park.svg" alt="" loading="lazy" /></span><span class="nm">park</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/bus-stop.svg" alt="" loading="lazy" /></span><span class="nm">bus stop</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/museum.svg" alt="" loading="lazy" /></span><span class="nm">museum</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/cinema.svg" alt="" loading="lazy" /></span><span class="nm">movie theater</span></div>
  </div>

  <h2>Meet the directions</h2>
  <div class="lead-rule"></div>
  <p>The moves and street signs you need. Point the way with your hand as you say each one aloud.</p>
  <div class="figure-grid">
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/left-arrow.svg" alt="" loading="lazy" /></span><span class="nm">turn left</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/right-arrow.svg" alt="" loading="lazy" /></span><span class="nm">turn right</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/up-arrow.svg" alt="" loading="lazy" /></span><span class="nm">go straight</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/traffic-light.svg" alt="" loading="lazy" /></span><span class="nm">traffic light</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/stop-sign.svg" alt="" loading="lazy" /></span><span class="nm">stop sign</span></div>
    <div class="figure"><span class="fig"><img src="/assets/lessons/img/noto/location.svg" alt="" loading="lazy" /></span><span class="nm">location</span></div>
  </div>

  <h2>Notice before the rule</h2>
  <div class="lead-rule"></div>
  <div class="thinking-card">
    <h3>Read the street conversation</h3>
    <p><span class="ex">“Excuse me, how do I get to the museum?” “Sure. Go straight for two blocks and turn left at the traffic light. Go past the bank, and the museum is on the right, across from the park.” “Thanks so much!” “No problem.”</span></p>
    <ul>
      <li>Look at <span class="ex">Go straight</span>, <span class="ex">turn left</span>, <span class="ex">Go past</span>. They start with the verb and have no subject. Where did you see that pattern in A1?</li>
      <li>The question opens with two polite words before <span class="ex">how do I get to…?</span> Which two words? Why not just <span class="ex">Where is the museum?</span> to a stranger?</li>
      <li>Now look at <span class="ex">across from the park</span>. Does that chunk tell you a direction to move, or a position where the museum sits?</li>
    </ul>
  </div>

  <div class="practice" data-choice-gap-drill>
    <h3>Discovery check · read the cue, then choose</h3>
    <p class="choice-hint">Moving chunks start with a verb: <b>turn</b>, <b>go</b>. Sitting chunks describe a position: <b>on the right</b>, <b>across from</b>.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="turn">turn</button>
      <button class="choice-option" data-choice-option="go">go</button>
      <button class="choice-option" data-choice-option="past">past</button>
      <button class="choice-option" data-choice-option="on">on</button>
      <button class="choice-option" data-choice-option="at">at</button>
      <button class="choice-option" data-choice-option="across from">across from</button>
      <button class="choice-option" data-choice-option="next to">next to</button>
      <button class="choice-option" data-choice-option="excuse me">Excuse me</button>
    </div>
    <div class="q"><span class="n">1</span><span>Please <button class="choice-gap" data-choice-gap data-answer="turn" data-placeholder="choose">choose</button> left at the traffic light. &nbsp;<span class="contraction">(change direction · not go)</span></span></div>
    <div class="q"><span class="n">2</span><span>Then <button class="choice-gap" data-choice-gap data-answer="go" data-placeholder="choose">choose</button> straight for two blocks. &nbsp;<span class="contraction">(keep moving · don’t turn)</span></span></div>
    <div class="q"><span class="n">3</span><span>Go <button class="choice-gap" data-choice-gap data-answer="past" data-placeholder="choose">choose</button> the bank and keep walking. &nbsp;<span class="contraction">(continue beyond it)</span></span></div>
    <div class="q"><span class="n">4</span><span>The museum is <button class="choice-gap" data-choice-gap data-answer="on" data-placeholder="choose">choose</button> the right. &nbsp;<span class="contraction">(chunk · ___ the right, ___ the left)</span></span></div>
    <div class="q"><span class="n">5</span><span>The museum is <button class="choice-gap" data-choice-gap data-answer="across from" data-placeholder="choose">choose</button> the park. &nbsp;<span class="contraction">(position · on the other side of the street)</span></span></div>
    <div class="q"><span class="n">6</span><span><button class="choice-gap" data-choice-gap data-answer="excuse me" data-placeholder="choose">choose</button>, how do I get to the museum? &nbsp;<span class="contraction">(polite opener to a stranger)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>The system: moving chunks and sitting chunks</h2>
  <div class="lead-rule"></div>
  <p>Some chunks <strong>move you</strong> through town. They are imperatives, so they start with the verb: <span class="ex">turn left</span>, <span class="ex">turn right</span>, <span class="ex">go straight</span>, <span class="ex">go past the bank</span>, <span class="ex">take the first street on the left</span>.</p>
  <p>Other chunks <strong>tell you where a place sits</strong>. They come after <span class="ex">is</span>: <span class="ex">next to</span>, <span class="ex">across from</span>, <span class="ex">between … and …</span>, <span class="ex">on the corner of … and …</span></p>
  <table>
    <thead><tr><th>direction chunks <span class="contraction">move</span></th><th>position chunks <span class="contraction">sit</span></th></tr></thead>
    <tbody>
      <tr><td><b>turn left / turn right</b> &nbsp;<span class="contraction">at the traffic light</span></td><td><b>next to</b> &nbsp;<span class="contraction">the pharmacy is next to the hotel</span></td></tr>
      <tr><td><b>go straight</b> &nbsp;<span class="contraction">for two blocks</span></td><td><b>across from</b> &nbsp;<span class="contraction">the museum is across from the park</span></td></tr>
      <tr><td><b>go past the bank</b> &nbsp;<span class="contraction">continue beyond it</span></td><td><b>between … and …</b> &nbsp;<span class="contraction">between the bank and the café</span></td></tr>
      <tr><td><b>take the first street on the left</b> &nbsp;<span class="contraction">also: take the second street</span></td><td><b>on the corner of … and …</b> &nbsp;<span class="contraction">where two streets meet</span></td></tr>
    </tbody>
  </table>

  <div class="note">
    <h3>Meaning check</h3>
    <ul>
      <li>Say <span class="ex">turn left</span>, never <span class="ex">turn to left</span>. The chunk is complete: <span class="ex">turn left, turn right, go straight</span>.</li>
      <li>Say <span class="ex">next to</span>, never <span class="ex">next of</span>: <span class="ex">The café is next to the hotel.</span></li>
      <li><span class="ex">A block</span> is the distance from one street to the next. <span class="ex">Go straight for two blocks</span> means pass two streets.</li>
      <li>Directions reuse A1 imperatives: verb first, no subject. Compare <span class="ex">Open the door.</span> with <span class="ex">Take the first street on the left.</span></li>
    </ul>
  </div>

  <div class="practice" data-choice-gap-drill>
    <h3>Drill 1 · choose the chunk</h3>
    <p class="choice-hint">Read the cue in parentheses first. Moving chunks follow a verb pattern; sitting chunks follow <b>is</b>.</p>
    <div class="choice-bank" aria-label="Answer choices">
      <button class="choice-option" data-choice-option="turn">turn</button>
      <button class="choice-option" data-choice-option="go">go</button>
      <button class="choice-option" data-choice-option="past">past</button>
      <button class="choice-option" data-choice-option="take">take</button>
      <button class="choice-option" data-choice-option="next to">next to</button>
      <button class="choice-option" data-choice-option="across from">across from</button>
      <button class="choice-option" data-choice-option="between">between</button>
      <button class="choice-option" data-choice-option="on the corner of">on the corner of</button>
    </div>
    <div class="q"><span class="n">1</span><span>First, <button class="choice-gap" data-choice-gap data-answer="turn" data-placeholder="choose">choose</button> right at the traffic light. &nbsp;<span class="contraction">(change direction · not go)</span></span></div>
    <div class="q"><span class="n">2</span><span>Then <button class="choice-gap" data-choice-gap data-answer="go" data-placeholder="choose">choose</button> straight for two blocks. &nbsp;<span class="contraction">(keep moving · don’t turn)</span></span></div>
    <div class="q"><span class="n">3</span><span>Go <button class="choice-gap" data-choice-gap data-answer="past" data-placeholder="choose">choose</button> the gas station and keep walking. &nbsp;<span class="contraction">(continue beyond it)</span></span></div>
    <div class="q"><span class="n">4</span><span>Then <button class="choice-gap" data-choice-gap data-answer="take" data-placeholder="choose">choose</button> the first street on the left. &nbsp;<span class="contraction">(chunk · ___ the first street)</span></span></div>
    <div class="q"><span class="n">5</span><span>The hotel is <button class="choice-gap" data-choice-gap data-answer="next to" data-placeholder="choose">choose</button> the bank. &nbsp;<span class="contraction">(position · directly beside it)</span></span></div>
    <div class="q"><span class="n">6</span><span>The museum is <button class="choice-gap" data-choice-gap data-answer="across from" data-placeholder="choose">choose</button> the park. &nbsp;<span class="contraction">(position · on the other side of the street)</span></span></div>
    <div class="q"><span class="n">7</span><span>The café is <button class="choice-gap" data-choice-gap data-answer="between" data-placeholder="choose">choose</button> the school and the post office. &nbsp;<span class="contraction">(position · one on each side)</span></span></div>
    <div class="q"><span class="n">8</span><span>The bus stop is <button class="choice-gap" data-choice-gap data-answer="on the corner of" data-placeholder="choose">choose</button> Main Street and Second Avenue. &nbsp;<span class="contraction">(position · where the two streets meet)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-choices>Check</button>
      <button class="lesson-btn" data-reset-choices>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Ask politely, answer clearly, say thanks</h2>
  <div class="lead-rule"></div>
  <p>To ask a stranger for directions, open with <span class="ex">Excuse me…</span>: <span class="ex">Excuse me, how do I get to the museum?</span> or <span class="ex">Excuse me, where is the train station?</span></p>
  <p>To ask if a place exists nearby, reuse your A1 chunk <span class="ex">there is</span>: <span class="ex">Is there a pharmacy near here?</span> The answer often starts with <span class="ex">Yes, there’s one…</span> and a position chunk: <span class="ex">Yes, there’s one next to the hotel.</span></p>
  <p>To answer, give short imperatives, then finish with a position: <span class="ex">Go straight, turn left at the light, and it’s on the right, across from the park.</span> Close the exchange politely: <span class="ex">Thanks so much!</span> and reply with <span class="ex">No problem.</span> or <span class="ex">You’re welcome.</span></p>

  <div class="practice" data-answer-drill>
    <h3>Drill 2 · type the missing word</h3>
    <p class="choice-hint">One short word per gap. Say the full sentence aloud after you check.</p>
    <div class="q"><span class="n">1</span><span>Turn <input class="answer-input" data-answer="left" aria-label="answer 1" /> at the church, then go straight. &nbsp;<span class="contraction">(the opposite of right)</span></span></div>
    <div class="q"><span class="n">2</span><span>Go <input class="answer-input" data-answer="past" aria-label="answer 2" /> the fire station and take the second street on the right. &nbsp;<span class="contraction">(continue beyond it)</span></span></div>
    <div class="q"><span class="n">3</span><span>The pharmacy is next <input class="answer-input" data-answer="to" aria-label="answer 3" /> the hotel. &nbsp;<span class="contraction">(complete the chunk)</span></span></div>
    <div class="q"><span class="n">4</span><span>The movie theater is across <input class="answer-input" data-answer="from" aria-label="answer 4" /> the park. &nbsp;<span class="contraction">(complete the chunk)</span></span></div>
    <div class="q"><span class="n">5</span><span>The bus stop is on the <input class="answer-input" data-answer="corner" aria-label="answer 5" /> of Oak Street and Third Avenue. &nbsp;<span class="contraction">(where two streets meet)</span></span></div>
    <div class="q"><span class="n">6</span><span>Excuse me, how do I <input class="answer-input" data-answer="get" aria-label="answer 6" /> to the train station? &nbsp;<span class="contraction">(the polite question chunk)</span></span></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-answers>Check</button>
      <button class="lesson-btn" data-reset-answers>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Build the meaning, then the sentence</h2>
  <div class="lead-rule"></div>

  <div class="tile-game" data-tile-builder data-answer="turn left at the traffic light">
    <h3>Drill 3 · build the direction</h3>
    <p class="tile-target">A visitor needs to change direction at the light. Build the instruction, then say it.</p>
    <div class="tile-bank" data-build-bank>
      <button class="tile" data-build-tile="at">at</button>
      <button class="tile" data-build-tile="turn">Turn</button>
      <button class="tile" data-build-tile="the">the</button>
      <button class="tile" data-build-tile="left">left</button>
      <button class="tile" data-build-tile="traffic light">traffic light</button>
    </div>
    <div class="build-area" data-build-area data-placeholder="Tap words in order"></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-build>Check</button>
      <button class="lesson-btn" data-reset-build>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <div class="tile-game" data-tile-builder data-answer="the bank is across from the park">
    <h3>Drill 4 · build the position sentence</h3>
    <p class="tile-target">The bank sits on the other side of the street from the park. Build the sentence.</p>
    <div class="tile-bank" data-build-bank>
      <button class="tile" data-build-tile="across from">across from</button>
      <button class="tile" data-build-tile="the">The</button>
      <button class="tile" data-build-tile="park">park</button>
      <button class="tile" data-build-tile="is">is</button>
      <button class="tile" data-build-tile="the">the</button>
      <button class="tile" data-build-tile="bank">bank</button>
    </div>
    <div class="build-area" data-build-area data-placeholder="Tap words in order"></div>
    <div class="drill-actions">
      <button class="lesson-btn" data-check-build>Check</button>
      <button class="lesson-btn" data-reset-build>Reset</button>
    </div>
    <p class="feedback" data-feedback></p>
  </div>

  <h2>Notice and repair errors</h2>
  <div class="lead-rule"></div>
  <div class="micro-drill" data-spot-error data-answer="to" data-fix="Turn left at the bank." data-why="Turn left is a complete chunk with no extra word. Say turn left, turn right, go straight.">
    <h3>Drill 5 · one word too many</h3>
    <p>Tap the word that is wrong. The direction chunk is already complete.</p>
    <div class="spot-options">
      <button class="error-choice" data-error-choice="turn">Turn</button>
      <button class="error-choice" data-error-choice="to">to</button>
      <button class="error-choice" data-error-choice="left">left</button>
      <button class="error-choice" data-error-choice="at">at</button>
      <button class="error-choice" data-error-choice="the">the</button>
      <button class="error-choice" data-error-choice="bank">bank.</button>
    </div>
    <p class="hidden-answer" data-error-feedback></p>
  </div>

  <div class="micro-drill" data-spot-error data-answer="of" data-fix="The café is next to the hotel." data-why="The position chunk is next to, not next of. Say next to the hotel, next to the bank.">
    <h3>Drill 6 · fix the position chunk</h3>
    <p>Tap the word that is wrong. One small word breaks the chunk.</p>
    <div class="spot-options">
      <button class="error-choice" data-error-choice="the">The</button>
      <button class="error-choice" data-error-choice="café">café</button>
      <button class="error-choice" data-error-choice="is">is</button>
      <button class="error-choice" data-error-choice="next">next</button>
      <button class="error-choice" data-error-choice="of">of</button>
      <button class="error-choice" data-error-choice="hotel">the hotel.</button>
    </div>
    <p class="hidden-answer" data-error-feedback></p>
  </div>

  <div class="micro-drill" data-transform>
    <h3>Drill 7 · transform it, then say it</h3>
    <p>Say the new sentence aloud first. Reveal only after you answer.</p>
    <div class="transform-list">
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>1</b> turn right &nbsp;→&nbsp; say the opposite</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>turn left</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>2</b> take the first street on the left &nbsp;→&nbsp; say the opposite side</p>
        <button class="lesson-btn" data-reveal-transform>Reveal after you answer</button>
        <p class="transform-answer" data-transform-answer><strong>take the first street on the right</strong></p>
      </div>
      <div class="transform-item" data-transform-item>
        <p class="transform-cue"><b>3</b> Where is the museum? &nbsp;→&nbsp; make it polite for a stranger</p>
