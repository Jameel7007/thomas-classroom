        <div class="quiz-options"><button class="quiz-option" data-quiz-option="It’s downloading a file.">It’s downloading a file.</button><button class="quiz-option" data-quiz-option="It downloads a file.">It downloads a file.</button><button class="quiz-option" data-quiz-option="It download a file.">It download a file.</button></div>
      </div>
    </div>
