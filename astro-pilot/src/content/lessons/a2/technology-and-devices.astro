import { defineLesson } from "../../../data/lesson-schema.mjs";

export const page = defineLesson({
  "title": "Technology & devices · A2 Vocabulary",
  "slug": "technology-and-devices",
  "level": "A2",
  "topic": "Technology & devices",
  "category": "Vocabulary & Topics",
  "contentType": "vocabulary",
  "status": "ready",
  "description": "Describe a device, service, action, observable symptom, scope, and safe next step precisely enough to request or provide basic technology support.",
  "sequence": 6,
  "prerequisites": ["a1/can-for-ability-and-permission", "a1/imperatives", "a2/present-perfect"],
  "related": [],
  "assessments": ["a2-exit"],
  "tutorReviewRequired": true,
  "qualityReview": {
