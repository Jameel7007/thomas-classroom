---
import QuickCheckPage from "../../components/assessment/QuickCheckPage.astro";
import { quickCheckData, quickCheckSpeakingTasks } from "../../data/quick-level-check.mjs";
const quickCheckJson = JSON.stringify(quickCheckData).replace(/</g, "\\u003c");
export const page = {
  "original": "outputs/assessments/quick-level-check.html",
  "source": "src/content/assessments/quick-level-check.astro",
  "route": "/assessments/quick-level-check/",
  "slug": "quick-level-check",
  "title": "10-Minute English Starting-Point Check",
  "description": "A short teacher-guided screen that suggests an A0–B2 curriculum starting point from level-sensitive language-use evidence and an adaptive speaking confirmation.",
  "engine": "quick-check",
  "bodyClass": "",
  "features": [
    "AssessmentPage",
    "AssessmentNavigation",
    "QuickCheckEngine",
    "ProgressIndicator",
    "FeedbackPanel",
    "SpeakingRubric"
  ],
  "contentTextHash": "6930f2ef959cb8dd8ed6d1039e3da5e7f15c3f530c3335f2ef595d701d3b8250",
  "interactionCounts": {
    "data-quick-check": 1,
    "data-quick-check-config": 1,
    "data-part-label": 1,
    "data-progress-text": 1,
    "data-progress-bar": 1,
    "data-question-stage": 1,
    "data-question-actions": 1,
    "data-previous": 1,
    "data-next": 1,
    "data-answer-reminder": 1,
    "data-result-view": 1,
    "data-result-level": 1,
    "data-result-score": 1,
    "data-result-explanation": 1,
    "data-result-profile": 1,
    "data-speaking-task": 5,
    "data-speaking-level": 1,
    "data-speaking-outcome": 1,
    "data-answer-review": 1,
    "data-review-list": 1,
    "data-reset": 1
  },
  "audioClips": []
};
---
<QuickCheckPage page={page}>
<main class="quick-wrap">
  <header class="quick-header">
    <a class="back-link" href="/assessments/">Back to diagnostics</a>
    <p class="overline">Quick starting-point screen</p>
    <h1>10-Minute English Starting-Point Check</h1>
    <p class="lede">Use ten level-sensitive language questions for an initial signal, then confirm it with the suggested speaking prompt. This chooses a sensible curriculum starting point; it does not certify a CEFR level.</p>
    <div class="quick-facts" aria-label="Assessment information">
      <span><b>8 minutes</b> multiple choice</span>
      <span><b>2 minutes</b> adaptive speaking</span>
      <span><b>10</b> questions</span>
    </div>
  </header>

  <section class="quick-assessment" data-quick-check>
    <script is:inline type="application/json" data-quick-check-config set:html={quickCheckJson}></script>
    <div class="progress-block">
      <div class="progress-copy">
        <span data-part-label>Part 1 · Multiple Choice</span>
        <b data-progress-text>Question 1 of 10</b>
      </div>
      <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
    </div>

    <div class="question-stage" data-question-stage aria-live="polite"></div>

    <div class="question-actions" data-question-actions>
      <button class="quiet-button" type="button" data-previous disabled>Back</button>
      <button class="primary-button" type="button" data-next>Next question</button>
    </div>
    <p class="answer-reminder" data-answer-reminder aria-live="polite"></p>

    <section class="result-view" data-result-view hidden>
      <div class="result-heading">
        <div>
      <p class="overline">Multiple-choice result</p>
          <h2 data-result-level>Not estimated</h2>
        </div>
        <div class="result-score"><span>Total score</span><b data-result-score>0 / 10</b></div>
      </div>
      <p class="result-explanation" data-result-explanation></p>
      <div class="quick-facts result-profile" data-result-profile aria-label="Correct answers by evidence band"></div>
      <p class="result-warning">This is a starting-point screen, not a CEFR certificate or final placement. A B2 checkpoint still requires sustained speaking evidence or the full placement diagnostic.</p>

      <section class="speaking-section">
        <div class="section-heading">
          <div>
            <p class="overline">Part 2 · Adaptive Speaking Sample</p>
            <h2>Confirm the starting point</h2>
          </div>
          <span>Teacher scored</span>
        </div>
        <p class="teacher-note"><b>Teacher move:</b> Use the prompt selected by the language-use result. Ask at least one follow-up and score the sustained response, not one perfect sentence.</p>

        {quickCheckSpeakingTasks.map((task) => (
          <article class="speaking-card" data-speaking-task={task.id} hidden>
            <p class="task-number">{task.label}</p>
            <p class="speaking-prompt"><b>{task.prompt}</b></p>
            <div class="speaking-follow-ups">
              <p class="task-number">Follow up</p>
              <ul>{task.followUps.map((followUp) => <li>{followUp}</li>)}</ul>
            </div>
          </article>
        ))}

        <details class="answer-review speaking-rubric">
          <summary>Open the speaking rubric</summary>
          <p class="teacher-note">Listen across task completion, language range, accuracy, flow, and response to follow-up questions.</p>
          <div class="review-list">
            <article class="review-item"><p>A0 / Pre-A1</p><span>Uses familiar words or memorized chunks and needs substantial support to answer.</span></article>
            <article class="review-item"><p>A1</p><span>Builds simple personal sentences with frequent pauses and can answer predictable follow-ups.</span></article>
            <article class="review-item"><p>A2</p><span>Gives a short connected account with basic linking; errors are frequent but meaning remains clear.</span></article>
            <article class="review-item"><p>B1</p><span>Sustains an explanation with reasons and details, responds to follow-ups, and can repair some errors.</span></article>
            <article class="review-item"><p>B2 evidence</p><span>Develops and supports a clear position, handles a counterpoint, and interacts flexibly; errors rarely interfere.</span></article>
          </div>
        </details>

        <div class="speaking-score">
          <label for="speaking-level">Speaking level observed</label>
          <select id="speaking-level" data-speaking-level>
            <option value="">Not scored yet</option>
            <option value="a0">A0 / Pre-A1</option>
            <option value="a1">A1</option>
            <option value="a2">A2</option>
            <option value="b1">B1</option>
            <option value="b2">B2 evidence</option>
          </select>
          <p data-speaking-outcome>Choose the strongest level sustained across the complete response. The language-use evidence remains visible for comparison.</p>
        </div>
      </section>

      <details class="answer-review" data-answer-review>
        <summary>Review all answers</summary>
        <div class="review-list" data-review-list></div>
      </details>

      <div class="result-actions">
        <button class="quiet-button" type="button" data-reset>Reset check</button>
        <a class="text-link" href="/assessments/placement-exam/">Open full placement diagnostic</a>
      </div>
    </section>
  </section>
</main>
</QuickCheckPage>
