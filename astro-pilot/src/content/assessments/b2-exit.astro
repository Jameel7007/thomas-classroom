export const page = {
  "original": "outputs/assessments/b2-exit.html",
  "source": "src/content/assessments/b2-exit.astro",
  "route": "/assessments/b2-exit/",
  "slug": "b2-exit",
  "title": "B2 End-of-Level Diagnostic",
  "description": "Use this after all B2 lessons to identify any remaining gaps and confirm readiness for advanced independent English work.",
  "engine": "none",
  "bodyClass": "",
  "features": [
    "AssessmentPage",
    "AssessmentNavigation"
  ],
  "contentTextHash": "92968923b317a5ccc4733ecc2b0310e5861bea681013624ecd87ccf164cf5361",
