---
import VisualPronunciationGuide from "./VisualPronunciationGuide.astro";

interface WritingTask { title: string; task: string; requirements: string[] }
interface Props {
  level: string;
  topic: string;
  title?: string;
  setup: string;
  personalPrompt?: string;
  roles?: string[];
  prompts?: string[];
  success?: string[];
  pronunciation?: string;
  example?: string;
  writing?: WritingTask;
}
const {
  level,
  topic,
  title = "Use the language for a real purpose",
  setup,
  personalPrompt: personalPromptOverride = "",
  roles = [],
  prompts = [],
  success = [],
  pronunciation = "",
  example = "",
  writing,
} = Astro.props as Props;

const personalPrompt = personalPromptOverride || prompts[0] || setup;
const followUps = prompts.slice(1, 3);
const roleCards = roles.length >= 2
  ? roles.slice(0, 2)
  : [
      `Learner: use ${topic} to complete the situation in your own words.`,
      "Tutor: respond naturally, ask one follow-up question, and introduce one small change.",
    ];
const challengeByLevel: Record<string, string> = {
  A0: "Give three complete, connected responses without reading a model.",
  A1: "Speak for four connected sentences and answer one unplanned follow-up question.",
  A2: "Speak for about 45 seconds, add a reason or example, and answer one follow-up question.",
  B1: "Speak for 60–90 seconds, connect your ideas, and respond to one change or objection.",
  B2: "Sustain the exchange for 90 seconds, make one precise contrast, and reformulate one idea when challenged.",
  C1: "Sustain a clear position for two minutes, adapt to a challenge, and reformulate one point more precisely.",
};
const monitorCriteria = [...new Set([
  ...success,
  `The learner uses ${topic} to express an intended meaning, not only to display a form.`,
  "The answer stays understandable when the tutor asks an unplanned follow-up question.",
  "The learner notices and repairs one form, word, or phrasing choice when needed.",
])].slice(0, 4);
---
<section class="production-ladder" data-production-ladder={level} aria-labelledby={`production-ladder-${level.toLowerCase()}-${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
  <header class="production-ladder-heading">
    <p class="production-label">Choose the right amount of challenge</p>
    <h2 id={`production-ladder-${level.toLowerCase()}-${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>Communicate in three steps</h2>
    <p>{title}. Pick one starting point, then move up only if the learner is ready. True or invented details are equally acceptable.</p>
  </header>
  <div class="production-step-grid">
    <article data-production-step="personal">
      <span class="production-number">1</span>
      <p class="production-level">Personal answer</p>
      <h3>Make the language yours</h3>
      <p class="prompt-card">{personalPrompt}</p>
      {followUps.length > 0 && <><b class="production-subhead">Follow-up choices</b><ul>{followUps.map((prompt) => <li>{prompt}</li>)}</ul></>}
    </article>
    <article data-production-step="role-play">
      <span class="production-number">2</span>
      <p class="production-level">Guided role play</p>
      <h3>{title}</h3>
      <p>{setup}</p>
      <div class="production-roles">{roleCards.map((role, index) => <p><b>Role {index + 1}</b><span>{role}</span></p>)}</div>
      {prompts.length > 0 && <><b class="production-subhead">Useful language</b><ul>{prompts.slice(0, 4).map((prompt) => <li>{prompt}</li>)}</ul></>}
    </article>
    <article data-production-step="challenge">
      <span class="production-number">3</span>
      <p class="production-level">Real-world challenge</p>
      <h3>Remove the support</h3>
      <p>{writing?.task || setup}</p>
      <p class="production-demand"><b>{level} target:</b> {challengeByLevel[level] || challengeByLevel.B1}</p>
      {writing?.requirements?.length && <><b class="production-subhead">Include</b><ul>{writing.requirements.slice(0, 4).map((item) => <li>{item}</li>)}</ul></>}
    </article>
  </div>
  <aside class="production-monitor">
    <p class="production-label">Tutor monitor</p>
    <h3>Listen for evidence, not perfection</h3>
    <ul>{monitorCriteria.map((item) => <li>{item}</li>)}</ul>
  </aside>
  <VisualPronunciationGuide guidance={pronunciation} example={example || "Choose one complete sentence from your answer."} />
</section>

<style is:inline>
  .production-ladder{margin:66px 0 0;padding-top:10px}
  .production-ladder-heading h2{margin:0 0 13px;padding:0}
  .production-ladder-heading>p:last-child{max-width:70ch;color:var(--ink-2)}
  .production-label{margin:0 0 7px;color:var(--accent-deep);font:600 11px/1.3 var(--mono);letter-spacing:.1em;text-transform:uppercase}
  .production-step-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:26px}
  .production-step-grid article{position:relative;min-width:0;padding:25px 22px 22px;border:1px solid var(--line);border-radius:16px;background:var(--surface);box-shadow:0 18px 38px -36px var(--cobalt-deep)}
  .production-step-grid article:nth-child(2){border-color:var(--accent-soft);background:var(--accent-tint)}
  .production-step-grid article:nth-child(3){border-color:var(--cobalt);background:var(--cobalt-tint)}
  .production-number{position:absolute;top:16px;right:17px;color:var(--line);font:700 36px/1 var(--mono)}
  .production-level{margin:0 40px 8px 0;color:var(--accent-deep);font:600 10px/1.3 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .production-step-grid h3,.production-monitor h3{margin:0 0 10px;font-family:var(--serif);font-size:24px;font-style:normal;font-weight:500;line-height:1.2}
  .production-step-grid p,.production-step-grid li{font-size:15px;line-height:1.55}
  .production-step-grid .prompt-card{margin:14px 0 0;padding:14px;border-left:3px solid var(--accent);background:var(--paper-2);font-style:normal}
  .production-step-grid ul{margin:7px 0 0;padding-left:19px}
  .production-subhead{display:block;margin-top:15px;color:var(--muted);font:600 10px/1.3 var(--mono);letter-spacing:.07em;text-transform:uppercase}
  .production-roles{display:grid;gap:7px;margin-top:13px}
  .production-roles p{margin:0;padding:10px;border:1px solid var(--line-2);border-radius:9px;background:var(--surface)}
  .production-roles b,.production-roles span{display:block}.production-roles b{color:var(--accent-deep);font:600 10px/1.3 var(--mono);text-transform:uppercase}.production-roles span{margin-top:4px}
  .production-demand{margin:14px 0 0;padding:12px;border:1px solid var(--cobalt);border-radius:9px;background:var(--surface)}
  .production-monitor{margin-top:12px;padding:20px 22px;border:1px solid var(--line);border-radius:14px;background:var(--paper-2)}
  .production-monitor ul{display:grid;grid-template-columns:1fr 1fr;gap:7px 28px;margin:10px 0 0;padding-left:20px}
  .production-monitor li{font-size:14px;line-height:1.5}
  @media(max-width:820px){.production-step-grid{grid-template-columns:1fr}.production-monitor ul{grid-template-columns:1fr}}
  @media(max-width:480px){.production-step-grid article,.production-monitor{padding:19px 17px}}
  @media print{.production-step-grid{grid-template-columns:1fr 1fr}.production-step-grid article,.production-monitor{break-inside:avoid}}
</style>
