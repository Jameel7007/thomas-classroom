---
import "../../styles/lesson.css";
import "../../styles/drills.css";
import FontStyles from "../FontStyles.astro";
import SocialMetadata from "../SocialMetadata.astro";
import SkipLink from "../SkipLink.astro";
import StructuredData from "../StructuredData.astro";
import LessonNavigation from "./LessonNavigation.astro";
import LiveTeachingMode from "./LiveTeachingMode.astro";
import ProductionLadder from "./ProductionLadder.astro";
import LessonReadingLinks from "./LessonReadingLinks.astro";
import LessonSequenceNavigation from "./LessonSequenceNavigation.astro";
import LessonExerciseEngine from "./LessonExerciseEngine.astro";
import { getLesson, getLessonNavigation, getLessonsForLevel } from "../../data/lesson-catalog.mjs";
import { curriculum } from "../../lib/curriculum";
import { removeTutorListeningScriptsFromLesson } from "../../lib/listening-scripts.mjs";
import { formatPageTitle } from "../../lib/page-title.mjs";
import { buildTutorBrief } from "../../lib/tutor-plan.mjs";
import { schemaIds, siteIdentityNodes, webPageNode } from "../../lib/structured-data.mjs";

interface PageMetadata {
  title: string;
  description: string;
  level: string;
  slug: string;
  tutorReviewRequired?: boolean;
}

interface Props { page: PageMetadata }
const { page } = Astro.props;
const lesson = getLesson(`${page.level.toLowerCase()}/${page.slug}`);
if (!lesson) throw new Error(`Lesson metadata is not registered for ${page.level}/${page.slug}`);
const canonical = new URL(lesson.route, Astro.site);
const { previous, next, isCourseEnd } = getLessonNavigation(lesson.id);
const levelTotal = getLessonsForLevel(lesson.level).length;
const level = curriculum.find((item) => item.code === lesson.level);
if (!level) throw new Error(`Curriculum level metadata is missing for ${lesson.level}`);
const prerequisiteTopics = lesson.prerequisites
  .map((id: string) => getLesson(id)?.topic)
  .filter((topic: string | undefined): topic is string => Boolean(topic));
const ids = schemaIds(Astro.site);
const documentTitle = formatPageTitle(lesson.title);
const lessonSchemaId = `${canonical.href}#lesson`;
const courseUrl = new URL(`/curriculum/#lvl-${lesson.level}`, Astro.site).href;
const courseSchemaId = `${courseUrl}-course`;
const breadcrumbData = {
  "@type": "BreadcrumbList",
  "@id": `${canonical.href}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Curriculum", item: new URL("/curriculum/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: `${lesson.level} · ${level.name}`, item: courseUrl },
    { "@type": "ListItem", position: 3, name: lesson.topic, item: canonical.href },
  ],
};
const structuredData = [
  ...siteIdentityNodes(Astro.site),
  webPageNode({ canonical, title: documentTitle, description: lesson.description, site: Astro.site, mainEntityId: lessonSchemaId }),
  breadcrumbData,
  {
    "@type": "Course",
    "@id": courseSchemaId,
    url: courseUrl,
    name: `${lesson.level} · ${level.name} English course`,
    description: level.blurb,
    inLanguage: "en",
    educationalLevel: lesson.level,
    isAccessibleForFree: true,
    provider: { "@id": ids.tutor },
  },
  {
    "@type": "LearningResource",
    "@id": lessonSchemaId,
    url: canonical.href,
    name: lesson.topic,
    headline: lesson.title,
    description: lesson.description,
    inLanguage: "en",
    educationalLevel: lesson.level,
    learningResourceType: `${lesson.category} lesson`,
    educationalUse: ["instruction", "practice", "assessment"],
    interactivityType: "mixed",
    isAccessibleForFree: true,
    teaches: lesson.topic,
    ...(prerequisiteTopics.length ? { competencyRequired: prerequisiteTopics } : {}),
    keywords: [lesson.level, lesson.category, lesson.topic, "English lesson"],
    author: { "@id": ids.tutor },
    isPartOf: { "@id": courseSchemaId },
  },
];
const renderedLesson = await Astro.slots.render("default");
const learnerLesson = removeTutorListeningScriptsFromLesson(renderedLesson);
const hasProductionLadder = /\bdata-production-ladder\b/.test(learnerLesson.html);
const productionBrief = hasProductionLadder ? null : buildTutorBrief(lesson);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FontStyles />
    <title>{documentTitle}</title>
    <meta name="description" content={lesson.description} />
    <SocialMetadata title={documentTitle} description={lesson.description} canonical={canonical} type="article" />
    <StructuredData nodes={structuredData} />
  </head>
  <body data-tutor-review-required={lesson.tutorReviewRequired ? "true" : undefined}>
    <SkipLink target="lesson-content" />
    <LessonNavigation level={lesson.level} category={lesson.category} sequence={lesson.sequence} total={levelTotal} />
    <LiveTeachingMode level={lesson.level} slug={lesson.slug} />
    <div id="lesson-content" tabindex="-1">
      <div class="lesson-content-native" set:html={learnerLesson.html}></div>
      {!hasProductionLadder && productionBrief && (
        <section class="wrap production-ladder-wrap" aria-label="Final learner production">
          <ProductionLadder
            level={lesson.level}
            topic={lesson.topic}
            title={productionBrief.production.title}
            setup={productionBrief.production.setup}
            personalPrompt={productionBrief.production.setup}
            prompts={productionBrief.production.prompts}
            success={productionBrief.production.success}
          />
        </section>
      )}
    </div>
    <LessonReadingLinks lessonId={lesson.id} />
    <LessonSequenceNavigation lesson={lesson} previous={previous} next={next} isCourseEnd={isCourseEnd} />
    <LessonExerciseEngine />
  </body>
</html>
