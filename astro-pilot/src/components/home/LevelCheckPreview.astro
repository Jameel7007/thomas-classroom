<section class="level-preview" aria-labelledby="level-preview-title" data-level-preview>
  <div class="level-preview__intro">
    <p class="level-preview__label">Try one question</p>
    <h2 id="level-preview-title">Choose the best form.</h2>
    <p>Nora normally works at the office, but this month she ___ from home.</p>
  </div>

  <div class="level-preview__options" role="group" aria-labelledby="level-preview-title">
    <button
      type="button"
      aria-pressed="false"
      data-level-preview-answer="routine"
      data-feedback="“Works” describes a usual arrangement. This month is temporary, so use “is working.”"
    >
      works
    </button>
    <button
      type="button"
      aria-pressed="false"
      data-level-preview-answer="temporary"
      data-feedback="Correct. “This month” describes a temporary situation around now, so use the present continuous."
    >
      is working
    </button>
    <button
      type="button"
      aria-pressed="false"
      data-level-preview-answer="past"
      data-feedback="“Worked” describes finished past time. This month is still happening, so use “is working.”"
    >
      worked
    </button>
  </div>

  <p class="level-preview__feedback" role="status" aria-live="polite" data-level-preview-feedback>
    Choose one answer for instant feedback.
  </p>
  <div class="level-preview__next">
    <span>One question cannot place your level.</span>
    <a href="/assessments/quick-level-check/">Take the 10-minute starting-point check <span aria-hidden="true">→</span></a>
  </div>
</section>

<style is:inline>
  .level-preview{width:min(100%,27rem);padding:1rem;border:1px solid color-mix(in srgb,var(--ink) 20%,transparent);border-radius:14px;background:color-mix(in srgb,var(--card) 92%,transparent);box-shadow:0 18px 38px -34px var(--ink);text-align:left}
  .level-preview__intro{display:grid;gap:.38rem}.level-preview__label{margin:0;color:var(--pen);font-family:'IBM Plex Mono',monospace;font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.level-preview h2{margin:0;color:var(--ink);font-family:'Albert Sans',sans-serif;font-size:1rem;line-height:1.35;letter-spacing:0}.level-preview__intro>p:last-child{margin:0;color:var(--ink-soft);font-size:.8rem;line-height:1.48}
  .level-preview__options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.42rem;margin-top:.8rem}.level-preview__options button{width:100%;min-height:44px;padding:.6rem .55rem;border:1px solid color-mix(in srgb,var(--ink) 24%,transparent);border-radius:9px;background:var(--paper);color:var(--ink);font:600 .78rem/1.35 'Albert Sans',sans-serif;text-align:center;cursor:pointer;transition:border-color .15s ease,background .15s ease,transform .15s ease,box-shadow .15s ease}.level-preview__options button:hover{border-color:var(--teal);transform:translateY(-1px)}.level-preview__options button:focus-visible,.level-preview__next a:focus-visible{outline:3px solid var(--pen);outline-offset:3px}.level-preview__options button[data-result="correct"]{border-color:#26733b;background:#e7f6e8;box-shadow:inset 4px 0 0 #26733b}.level-preview__options button[data-result="incorrect"]{border-color:var(--pen);background:#fff0ec;box-shadow:inset 4px 0 0 var(--pen)}
  .level-preview__feedback{min-height:2.5em;margin:.65rem 0 0;color:var(--ink-soft);font-size:.76rem;line-height:1.45}.level-preview[data-state="correct"] .level-preview__feedback{color:#1f6834;font-weight:650}.level-preview[data-state="incorrect"] .level-preview__feedback{color:#8f2f25;font-weight:650}.level-preview__next{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.35rem .75rem;padding-top:.68rem;border-top:1px solid color-mix(in srgb,var(--ink) 14%,transparent);font-family:'IBM Plex Mono',monospace;font-size:.64rem;line-height:1.45}.level-preview__next span{color:var(--ink-soft)}.level-preview__next a{color:var(--ink);font-weight:700;text-underline-offset:3px}.level-preview__next a:hover{color:var(--pen)}
  @media(max-width:760px){.level-preview{width:100%}}
  @media(prefers-reduced-motion:reduce){.level-preview__options button{transition:none}.level-preview__options button:hover{transform:none}}
</style>

<script is:inline>
  document.querySelectorAll("[data-level-preview]").forEach((preview) => {
    const feedback = preview.querySelector("[data-level-preview-feedback]");
    const answers = Array.from(preview.querySelectorAll("[data-level-preview-answer]"));

    answers.forEach((answer) => {
      answer.addEventListener("click", () => {
        const isCorrect = answer.dataset.levelPreviewAnswer === "temporary";
        preview.dataset.state = isCorrect ? "correct" : "incorrect";
        answers.forEach((option) => {
          option.removeAttribute("data-result");
          option.setAttribute("aria-pressed", "false");
        });
        answer.dataset.result = isCorrect ? "correct" : "incorrect";
        answer.setAttribute("aria-pressed", "true");
        feedback.textContent = answer.dataset.feedback;
      });
    });
  });
</script>
