---
import { getTransferPatternsForLesson } from "../../data/language-transfer.mjs";

interface Props { lessonId: string }
interface TransferPattern {
  id: string;
  level: string;
  category: string;
  title: string;
  listenFor: string;
  rebuild: string;
  explanation: string;
  examples: string[];
  tutorMove: string;
}
interface TransferMatch { language: { slug: string; name: string }; pattern: TransferPattern }
interface TransferLanguageGroup { slug: string; name: string; patterns: TransferPattern[] }
const { lessonId } = Astro.props as Props;
const matches = getTransferPatternsForLesson(lessonId) as TransferMatch[];
const languages: TransferLanguageGroup[] = [];
for (const match of matches) {
  const existing = languages.find((group) => group.slug === match.language.slug);
  if (existing) existing.patterns.push(match.pattern);
  else languages.push({ slug: match.language.slug, name: match.language.name, patterns: [match.pattern] });
}
---
{languages.length > 0 && (
  <section class="transfer-lens" aria-labelledby="transfer-lens-title" data-transfer-lens={lessonId}>
    <div class="transfer-lens-heading">
      <div>
        <p class="tutor-card-label">Tutor-only contrastive support</p>
        <h2 id="transfer-lens-title">L1 Transfer Lens</h2>
        <p>Test a pattern. Do not label a learner. Use this only after the learner’s actual production gives you evidence.</p>
      </div>
      <label class="transfer-lens-control">
        <span>Learner’s first language</span>
        <select data-transfer-lens-select aria-controls="transfer-lens-patterns">
          <option value="">Choose a language</option>
          {languages.map((language) => <option value={language.slug}>{language.name}</option>)}
        </select>
      </label>
    </div>

    <div id="transfer-lens-patterns" class="transfer-lens-patterns" aria-live="polite">
      <p class="transfer-lens-empty" data-transfer-lens-empty>Select a first language to reveal only the contrasts relevant to this lesson.</p>
      {languages.map((language) => (
        <section class="transfer-lens-language" data-transfer-lens-language={language.slug} hidden aria-labelledby={`transfer-lens-${language.slug}`}>
          <header>
            <p class="tutor-card-label">{language.name} → English</p>
            <h3 id={`transfer-lens-${language.slug}`}>{language.patterns.length === 1 ? "One pattern to test" : `${language.patterns.length} patterns to test`}</h3>
          </header>
          <div class="transfer-lens-grid">
            {language.patterns.map((pattern) => (
              <article data-transfer-lens-pattern={`${language.slug}/${pattern.id}`}>
                <p class="transfer-lens-meta"><span>{pattern.level}</span><span>{pattern.category}</span></p>
                <h4>{pattern.title}</h4>
                <dl>
                  <div><dt>Possible transfer</dt><dd><q>{pattern.listenFor}</q></dd></div>
                  <div><dt>English rebuild</dt><dd><q>{pattern.rebuild}</q></dd></div>
                </dl>
                <p><b>Why it can happen:</b> {pattern.explanation}</p>
                <div class="transfer-lens-examples"><b>Natural English:</b><ul>{pattern.examples.map((example) => <li>{example}</li>)}</ul></div>
                <aside><b>Quick correction drill</b><p>{pattern.tutorMove}</p></aside>
              </article>
            ))}
          </div>
          <a class="transfer-lens-guide" href={`/languages/#transfer-${language.slug}`} target="_blank" rel="noopener">Open the full {language.name} guide ↗</a>
        </section>
      ))}
    </div>
  </section>
)}

<script is:inline>
  document.querySelectorAll("[data-transfer-lens]").forEach((lens) => {
    if (lens.dataset.transferLensReady === "true") return;
    lens.dataset.transferLensReady = "true";
    const select = lens.querySelector("[data-transfer-lens-select]");
    const empty = lens.querySelector("[data-transfer-lens-empty]");
    const panels = [...lens.querySelectorAll("[data-transfer-lens-language]")];
    select?.addEventListener("change", () => {
      const value = select.value;
      panels.forEach((panel) => { panel.hidden = panel.dataset.transferLensLanguage !== value; });
      if (empty) empty.hidden = Boolean(value);
    });
  });
</script>

<style is:inline>
  .transfer-lens{margin:48px 0;padding:24px;border:1px solid var(--line);border-radius:16px;background:var(--surface-2)}
  .transfer-lens-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,320px);gap:28px;align-items:end}
  .transfer-lens-heading h2{margin:0;font-family:var(--display);font-size:34px;font-weight:500}
  .transfer-lens-heading p:last-child{max-width:700px;margin:10px 0 0;color:var(--ink-2);font-size:14px;line-height:1.55}
  .transfer-lens-control{display:grid;gap:7px;color:var(--muted);font:600 10px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .transfer-lens-control select{width:100%;min-height:46px;padding:10px 38px 10px 12px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--ink);font:600 15px/1.3 var(--sans)}
  .transfer-lens-control select:focus-visible,.transfer-lens-guide:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}
  .transfer-lens-patterns{margin-top:20px}
  .transfer-lens-empty{margin:0;padding:16px;border:1px dashed var(--line);border-radius:11px;color:var(--ink-2);font-size:14px;text-align:center}
  .transfer-lens-language[hidden],.transfer-lens-empty[hidden]{display:none!important}
  .transfer-lens-language>header{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:12px}
  .transfer-lens-language h3{margin:0;font-family:var(--display);font-size:25px;font-weight:500}
  .transfer-lens-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .transfer-lens-grid article{min-width:0;padding:18px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}
  .transfer-lens-meta{display:flex;gap:6px;margin:0 0 8px}
  .transfer-lens-meta span{padding:3px 6px;border:1px solid var(--line);border-radius:99px;color:var(--muted);font:600 9px/1.2 var(--mono);letter-spacing:.06em;text-transform:uppercase}
  .transfer-lens-grid h4{margin:0 0 14px;font-family:var(--display);font-size:22px;font-weight:500}
  .transfer-lens-grid dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 14px}
  .transfer-lens-grid dl div{padding:10px;border-radius:9px;background:var(--paper)}
  .transfer-lens-grid dt{color:var(--muted);font:600 9px/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase}
  .transfer-lens-grid dd{margin:5px 0 0;color:var(--ink);font-size:14px;line-height:1.45}
  .transfer-lens-grid>article>p,.transfer-lens-examples,.transfer-lens-grid aside p{color:var(--ink-2);font-size:13px;line-height:1.55}
  .transfer-lens-examples ul{margin:6px 0 0;padding-left:18px}
  .transfer-lens-grid aside{margin-top:14px;padding:13px;border-left:3px solid var(--accent);background:var(--accent-tint)}
  .transfer-lens-grid aside p{margin:4px 0 0}
  .transfer-lens-guide{display:inline-block;margin-top:14px;color:var(--accent-deep);font:600 12px/1.4 var(--mono);text-underline-offset:3px}
  @media(max-width:720px){.transfer-lens{padding:18px}.transfer-lens-heading{grid-template-columns:1fr}.transfer-lens-grid{grid-template-columns:1fr}.transfer-lens-language>header{display:block}.transfer-lens-grid dl{grid-template-columns:1fr}}
  @media print{.transfer-lens{padding:0;border:0;background:#fff}.transfer-lens-control,.transfer-lens-empty,.transfer-lens-guide{display:none!important}.transfer-lens-language[hidden]{display:block!important}.transfer-lens-language{break-before:page}.transfer-lens-grid article{break-inside:avoid}.transfer-lens-grid{grid-template-columns:1fr 1fr}}
</style>
