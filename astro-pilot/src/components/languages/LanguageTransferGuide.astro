---
interface LessonLink { id: string; topic: string; level: string; route: string }
interface TransferPattern {
  id: string;
  level: string;
  category: string;
  sourcePattern: string;
  title: string;
  listenFor: string;
  rebuild: string;
  explanation: string;
  examples: string[];
  tutorMove: string;
  lessons: LessonLink[];
}
interface HelpfulWord { source: string; english: string; note: string }
interface WordTrap { source: string; tempting: string; actual: string; example: string }
interface LexicalBridge {
  helpfulLabel: string;
  trapLabel: string;
  note: string;
  helpful: HelpfulWord[];
  traps: WordTrap[];
}
interface TransferLanguage {
  slug: string;
  name: string;
  note: string;
  principle: string;
  lexicalBridge: LexicalBridge;
  patterns: TransferPattern[];
}
interface Counts { languages: number; patterns: number; lessons: number; helpfulWords: number; wordTraps: number }
interface Props { languages: TransferLanguage[]; counts: Counts }
const { languages, counts } = Astro.props;
---
<section class="transfer-guide" aria-labelledby="transfer-guide-title">
  <header class="transfer-guide-intro">
    <div>
      <p class="tab-overline">Contrastive guide</p>
      <h2 id="transfer-guide-title">Test a pattern. Do not label a learner.</h2>
      <p>These are productive hypotheses from cross-linguistic influence—not rules about every speaker. Listen for repeated evidence, ask what the learner intended, and teach only the contrast that is actually useful.</p>
    </div>
    <dl class="transfer-guide-counts" aria-label="Language transfer guide coverage">
      <div><dt>Languages</dt><dd>{counts.languages}</dd></div>
      <div><dt>Patterns</dt><dd>{counts.patterns}</dd></div>
      <div><dt>Helpful words</dt><dd>{counts.helpfulWords}</dd></div>
      <div><dt>Word traps</dt><dd>{counts.wordTraps}</dd></div>
      <div><dt>Linked lessons</dt><dd>{counts.lessons}</dd></div>
    </dl>
  </header>

  <nav class="transfer-language-nav" aria-label="Jump to a first-language guide">
    {languages.map((language) => <a href={`#transfer-${language.slug}`}>
      <span>{language.name}</span>
      <b>{language.patterns.length} patterns</b>
    </a>)}
  </nav>

  <section class="transfer-method" aria-labelledby="transfer-method-title">
    <div><p class="tab-overline">A four-move response</p><h2 id="transfer-method-title">Use the contrast while the meaning is still alive.</h2></div>
    <ol>
      <li><b>Notice</b><span>Capture the learner’s intended message before correcting the form.</span></li>
      <li><b>Compare</b><span>Show why the first-language choice was logical and where English divides the job differently.</span></li>
      <li><b>Rebuild</b><span>Let the learner produce the repaired sentence, then change one meaningful detail.</span></li>
      <li><b>Transfer</b><span>Open the linked lesson only when the pattern needs controlled practice and wider production.</span></li>
    </ol>
  </section>

  <div class="language-list">
    {languages.map((language) => <section class="language-panel" id={`transfer-${language.slug}`} data-transfer-language={language.slug} aria-labelledby={`${language.slug}-title`}>
      <header class="language-panel-header">
        <div><p class="transfer-language-label">First language</p><h2 id={`${language.slug}-title`}>{language.name}</h2></div>
        <p>{language.note}</p>
      </header>
      <aside class="transfer-principle"><b>Working principle</b><p>{language.principle}</p></aside>

      <details class="lexical-bridge" data-lexical-bridge={language.slug}>
        <summary>
          <div>
            <p class="transfer-body-label">Vocabulary bridge</p>
            <h3>Cognates, loanwords, and false friends</h3>
            <p>{language.lexicalBridge.note}</p>
          </div>
          <span><b>{language.lexicalBridge.helpful.length}</b> helpful · <b>{language.lexicalBridge.traps.length}</b> traps</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="lexical-bridge-body">
          <section aria-labelledby={`${language.slug}-helpful-words`}>
            <header><p class="transfer-body-label">Use the similarity</p><h4 id={`${language.slug}-helpful-words`}>{language.lexicalBridge.helpfulLabel}</h4></header>
            <div class="helpful-word-list">
              {language.lexicalBridge.helpful.map((item) => <article>
                <div><b>{item.source}</b><span aria-hidden="true">→</span><strong>{item.english}</strong></div>
                <p>{item.note}</p>
              </article>)}
            </div>
          </section>
          <section aria-labelledby={`${language.slug}-word-traps`}>
            <header><p class="transfer-body-label">Check before using</p><h4 id={`${language.slug}-word-traps`}>{language.lexicalBridge.trapLabel}</h4></header>
            <div class="word-trap-list">
              {language.lexicalBridge.traps.map((item) => <article>
                <div><b>{item.source}</b><span>not simply</span><s>{item.tempting}</s><i aria-hidden="true">→</i><strong>{item.actual}</strong></div>
                <p>{item.example}</p>
              </article>)}
            </div>
          </section>
        </div>
      </details>

      <div class="transfer-patterns">
        {language.patterns.map((pattern, patternIndex) => <details class="transfer-pattern" data-transfer-pattern={`${language.slug}/${pattern.id}`} open={patternIndex === 0}>
          <summary>
            <div class="transfer-pattern-heading">
              <p class="transfer-pattern-meta"><span>{pattern.level}</span><span>{pattern.category}</span><code>{pattern.sourcePattern}</code></p>
              <h3>{pattern.title}</h3>
              <div class="transfer-preview" aria-label={`Possible transfer: ${pattern.listenFor}. Rebuild: ${pattern.rebuild}`}>
                <span><b>Possible transfer</b><q>{pattern.listenFor}</q></span>
                <i aria-hidden="true">→</i>
                <span><b>Rebuild</b><q>{pattern.rebuild}</q></span>
              </div>
            </div>
            <span class="transfer-disclosure" aria-hidden="true"></span>
          </summary>
          <div class="transfer-pattern-body">
            <section class="transfer-theory" aria-labelledby={`${language.slug}-${pattern.id}-why`}>
              <p class="transfer-body-label">Why the transfer is logical</p>
              <h4 id={`${language.slug}-${pattern.id}-why`}>The useful contrast</h4>
              <p>{pattern.explanation}</p>
            </section>
            <section class="transfer-examples" aria-labelledby={`${language.slug}-${pattern.id}-examples`}>
              <p class="transfer-body-label">Natural English</p>
              <h4 id={`${language.slug}-${pattern.id}-examples`}>Keep the meaning; vary the detail</h4>
              <ul>{pattern.examples.map((example) => <li>{example}</li>)}</ul>
            </section>
            <aside class="transfer-tutor-move">
              <p class="transfer-body-label">Tutor move</p>
              <p>{pattern.tutorMove}</p>
            </aside>
            <nav class="transfer-practice-links" aria-label={`Practice lessons for ${pattern.title}`}>
              <span>Practice the decision</span>
              {pattern.lessons.map((lesson) => <a href={lesson.route}><small>{lesson.level}</small>{lesson.topic}<b aria-hidden="true">→</b></a>)}
            </nav>
          </div>
        </details>)}
      </div>
      <a class="transfer-back-link" href="#transfer-guide-title">Back to guide <span aria-hidden="true">↑</span></a>
    </section>)}
  </div>
</section>

<style is:inline>
  .transfer-guide-counts{grid-template-columns:repeat(5,auto);gap:12px}.transfer-guide-counts div{min-width:70px;padding-left:12px}.transfer-guide-counts dt{font-size:8px}.transfer-guide-counts dd{font-size:31px}.lexical-bridge{margin:0 0 18px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.lexical-bridge[open]{border-color:var(--ink)}.lexical-bridge>summary{display:grid;grid-template-columns:1fr auto 24px;gap:14px;align-items:center;padding:15px 17px;cursor:pointer;list-style:none}.lexical-bridge>summary::-webkit-details-marker{display:none}.lexical-bridge>summary:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}.lexical-bridge>summary h3{margin:0;font:500 23px/1 var(--display)}.lexical-bridge>summary div>p:last-child{margin:6px 0 0;color:var(--ink-2);font-size:11px;line-height:1.5}.lexical-bridge>summary>span{color:var(--muted);font:500 9px/1.4 var(--mono);text-transform:uppercase}.lexical-bridge>summary>i::before{content:"+";color:var(--accent-deep)}.lexical-bridge[open]>summary>i::before{content:"−"}.lexical-bridge-body{display:grid;grid-template-columns:1fr 1fr;gap:1px;border-top:1px solid var(--line);background:var(--line)}.lexical-bridge-body>section{padding:17px;background:var(--paper)}.lexical-bridge-body h4{margin:0 0 10px}.helpful-word-list,.word-trap-list{display:grid;gap:6px}.helpful-word-list article,.word-trap-list article{padding:9px;border:1px solid var(--line);border-radius:7px;background:var(--surface)}.helpful-word-list article>div,.word-trap-list article>div{display:flex;gap:6px;align-items:baseline;flex-wrap:wrap}.helpful-word-list span,.word-trap-list i,.helpful-word-list strong,.word-trap-list strong{color:var(--accent-deep)}.helpful-word-list p,.word-trap-list p{margin:4px 0 0;color:var(--ink-2);font-size:10px;line-height:1.45}.word-trap-list div>span{color:var(--muted);font:500 8px/1.3 var(--mono);text-transform:uppercase}@media(max-width:1100px){.transfer-guide-counts{justify-content:start}}@media(max-width:900px){.lexical-bridge-body{grid-template-columns:1fr}}@media(max-width:720px){.transfer-guide-counts{width:100%;grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.transfer-guide-counts{grid-template-columns:1fr 1fr}.lexical-bridge>summary{grid-template-columns:1fr 20px}.lexical-bridge>summary>span{grid-column:1}.lexical-bridge>summary>i{grid-column:2;grid-row:1}}
</style>
