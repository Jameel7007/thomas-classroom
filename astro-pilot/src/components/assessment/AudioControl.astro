---
interface Props { clip: string; src: string; text: string; label?: string; ariaLabel?: string }
const { clip, src, text, label = "Play audio", ariaLabel = label } = Astro.props;
---
<audio
  class="listen-audio"
  controls
  preload="none"
  src={src}
  data-voice-clip={clip}
  data-audio-src={src}
  data-speak={text}
  aria-label={ariaLabel}
>
  <span aria-hidden="true">▶</span> {label}
</audio>
