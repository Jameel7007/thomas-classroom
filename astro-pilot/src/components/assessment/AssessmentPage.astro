---
import "../../styles/assessment.css";
import AssessmentEngine from "./AssessmentEngine.astro";
import FontStyles from "../FontStyles.astro";
import SocialMetadata from "../SocialMetadata.astro";
import SkipLink from "../SkipLink.astro";
import StructuredData from "../StructuredData.astro";
import { formatPageTitle } from "../../lib/page-title.mjs";
import { assessmentSchemaNodes } from "../../lib/structured-data.mjs";
interface PageMetadata { title: string; description: string; route: string; bodyClass?: string; engine: string }
interface Props { page: PageMetadata }
const { page } = Astro.props;
const canonical = new URL(page.route, Astro.site);
const documentTitle = formatPageTitle(page.title);
const structuredData = assessmentSchemaNodes({ page, canonical, site: Astro.site, documentTitle });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FontStyles />
    <title>{documentTitle}</title>
    <meta name="description" content={page.description} />
    <SocialMetadata title={documentTitle} description={page.description} canonical={canonical} />
    <StructuredData nodes={structuredData} />
  </head>
  <body class={page.bodyClass}>
    <SkipLink target="assessment-content" />
    <div id="assessment-content" tabindex="-1">
      <slot />
    </div>
    {page.engine === "assessment" && <AssessmentEngine />}
  </body>
</html>
