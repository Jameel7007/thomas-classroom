---
import SiteLayout from "../layouts/SiteLayout.astro";
import { blogPosts } from "../data/site-content";
---
<SiteLayout title="Teaching Notes · Thomas’s Classroom" description="Read Thomas’s Classroom notes about visible progress, CEFR, guided discovery, language transfer, and practical adult English learning." heading="Teaching Notes" lede="Methodology, curriculum, language transfer, and practical English learning—written for thoughtful learners and teachers." current="blog">
  <section class="tab-page">
    <p class="tab-overline">Blog</p><h2 class="tab-title">Ideas behind the lessons</h2>
    <p class="tab-lede">These are the first editorial lanes for explaining how the curriculum works and helping adult learners make better decisions about practice.</p>
    <div class="blog-grid">{blogPosts.map(([tag, title, summary]) => <article class="blog-card"><div class="post-meta"><span>{tag}</span><span>Draft lane</span></div><h2>{title}</h2><p>{summary}</p></article>)}</div>
  </section>
</SiteLayout>
