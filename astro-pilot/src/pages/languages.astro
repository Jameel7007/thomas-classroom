---
import SiteLayout from "../layouts/SiteLayout.astro";
import LanguageTransferGuide from "../components/languages/LanguageTransferGuide.astro";
import { transferCounts, transferLanguages } from "../data/language-transfer.mjs";
import "../styles/languages.css";

const counts = transferCounts();
const canonical = new URL("/languages/", Astro.site);
const guideId = `${canonical.href}#language-transfer-guide`;
const languageNames = transferLanguages.map((language: { name: string }) => language.name);
const languageList = `${languageNames.slice(0, -1).join(", ")}, and ${languageNames.at(-1)}`;
interface TransferSchemaLanguage { slug: string; name: string; note: string }
const guideSchema = {
  "@type": "ItemList",
  "@id": guideId,
  name: "First-language transfer guides for English learners",
  description: `Contrastive guidance, cognates, loanwords, and false friends for ${languageList}, linked to targeted A0–B2 English lessons.`,
  numberOfItems: transferLanguages.length,
  itemListElement: transferLanguages.map((language: TransferSchemaLanguage, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${language.name} to English transfer guide`,
    description: language.note,
    url: `${canonical.href}#transfer-${language.slug}`,
  })),
};
---
<SiteLayout title="Language Transfer · Thomas’s Classroom" description={`Compare ${counts.patterns} high-value transfer patterns, ${counts.helpfulWords} helpful cognates or loanwords, and ${counts.wordTraps} false friends or translation traps across ${counts.languages} first languages.`} heading="Language Transfer" lede="Use the learner’s first language as a map: notice the transfer pattern, understand the English contrast, rebuild the intended meaning, and practice the exact decision." current="languages" mainEntityId={guideId} additionalStructuredData={[guideSchema]}>
  <section class="tab-page">
    <p class="tab-overline">L1 → English</p><h2 class="tab-title">Your first language is evidence.</h2>
    <p class="tab-lede">Transfer errors are not random failures. They often reveal a logical pattern from another language and point directly toward a useful English decision. Use the grammar contrasts alongside carefully separated cognates, loanwords, false friends, and translation traps.</p>
    <LanguageTransferGuide languages={transferLanguages} counts={counts} />
  </section>
</SiteLayout>
