---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { curriculum, lessonSlug } from "../../lib/curriculum";
import { lessonRoutes } from "../../data/native-routes.mjs";

const lessonByKey = new Map<string, { slug: string }>();
lessonRoutes.forEach((page) => lessonByKey.set(`${page.level}/${page.slug}`, { slug: page.slug }));
const hues = { A0: 28, A1: 70, A2: 150, B1: 245, B2: 305 };
const accent = (code: keyof typeof hues) => {
  const hue = hues[code];
  return `--accent:oklch(.58 .13 ${hue});--accent-deep:oklch(.46 .13 ${hue});--accent-tint:oklch(.965 .045 ${hue});--accent-soft:oklch(.92 .045 ${hue})`;
};
const skillLabels = {
  listening: ["01", "Listening"],
  reading: ["02", "Reading"],
  speaking: ["03", "Speaking"],
  writing: ["04", "Writing"],
} as const;
---
<SiteLayout
  title="English Curriculum Map · A0–B2 · Thomas’s Classroom"
  description="Explore the complete Thomas’s Classroom curriculum from A0 to B2, including grammar, vocabulary, practical abilities, and published interactive lessons."
  heading="The English Curriculum Map"
  lede="A complete path from first words to confident independent communication, designed for calm, thoughtful lessons with adult learners."
  current="curriculum"
  showLevelJumps
>
  <div class="sections">
    <section class="page-intro">
      <div class="explainer-grid">
        <div><p class="explainer-kicker">How to read the map</p><h2>Ability first. Grammar in service of real communication.</h2></div>
        <div class="explainer-points">
          <p><b>Each level is a destination.</b> The “can do” panel describes useful evidence, not boxes to tick.</p>
          <p><b>Grammar and vocabulary provide the tools.</b> Published lessons open directly; the rest remain visible as the planned route.</p>
          <p><b>Listening, reading, speaking, and writing stay connected.</b> Progress means using language across skills.</p>
        </div>
      </div>
    </section>

    {curriculum.map((level) => (
      <section class="level" id={`lvl-${level.code}`} style={accent(level.code)}>
        <div class="level-head">
          <div class="level-mark"><span class="level-code">{level.code}</span><span class="level-name">{level.name}</span></div>
          <div>
            <p class="level-cefr">{level.cefr}</p>
            <p class="level-blurb">{level.blurb}</p>
            <div class="level-chips">
              <span class="chip"><span class="chip-k">Guided study</span>{level.hours}</span>
              <span class="chip"><span class="chip-k">GSE range</span>{level.gse}</span>
            </div>
          </div>
        </div>

        <div class="assessment-band" aria-label={`${level.code} end-of-level diagnostic`}>
          <a class:list={["assessment-card", level.code !== "A0" && "soon"]} href={`/assessments/${level.code.toLowerCase()}-exit/`}><span class="assessment-label">After completing the level</span><h3>{level.code} End-of-Level Diagnostic</h3><p>{level.code === "A0" ? "Check the complete foundation and decide whether the learner is ready to begin A1." : "Open the current diagnostic page and its planned assessment scope."}</p></a>
          <div class="assessment-evidence"><span class="assessment-label">Evidence of progress</span><p>The learner notices, chooses, builds, understands, and produces language across grammar, vocabulary, receptive skills, and real communication.</p></div>
        </div>

        <div class="cando">
          <h3 class="cando-title">By the end of <strong>{level.code}</strong>, a learner can…</h3>
          <ul class="cando-list">{level.canDo.map((ability) => <li class="cando-item"><span class="cando-bullet"></span>{ability}</li>)}</ul>
        </div>

        <div class="grid">
          {[
            { label: "Grammar", index: "Aa", items: level.grammar },
            { label: "Vocabulary & Topics", index: "¶", items: level.vocab },
          ].map((group) => (
            <article class="card card--wide">
              <header class="card-head"><span class="card-index">{group.index}</span><h3 class="card-label">{group.label}</h3></header>
              <div class="chips-wrap">
                {group.items.map((item) => {
                  const lesson = lessonByKey.get(`${level.code}/${lessonSlug(item)}`);
                  return lesson
                    ? <a class="vchip" href={`/lessons/${level.code.toLowerCase()}/${lesson.slug}/`}>{item}<span aria-hidden="true">→</span></a>
                    : <span class="vchip vchip--soon" aria-disabled="true">{item}<span class="soon-tag">Soon</span></span>;
                })}
              </div>
            </article>
          ))}

          {Object.entries(level.skills).map(([key, items]) => {
            const [index, label] = skillLabels[key as keyof typeof skillLabels];
            return <article class="card">
              <header class="card-head"><span class="card-index">{index}</span><h3 class="card-label">{label}</h3></header>
              <ul class="list">{items.map((item) => <li class="item-static"><span class="item-tick"></span><span>{item}</span></li>)}</ul>
            </article>;
          })}
        </div>
      </section>
    ))}
  </div>
</SiteLayout>
