---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CurriculumFinder from "../../components/curriculum/CurriculumFinder.astro";
import { curriculum } from "../../lib/curriculum";
import { getLessonsForLevel, readyLessons } from "../../data/lesson-catalog.mjs";

const hues = { A0: 28, A1: 70, A2: 150, B1: 245, B2: 305, C1: 345 };
const accent = (code: keyof typeof hues) => {
  const hue = hues[code];
  return `--accent:oklch(.58 .13 ${hue});--accent-deep:oklch(.46 .13 ${hue});--accent-tint:oklch(.965 .045 ${hue});--accent-soft:oklch(.92 .045 ${hue})`;
};
const skillLabels = {
  listening: ["01", "Listening"],
  reading: ["02", "Reading"],
  speaking: ["03", "Speaking"],
  writing: ["04", "Writing"],
} as const;
const canonical = new URL("/curriculum/", Astro.site);
const lessonListId = `${canonical.href}#lesson-list`;
const lessonList = {
  "@type": "ItemList",
  "@id": lessonListId,
  name: "Thomas’s Classroom A0–C1 lessons",
  numberOfItems: readyLessons.length,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: readyLessons.map((lesson, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: lesson.topic,
    url: new URL(lesson.route, Astro.site).href,
  })),
};
---
<SiteLayout
  title="English Curriculum Map · A0–C1 · Thomas’s Classroom"
  description="Explore the Thomas’s Classroom curriculum from A0 to C1, including grammar, vocabulary, practical abilities, published interactive lessons, and planned advanced work."
  heading="The English Curriculum Map"
  lede="A coherent path from first words to precise, flexible advanced communication, designed for calm, thoughtful lessons with adult learners."
  current="curriculum"
  pageClass="curriculum-page"
  mainEntityId={lessonListId}
  additionalStructuredData={[lessonList]}
>
  <div class="sections" data-curriculum-map>
    <CurriculumFinder />

    <div class="curriculum-empty" data-curriculum-empty>
      <p class="finder-kicker">No matching topics</p>
      <h2>Try a broader search.</h2>
      <p>Change a filter or clear the search to return to the complete A0–C1 path.</p>
    </div>

    {curriculum.map((level) => (
      <section class="level" id={`lvl-${level.code}`} style={accent(level.code)} data-curriculum-level={level.code}>
        <div class="level-head">
          <div class="level-mark"><span class="level-code">{level.code}</span><span class="level-name">{level.name}</span></div>
          <div>
            <p class="level-cefr">{level.cefr}</p>
            <p class="level-blurb">{level.blurb}</p>
            <div class="level-chips">
              <span class="chip"><span class="chip-k">Guided study</span>{level.hours}</span>
              <span class="chip"><span class="chip-k">GSE range</span>{level.gse}</span>
            </div>
          </div>
        </div>

        <div class="lesson-path" data-curriculum-topic-group data-curriculum-lesson-path={level.code}>
          <div class="lesson-path-head" data-curriculum-detail>
            <div>
              <p class="finder-kicker">Click through the course</p>
              <h3>{level.code} lesson path</h3>
            </div>
            <p>{getLessonsForLevel(level.code).filter((lesson) => lesson.status === "ready").length} of {getLessonsForLevel(level.code).length} lessons available now</p>
          </div>
          <div class="lesson-path-list">
            {getLessonsForLevel(level.code).map((lesson) => lesson.status === "ready" ? (
              <a
                class="lesson-step"
                href={lesson.route}
                data-curriculum-topic
                data-topic-type={lesson.contentType}
                data-topic-availability={lesson.status}
                data-lesson-sequence={lesson.sequence}
              >
                <span class="lesson-step-number">{String(lesson.sequence).padStart(2, "0")}</span>
                <span class="lesson-step-copy">
                  <strong>{lesson.topic}</strong>
                  <span>{lesson.contentType === "grammar" ? "Grammar" : "Vocabulary & topic"} · {lesson.description}</span>
                </span>
                <span class="lesson-step-action">Open lesson <span aria-hidden="true">→</span></span>
              </a>
            ) : (
              <article
                class="lesson-step lesson-step--planned"
                aria-disabled="true"
                data-curriculum-topic
                data-topic-type={lesson.contentType}
                data-topic-availability={lesson.status}
                data-lesson-sequence={lesson.sequence}
              >
                <span class="lesson-step-number">{String(lesson.sequence).padStart(2, "0")}</span>
                <span class="lesson-step-copy">
                  <strong>{lesson.topic}</strong>
                  <span>{lesson.contentType === "grammar" ? "Grammar" : "Vocabulary & topic"} · Planned lesson</span>
                </span>
                <span class="soon-tag">Soon</span>
              </article>
            ))}
          </div>
        </div>

        <div class="cando" data-curriculum-detail>
          <h3 class="cando-title">By the end of <strong>{level.code}</strong>, a learner can…</h3>
          <ul class="cando-list">{level.canDo.map((ability) => <li class="cando-item"><span class="cando-bullet"></span>{ability}</li>)}</ul>
        </div>

        <div class="grid">
          {Object.entries(level.skills).map(([key, items]) => {
            const [index, label] = skillLabels[key as keyof typeof skillLabels];
            return <article class="card" data-curriculum-detail>
              <header class="card-head"><span class="card-index">{index}</span><h3 class="card-label">{label}</h3></header>
              <ul class="list">{items.map((item) => <li class="item-static"><span class="item-tick"></span><span>{item}</span></li>)}</ul>
            </article>;
          })}
        </div>

        {level.code === "A0" && <aside class="curriculum-guide" aria-labelledby="curriculum-guide-title" data-curriculum-detail>
          <div><p class="curriculum-guide-kicker">A simple path</p><h2 id="curriculum-guide-title">How this curriculum works</h2></div>
          <p>Each level describes what learners should be able to do. Grammar and vocabulary provide the tools for practical communication across speaking, listening, reading, and writing.</p>
        </aside>}
      </section>
    ))}
  </div>
</SiteLayout>
