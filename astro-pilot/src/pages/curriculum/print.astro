---
import "../../styles/curriculum-print.css";
import FontStyles from "../../components/FontStyles.astro";
import SocialMetadata from "../../components/SocialMetadata.astro";
import { curriculum } from "../../lib/curriculum";
import { getLessonsForLevel, lessonCounts } from "../../data/lesson-catalog.mjs";

const hues: Record<string, number> = { A0: 28, A1: 70, A2: 150, B1: 245, B2: 305, C1: 345 };
const accent = (code: string) => {
  const hue = hues[code];
  return `--accent:oklch(0.58 0.13 ${hue});--accent-deep:oklch(0.46 0.13 ${hue});--accent-tint:oklch(0.965 0.045 ${hue});--accent-soft:oklch(0.92 0.045 ${hue});`;
};
const skills = [["listening", "Listening"], ["reading", "Reading"], ["speaking", "Speaking"], ["writing", "Writing"]] as const;
const lessonCount = lessonCounts().total;
const title = "English Curriculum Map · A0 → C1 · Print";
const description = "Print-ready reference guide for the complete Thomas's Classroom A0–C1 English curriculum.";
const canonical = new URL("/curriculum/", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FontStyles />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <SocialMetadata title={title} description={description} canonical={canonical} />
  </head>
  <body>
    <main>
    <section class="sheet cover">
      <p class="overline">CEFR Framework · Reference Guide</p>
      <h1>The English<br />Curriculum Map</h1>
      <p class="lede">From absolute beginner to precise advanced communication — what you study, and what you can actually <em>do</em>, at every level of English from <strong>A0</strong> through <strong>C1</strong>.</p>
      <div class="cover-stats">
        <span class="cstat"><b>{curriculum.length}</b> levels</span><span class="cstat-div"></span>
        <span class="cstat"><b>A0–C1</b> CEFR range</span><span class="cstat-div"></span>
        <span class="cstat"><b>{lessonCount}+</b> lessons</span>
      </div>
      <div class="index">
        {curriculum.map((level) => (
          <div class="index-row" style={accent(level.code)}>
            <span class="index-code" style="color:var(--accent-deep)">{level.code}</span>
            <span class="index-title"><b>{level.name}</b><span>{level.cefr}</span></span>
            <span class="index-hours">{level.hours}</span>
          </div>
        ))}
      </div>
      <div class="cover-foot"><span>Common European Framework of Reference</span><span>A0 → C1</span></div>
    </section>

    {curriculum.map((level) => (
      <section class="sheet" style={accent(level.code)}>
        <div class="level-head">
          <span class="level-code">{level.code}</span>
          <div class="level-headtext">
            <h2 class="level-name">{level.name}</h2>
            <p class="level-cefr">{level.cefr}</p>
            <div class="level-meta-chips">
              <span class="lchip">Guided study <b>{level.hours}</b></span>
              <span class="lchip">GSE <b>{level.gse}</b></span>
            </div>
          </div>
        </div>
        <p class="level-blurb">{level.blurb}</p>
        <div class="cando">
          <h3 class="cando-title">By the end of <span class="code-inline">{level.code}</span>, a learner can…</h3>
          <ul class="cando-list">{level.canDo.map((ability) => <li class="cando-item"><span class="cando-bullet"></span>{ability}</li>)}</ul>
        </div>
        <p class="section-label">Grammar</p>
        <div class="cols">{getLessonsForLevel(level.code).filter((lesson) => lesson.contentType === "grammar").map((lesson) => <div class="gitem"><span class="gbull"></span>{lesson.topic}</div>)}</div>
        <p class="section-label">Vocabulary &amp; Topics</p>
        <div class="chips-wrap">{getLessonsForLevel(level.code).filter((lesson) => lesson.contentType === "vocabulary").map((lesson) => <span class="vchip">{lesson.topic}</span>)}</div>
        <p class="section-label">The Four Skills</p>
        <div class="skills-grid">
          {skills.map(([key, label]) => <div class="skill"><h4>{label}</h4><ul>{level.skills[key].map((item) => <li><span class="t"></span>{item}</li>)}</ul></div>)}
        </div>
        <div class="sheet-foot"><span>{level.code} · {level.name}</span><span>English Curriculum Map</span></div>
      </section>
    ))}
    </main>
    <script>
      const autoPrint = () => window.setTimeout(() => window.print(), 500);
      if (document.fonts?.ready) document.fonts.ready.then(autoPrint);
      else window.addEventListener("load", autoPrint);
    </script>
  </body>
</html>
