---
import homeStyles from "../styles/home.css?raw";
import FontStyles from "../components/FontStyles.astro";
import HomeInteractions from "../components/home/HomeInteractions.astro";
import LevelCheckPreview from "../components/home/LevelCheckPreview.astro";
import SocialMetadata from "../components/SocialMetadata.astro";
import SkipLink from "../components/SkipLink.astro";
import StructuredData from "../components/StructuredData.astro";
import { curriculum } from "../lib/curriculum";
import { getLessonsForLevel, lessonCounts } from "../data/lesson-catalog.mjs";
import { siteSettings } from "../data/site-settings.mjs";
import { schemaIds, siteIdentityNodes, webPageNode } from "../lib/structured-data.mjs";
const title = "Welcome to Thomas's Classroom — American English Tutor";
const description = "Conversation and pronunciation lessons with a native American English speaker. Welcome to Thomas's Classroom — clear what's blocking your English.";
const canonical = new URL("/", Astro.site);
const bookingUrl = siteSettings.bookingUrl;
const bookingLabel = siteSettings.bookingLabel;
const ratingValue = siteSettings.ratingValue;
const reviewCount = siteSettings.reviewCount;
const curriculumCounts = lessonCounts();
const levelHues: Record<string, number> = { A0: 28, A1: 70, A2: 150, B1: 245, B2: 305, C1: 345 };
const curriculumLevels = curriculum.map((level) => {
  const lessons = getLessonsForLevel(level.code);
  const ready = lessons.filter((lesson) => lesson.status === "ready");
  return {
    ...level,
    total: lessons.length,
    ready: ready.length,
    firstLesson: ready[0],
    hue: levelHues[level.code],
  };
});
const presentPerfectNoticingSentence = "Yesterday I go to my first lesson, and it change everything.";
const ids = schemaIds(Astro.site);
const structuredData = [
  ...siteIdentityNodes(Astro.site),
  webPageNode({ canonical, title, description, site: Astro.site, mainEntityId: ids.tutor }),
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FontStyles />
    <style is:inline set:html={homeStyles} />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <SocialMetadata title={title} description={description} canonical={canonical} />
    <StructuredData nodes={structuredData} />
    <style is:inline>
      .curriculum-home{padding:clamp(5rem,10vh,7.5rem) clamp(1.2rem,4vw,3rem);border-top:1px solid color-mix(in srgb,var(--ink) 12%,transparent);background:linear-gradient(180deg,var(--card),var(--paper))}
      .curriculum-home-head{max-width:72rem;margin:0 auto 2.6rem;display:grid;grid-template-columns:minmax(0,.95fr) minmax(320px,.75fr);gap:clamp(2rem,6vw,5rem);align-items:end}.curriculum-home-head h2{max-width:12ch}.curriculum-home-intro>p{margin:0;color:var(--ink-soft);font-size:1.06rem;line-height:1.72}.curriculum-home-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.4rem}
      .curriculum-action{display:inline-flex;align-items:center;gap:.5rem;min-height:46px;padding:.7rem .95rem;border:1px solid color-mix(in srgb,var(--ink) 28%,transparent);border-radius:10px;background:var(--card);color:var(--ink);font-family:'IBM Plex Mono',monospace;font-size:.72rem;font-weight:600;text-decoration:none;text-transform:uppercase;letter-spacing:.035em;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}.curriculum-action:hover{transform:translateY(-2px);border-color:var(--teal);box-shadow:0 14px 24px -20px var(--teal-deep)}.curriculum-action--primary{border-color:var(--ink);background:var(--ink);color:var(--paper)}.curriculum-action:focus-visible,.curriculum-level-card:focus-visible{outline:3px solid var(--pen);outline-offset:4px}
      .curriculum-level-grid{max-width:72rem;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.curriculum-level-card{min-height:248px;padding:1.45rem;border:1px solid color-mix(in srgb,var(--level-deep) 34%,var(--ink) 8%);border-radius:16px;background:linear-gradient(145deg,var(--card),var(--level-tint));color:var(--ink);text-decoration:none;display:flex;flex-direction:column;box-shadow:0 18px 36px -32px var(--level-deep);transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.curriculum-level-card:hover{transform:translateY(-5px);border-color:var(--level-deep);box-shadow:0 24px 44px -30px var(--level-deep)}
      .curriculum-level-top{display:flex;align-items:baseline;gap:.85rem}.curriculum-level-top b{color:var(--level-deep);font-family:'Albert Sans',sans-serif;font-size:2.75rem;line-height:1;font-weight:750;letter-spacing:-.04em}.curriculum-level-top span{font-family:'Fraunces',serif;font-size:1.15rem;font-style:italic;font-variation-settings:'opsz' 40,'wght' 560}.curriculum-level-copy{display:block;margin-top:1rem;color:var(--ink-soft);font-size:.94rem;line-height:1.55}.curriculum-level-meta{display:flex;align-items:center;gap:.3rem;margin-top:auto;padding-top:1.25rem;color:var(--level-deep);font-family:'IBM Plex Mono',monospace;font-size:.7rem}.curriculum-level-meta strong{font-weight:700}.curriculum-level-meta i{margin-left:auto;font-size:1rem;font-style:normal}
      .curriculum-promise{max-width:72rem;margin:1.2rem auto 0;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid color-mix(in srgb,var(--ink) 18%,transparent);border-radius:16px;background:var(--card);overflow:hidden}.curriculum-promise>div{display:grid;grid-template-columns:auto 1fr;gap:.9rem;padding:1.3rem 1.4rem;border-right:1px solid color-mix(in srgb,var(--ink) 14%,transparent)}.curriculum-promise>div:last-child{border-right:0}.curriculum-promise span{color:var(--pen);font-family:'IBM Plex Mono',monospace;font-size:.72rem;font-weight:700}.curriculum-promise p{margin:0;color:var(--ink-soft);font-size:.86rem;line-height:1.5}.curriculum-promise b{display:block;margin-bottom:.2rem;color:var(--ink);font-size:1rem}
      @media(max-width:900px){.curriculum-home-head{grid-template-columns:1fr;gap:1.5rem;align-items:start}.curriculum-home-head h2{max-width:15ch}.curriculum-level-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.curriculum-promise{grid-template-columns:1fr}.curriculum-promise>div{border-right:0;border-bottom:1px solid color-mix(in srgb,var(--ink) 14%,transparent)}.curriculum-promise>div:last-child{border-bottom:0}}
      @media(max-width:580px){.hero-break{display:block}.curriculum-level-grid{grid-template-columns:1fr}.curriculum-level-card{min-height:0}.curriculum-home-actions{display:grid}.curriculum-action{justify-content:space-between}}
    </style>
  </head>
  <body data-public-review-count={reviewCount}>
<SkipLink target="main-content" className="home-skip" />
<div id="loader" aria-hidden="true"><div class="word">Hello<span class="dot">.</span></div></div>

<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>

<header id="nav">
  <a class="logo" href="#top" data-cursor aria-label="Thomas's Classroom — back to top">
    <span class="logo-full">Thomas's Classroom</span><span class="logo-short" aria-hidden="true">Thomas's</span><span class="dot" aria-hidden="true">.</span>
  </a>
  <div class="nav-right">
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class="nav-link nav-link--primary" href="/curriculum/" data-cursor>Curriculum</a>
      <a class="nav-link" href="/reading/" data-cursor>Reading</a>
      <a class="nav-link" href="#method" data-cursor>Method</a>
      <a class="nav-link" href="#students" data-cursor>Students</a>
      <a class="nav-link" href="#numbers" data-cursor>Results</a>
      <a class="nav-link" href="#faq" data-cursor>FAQ</a>
      <a class="nav-link" href="#about" data-cursor>About</a>
      <a class="nav-link" href="/tutor/" data-cursor>Tutor guide</a>
      <a class="nav-book" href={bookingUrl} data-booking-link data-booking-position="navigation" data-cursor>Book a lesson</a>
    </nav>
    <details class="mobile-nav" data-mobile-nav>
      <summary
        class="menu-toggle"
        data-mobile-nav-toggle
        data-cursor
        aria-label="Navigation menu"
        aria-controls="mobileNavPanel"
      >
        <span>Menu</span><span class="menu-icon" aria-hidden="true"></span>
      </summary>
      <nav class="mobile-nav-panel" id="mobileNavPanel" aria-label="Mobile navigation">
        <a class="mobile-nav-link" href="/curriculum/" data-cursor>Curriculum</a>
        <a class="mobile-nav-link" href="/reading/" data-cursor>Reading Lab</a>
        <a class="mobile-nav-link" href="#method" data-cursor>Method</a>
        <a class="mobile-nav-link" href="#students" data-cursor>Students</a>
        <a class="mobile-nav-link" href="#numbers" data-cursor>Results</a>
        <a class="mobile-nav-link" href="#faq" data-cursor>FAQ</a>
        <a class="mobile-nav-link" href="#about" data-cursor>About Thomas</a>
        <a class="mobile-nav-link" href="/tutor/" data-cursor>Tutor Planning Guide</a>
        <a class="mobile-nav-link mobile-nav-link--book" href={bookingUrl} data-booking-link data-booking-position="mobile-navigation" data-cursor>Book a lesson</a>
      </nav>
    </details>
  </div>
</header>

<main id="main-content" tabindex="-1">
<!-- ============= HERO ============= -->
<header class="hero" id="top">
  <div class="eyebrow"><span>A0–C1 English curriculum<br>Clear theory · active practice · real communication</span></div>
  <h1 class="hero-word" id="heroWord">English<span class="dot">.</span><br class="hero-break" /> Clearly<span class="dot">.</span></h1>
  <div class="hero-ipa">A complete learning path &nbsp;·&nbsp; one useful pattern at a time</div>

  <div class="hero-row">
    <div>
      <div class="greeting-line"><span id="greeting">Start here —</span></div>
      <p class="hero-copy">
        Thomas’s Classroom is a complete curriculum for adult learners, from first words
        to advanced, precise English. <strong>See the whole path, choose your level, and open
        a lesson built to make you notice, understand, practice, and speak.</strong>
      </p>
      <div class="tutor-note" style="margin-top:.8rem;position:relative;">
        real talk: most students are one level higher than they think
      </div>
    </div>
    <div class="hero-actions">
      <div class="hero-cta-group">
        <a class="btn" href="/curriculum/" data-cursor>
          <span>Explore the curriculum</span><span class="price">A0–C1 →</span>
        </a>
        <a class="hero-secondary-link" href="/assessments/" data-cursor>
          Not sure where to start? Open diagnostics <span aria-hidden="true">→</span>
        </a>
        <LevelCheckPreview />
        <a class="hero-tertiary-link" href={bookingUrl} data-booking-link data-booking-position="hero" data-cursor>
          Learn with Thomas in a one-on-one lesson <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="stats">
      <div><b>{curriculumCounts.total}</b> topics</div>
      <div><b>{curriculumCounts.ready}</b> full lessons</div>
      <div data-public-proof="lessons-taught-hero"><b id="statLessons">{siteSettings.lessonsTaughtClaim}</b></div>
      <div data-public-proof="rating-hero"><b>{ratingValue} ★ rating</b></div>
      <div data-public-proof="reviews-hero"><b>{reviewCount} reviews</b></div>
    </div>
  </div>
  <div class="scroll-cue">SCROLL ↓</div>
</header>

<!-- ============= CURRICULUM FIRST ============= -->
<section class="curriculum-home" id="curriculum" aria-labelledby="curriculum-home-title">
  <div class="curriculum-home-head">
    <div>
      <span class="kicker">The curriculum is the classroom</span>
      <h2 id="curriculum-home-title">Choose a level.<br />See every next step.</h2>
    </div>
    <div class="curriculum-home-intro">
      <p>Every level connects grammar, vocabulary, listening, reading, speaking, and writing. Published lessons are interactive; planned lessons stay visible so the complete path is always honest.</p>
      <div class="curriculum-home-actions">
        <a class="curriculum-action curriculum-action--primary" href="/curriculum/">Browse all {curriculumCounts.total} topics <span aria-hidden="true">→</span></a>
        <a class="curriculum-action" href="/reading/">Open Reading Lab</a>
        <a class="curriculum-action" href="/assessments/">Open diagnostics</a>
      </div>
    </div>
  </div>

  <div class="curriculum-level-grid" aria-label="Curriculum levels">
    {curriculumLevels.map((level) => (
      <a
        class="curriculum-level-card"
        href={`/curriculum/?level=${level.code}#lvl-${level.code}`}
        style={`--level-accent:oklch(.58 .13 ${level.hue});--level-deep:oklch(.43 .13 ${level.hue});--level-tint:oklch(.955 .045 ${level.hue})`}
      >
        <span class="curriculum-level-top"><b>{level.code}</b><span>{level.name}</span></span>
        <span class="curriculum-level-copy">{level.blurb}</span>
        <span class="curriculum-level-meta"><strong>{level.ready} of {level.total}</strong> lessons available <i aria-hidden="true">→</i></span>
      </a>
    ))}
  </div>

  <div class="curriculum-promise" aria-label="What every lesson includes">
    <div><span>01</span><p><b>Clear theory</b>Large examples explain form, meaning, use, and spoken English.</p></div>
    <div><span>02</span><p><b>Active drills</b>Tap, build, correct, retrieve, and get meaningful feedback.</p></div>
    <div><span>03</span><p><b>Real communication</b>Finish by using the language for an adult, practical purpose.</p></div>
  </div>
</section>

<!-- ============= MARQUEE ============= -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track" id="marqueeTrack">
    <span>Hello<i>·</i>Olá<i>·</i>Hola<i>·</i>Привіт<i>·</i>Merhaba<i>·</i>Ciao<i>·</i>Cześć<i>·</i>Ahoj<i>·</i>你好<i>·</i>こんにちは<i>·</i>Γεια σου<i>·</i></span>
  </div>
</div>

<!-- ============= CORRECTION THEATER ============= -->
<div class="pin-wrap" id="pinWrap">
  <div class="pin-stage" id="pinStage">
    <div class="stage-label"><b>01 NOTICE</b><b>02 CLEAR</b><b>03 DRILL</b></div>
    <p
      data-present-perfect-noticing-sentence
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0"
    >{presentPerfectNoticingSentence}</p>
    <p class="sentence" aria-hidden="true" data-tokenized-example="present-perfect-noticing">
      “Yesterday I <span class="err">go</span> <span class="fix">went&nbsp;</span>to my first lesson, and it{' '}
      <span class="err">change</span> <span class="fix">changed&nbsp;</span>everything.”
    </p>
    <p class="annotation">
      <span class="pen-note">past time → past form.</span> Your brain already knows this rule —
      it just hasn't become a reflex yet. So we drill it until it is one.
    </p>
    <div class="drill-chips">
      <span class="chip" data-cursor>I went →</span>
      <span class="chip" data-cursor>She went →</span>
      <span class="chip" data-cursor>We didn't go →</span>
      <span class="chip" data-cursor>Did you go…?</span>
      <span class="chip" data-cursor>your turn →</span>
    </div>
  </div>
</div>

<!-- ============= METHOD ============= -->
<section id="method">
  <div class="section-head">
    <span class="kicker">The Clearing Method</span>
    <h2>Mistakes aren't failures.<br>They're the lesson plan.</h2>
    <div class="tutor-note" style="right:4%;top:18%;">every error = a map of the student's first language</div>
  </div>
  <div class="method-grid">
    <div class="method-step">
      <div class="num">1</div>
      <div>
        <h3>Notice</h3>
        <p>We talk about your real life — your job, your city, your plans. When an error
        appears, we don't skip past it. <b>We catch the exact pattern</b>, usually something
        your first language is quietly importing into English.</p>
      </div>
    </div>
    <div class="method-step">
      <div class="num">2</div>
      <div>
        <h3>Clear</h3>
        <p>One small idea at a time, explained in seconds — not a grammar lecture.
        You rebuild the sentence yourself, step by step, <b>so the fix comes from your
        own thinking</b>, not from memorizing mine.</p>
      </div>
    </div>
    <div class="method-step">
      <div class="num">3</div>
      <div>
        <h3>Drill</h3>
        <p>Then we make it automatic: quick, varied repetitions until the correct form
        is faster than the old mistake. <b>You finish the lesson saying it right without
        thinking</b> — which is the whole point of speaking.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============= ABOUT ============= -->
<section id="about">
  <div class="section-head reveal">
    <span class="kicker">Who's teaching</span>
    <h2>An American who explains<br>the part textbooks skip.</h2>
  </div>
  <div class="about-grid reveal">
    <div class="about-portrait">
      <img src="/assets/thomas-portrait.jpg" alt="Thomas, an American English tutor based in Chiapas, Mexico." width="480" height="640" loading="lazy" decoding="async" />
    </div>
    <div class="about-body">
      <p>I'm <b>Thomas</b> — born and raised in the United States, now living in Chiapas, Mexico.
      I teach conversation and pronunciation to working adults: developers, professionals, and anyone
      who reads English far better than they can speak it.</p>
      <p>I'm not a textbook. Most students already know more grammar than they think — what's missing
      is the <b>reflex</b>. So we talk about your real life, I catch the exact patterns your first
      language quietly imports into English, and we drill them until the right form is automatic.</p>
      <p>With {siteSettings.lessonsTaughtClaim}, the thing I care about most is simple: you leave every session having{" "}
      <b>said something real</b> — and a little more sure of yourself than when you walked in.</p>
      <div class="about-facts">
        <span class="fact">Native U.S. speaker</span>
        <span class="fact">Based in Chiapas, MX</span>
        <span class="fact" data-public-proof="lessons-taught-about">{siteSettings.lessonsTaughtClaim}</span>
        <span class="fact" data-public-proof="rating-about">{ratingValue}★ rating</span>
        <span class="fact">Conversation + pronunciation</span>
      </div>
    </div>
  </div>
</section>

<!-- ============= STUDENTS - ANTI-GRID ============= -->
<section class="students" id="students">
  <div class="section-head">
    <span class="kicker">Who I teach</span>
    <h2>Your first language isn't a problem.<br>It's the starting point.</h2>
  </div>
  <div class="deck">
    <div class="scard" data-cursor>
      <div class="flag">🇧🇷</div>
      <h3>Developers in Brazil</h3>
      <p>Tech interviews, daily standups, and the meeting where you finally disagree out loud.</p>
      <div class="transfer">fazer → it's <b>make</b> a decision, <b>do</b> the work</div>
    </div>
    <div class="scard" data-cursor>
      <div class="flag">🇺🇦</div>
      <h3>Professionals from Ukraine</h3>
      <p>Workplace English for new careers abroad — emails, clients, and small talk that lands.</p>
      <div class="transfer">no "to be" in Ukrainian → "I <b>am</b> ready", not "I ready"</div>
    </div>
    <div class="scard" data-cursor>
      <div class="flag">🇨🇴</div>
      <h3>Spanish speakers everywhere</h3>
      <p>From Bogotá to Monterrey to Florida — exam prep, HR meetings, patients and clients.</p>
      <div class="transfer">estoy de acuerdo → "I agree", not "I am agree"</div>
    </div>
    <div class="scard" data-cursor>
      <div class="flag">🇹🇷</div>
      <h3>Readers who can't speak yet</h3>
      <p>B2 on paper, A1 out loud? We close the gap between what you know and what you say.</p>
      <div class="transfer">SOV → SVO: the verb moves <b>up front</b> in English</div>
    </div>
    <div class="scard" data-cursor>
      <div class="flag">🌍</div>
      <h3>Anyone tired of freezing</h3>
      <p>If you understand Netflix but panic in meetings, you're exactly who this works for.</p>
      <div class="transfer">fluency = automaticity, and automaticity is trainable</div>
    </div>
    <div class="scard" data-cursor>
      <div class="flag">🇮🇹</div>
      <h3>Italians going global</h3>
      <p>Strong on vocabulary, tangled in tenses — especially the simple past Italian quietly skips.</p>
      <div class="transfer">ieri ho mangiato → "I <b>ate</b>", not "I have eaten"</div>
    </div>
  </div>
</section>

<!-- ============= NUMBERS ============= -->
<section id="numbers">
  <div class="section-head">
    <span class="kicker">From real lesson ratings</span>
    <h2>Students grade every lesson.<br>Here's the report card.</h2>
    <div class="tutor-note" style="right:6%;top:30%;">reassurance first — confidence unlocks output</div>
  </div>
  <div class="numbers-grid">
    <div class="ncard"><div class="big"><span data-count="4.9">4.9</span></div><div class="lbl">Reassurance — you'll feel safe making mistakes</div></div>
    <div class="ncard"><div class="big"><span data-count="4.9">4.9</span></div><div class="lbl">Clarity — explanations that take seconds, not lectures</div></div>
    <div class="ncard"><div class="big"><span data-count="4.8">4.8</span></div><div class="lbl">Progress — you leave each lesson saying something new</div></div>
    <div class="ncard"><div class="big"><span data-count="4.8">4.8</span></div><div class="lbl">Preparation — materials built for you, not from a book</div></div>
  </div>
  <p class="numbers-foot" data-public-proof="results-summary">{siteSettings.lessonsTaughtClaim} · {ratingValue}★ overall · {reviewCount} five-star reviews</p>
</section>

<!-- ============= WHAT TO EXPECT ============= -->
<section id="lessons">
  <div class="section-head reveal">
    <span class="kicker">What to expect</span>
    <h2>What actually<br>happens in a lesson.</h2>
  </div>
  <div class="numbers-grid">
    <div class="ncard"><div class="big">01</div><div class="lbl">We open in English — your week, your work, the meeting that went sideways. Real talk, not roleplay.</div></div>
    <div class="ncard"><div class="big">02</div><div class="lbl">I listen for patterns and catch them on the spot — the exact thing tripping you up, named in seconds.</div></div>
    <div class="ncard"><div class="big">03</div><div class="lbl">You rebuild the sentence yourself, then we drill it — fast and varied — until the right form beats the old habit.</div></div>
    <div class="ncard"><div class="big">04</div><div class="lbl">You leave with notes and one thing to practice, built for you — not pulled from a book.</div></div>
  </div>
  <p class="numbers-foot">50 minutes · one-on-one · online · materials made for you.</p>
</section>

<!-- ============= FAQ ============= -->
<section id="faq">
  <div class="section-head reveal">
    <span class="kicker">Before you book</span>
    <h2>Questions I get<br>before lesson one.</h2>
  </div>
  <div class="faq-list reveal">
    <details class="faq-item"><summary data-cursor>Do I need to prepare anything?</summary>
      <p>No. Come as you are. Bring something real you'd like to talk about if you have it — work, travel, an interview — but I'll always have a plan if you don't.</p></details>
    <details class="faq-item"><summary data-cursor>What level do I need to start?</summary>
      <p>Anywhere from absolute beginner to advanced. If you can read this page, we can work together. Your first lesson maps where you actually are out loud — usually a level higher than people expect.</p></details>
    <details class="faq-item"><summary data-cursor>Is it grammar lessons or conversation?</summary>
