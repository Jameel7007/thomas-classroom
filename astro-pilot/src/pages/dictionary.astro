---
import SiteLayout from "../layouts/SiteLayout.astro";
import DictionaryExplorer from "../components/dictionary/DictionaryExplorer.astro";
import { dictionaryCounts, dictionaryEntries } from "../data/dictionary.mjs";
import "../styles/dictionary.css";

const counts = dictionaryCounts();
const canonical = new URL("/dictionary/", Astro.site);
const dictionaryId = `${canonical.href}#word-clearer`;
const dictionarySchema = {
  "@type": "DefinedTermSet",
  "@id": dictionaryId,
  url: canonical.href,
  name: "Thomas’s Classroom Word Lab",
  description: "A curated English Word Lab with multi-sense definitions, common verbs, phrasal verbs, word families, chunks, and classroom word clearing for adult learners from A0 to C1.",
  inLanguage: "en",
  hasDefinedTerm: dictionaryEntries.map((entry) => ({
    "@type": "DefinedTerm",
    "@id": `${canonical.href}#term-${entry.word}`,
    name: entry.word,
    description: entry.senses[0].definition,
    inDefinedTermSet: { "@id": dictionaryId },
  })),
};
---
<SiteLayout title="English Word Lab · Thomas’s Classroom" description="Explore a curated A0–C1 Word Lab with common verbs, phrasal verbs, word families, clear meanings, natural examples, useful chunks, and in-session word clearing." heading="Word Lab" lede="Understand how useful words behave, build their families and chunks, then clear the exact meaning that is blocking the lesson." current="dictionary" mainEntityId={dictionaryId} additionalStructuredData={[dictionarySchema]}>
  <section class="tab-page">
    <p class="tab-overline">Built-in word clearing</p><h2 class="tab-title">One word. The right meaning.</h2>
    <p class="tab-lede">High-frequency English words often carry several jobs. Build a foundation with {counts.commonVerbs} common verbs, {counts.phrasalVerbs} phrasal verbs, and {counts.wordFamilies} word families, then search {counts.words} carefully chosen headwords and clear the exact sense you need.</p>
    <DictionaryExplorer entries={dictionaryEntries} counts={counts} />
  </section>
</SiteLayout>
