---
import SiteLayout from "../layouts/SiteLayout.astro";
import DictionaryExplorer from "../components/dictionary/DictionaryExplorer.astro";
import { dictionaryCounts, dictionaryEntries } from "../data/dictionary.mjs";
import "../styles/dictionary.css";

const counts = dictionaryCounts();
const canonical = new URL("/dictionary/", Astro.site);
const dictionaryId = `${canonical.href}#word-clearer`;
const dictionarySchema = {
  "@type": "DefinedTermSet",
  "@id": dictionaryId,
  url: canonical.href,
  name: "Thomas’s Classroom learner dictionary",
  description: "A curated multi-sense English word-clearing collection for adult learners from A0 to B2.",
  inLanguage: "en",
  hasDefinedTerm: dictionaryEntries.map((entry) => ({
    "@type": "DefinedTerm",
    "@id": `${canonical.href}#term-${entry.word}`,
    name: entry.word,
    description: entry.senses[0].definition,
    inDefinedTermSet: { "@id": dictionaryId },
  })),
};
---
<SiteLayout title="Learner Dictionary · Thomas’s Classroom" description="Search a curated A0–B2 learner dictionary with clear meanings, natural examples, useful chunks, close words, word origins, and in-session word clearing." heading="Learner Dictionary" lede="Clear the meaning that is blocking the lesson, use it in your own sentence, and return to the conversation." current="dictionary" mainEntityId={dictionaryId} additionalStructuredData={[dictionarySchema]}>
  <section class="tab-page">
    <p class="tab-overline">Built-in word clearing</p><h2 class="tab-title">One word. The right meaning.</h2>
    <p class="tab-lede">High-frequency English words often carry several jobs. Search {counts.words} carefully chosen headwords, compare {counts.senses} learner-friendly meanings, and mark only the sense you can now explain and use.</p>
    <DictionaryExplorer entries={dictionaryEntries} counts={counts} />
  </section>
</SiteLayout>
