---
import { getCollection, render } from "astro:content";
import LegacyDocument from "../../../components/LegacyDocument.astro";
import LessonLayout from "../../../layouts/LessonLayout.astro";
import { legacyLessons } from "../../../lib/legacy-pages";

export async function getStaticPaths() {
  const mdxLessons = (await getCollection("lessons", ({ data }) => data.status === "published"))
    .sort((a, b) => a.data.level.localeCompare(b.data.level) || a.data.order - b.data.order);
  const mdxKeys = new Set(mdxLessons.map((entry) => `${entry.data.level}/${entry.data.slug}`));

  const mdxPaths = mdxLessons.map((entry, index) => {
    const previousEntry = mdxLessons[index - 1]?.data.level === entry.data.level ? mdxLessons[index - 1] : undefined;
    const nextEntry = mdxLessons[index + 1]?.data.level === entry.data.level ? mdxLessons[index + 1] : undefined;
    const link = (candidate: typeof entry | undefined) => candidate && ({
      title: candidate.data.title,
      href: `/lessons/${candidate.data.level.toLowerCase()}/${candidate.data.slug}/`,
    });
    return {
      params: { level: entry.data.level.toLowerCase(), slug: entry.data.slug },
      props: { kind: "mdx" as const, entry, previous: link(previousEntry), next: link(nextEntry) },
    };
  });

  const legacyPaths = legacyLessons
    .filter((page) => page.level && !mdxKeys.has(`${page.level}/${page.slug}`))
    .map((page) => ({
      params: { level: page.level!.toLowerCase(), slug: page.slug },
      props: { kind: "legacy" as const, page },
    }));

  return [...mdxPaths, ...legacyPaths];
}

const props = Astro.props;
const rendered = props.kind === "mdx" ? await render(props.entry) : undefined;
const Content = rendered?.Content;
const legacyPage = props.kind === "legacy" ? props.page : undefined;
---
{props.kind === "mdx" && Content
  ? <LessonLayout lesson={props.entry.data} previous={props.previous} next={props.next}><Content /></LessonLayout>
  : legacyPage && <LegacyDocument source={legacyPage.source} sourcePath={legacyPage.sourcePath} />}
