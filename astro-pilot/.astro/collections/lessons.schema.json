{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 180
    },
    "level": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "grammar",
        "vocabulary",
        "skills"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published"
      ]
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 180
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grammar",
          "vocabulary",
          "listening",
          "reading",
          "speaking",
          "writing",
          "functional-language"
        ]
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audioClips": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "lessonId",
    "title",
    "description",
    "level",
    "kind",
    "slug",
    "order",
    "status",
    "durationMinutes",
    "objectives",
    "skills",
    "updated"
  ]
}